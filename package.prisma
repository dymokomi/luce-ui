        str path = "../luce-window"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-gpu"
    }

    def dependency "luce-fonts" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-fonts"
    }

    def dependency "luce-clipboard" {
        str owner = "dymokomi"
