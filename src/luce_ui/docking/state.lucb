## Shared workspace state. The root retains one stable child per panel; selecting
## a tab changes visibility, and docking changes only value topology. A panel
## may instead float: it leaves the model and sits in its own window over the
## panes, a frame child drawn just beneath it, until it is docked again.
import gpu
import input
import interop
import math
import memory
import ownership
import time
import luce_ui.layout as layout
import luce_ui.result as result
import luce_ui.docking.strip as strip
import luce_ui.docking.drag as drag
from luce_ui.arrangement import Arrangement
from luce_ui.cursor import CursorSource
from luce_ui.layout import Layout, Widget, Size, Point, Event
from luce_ui.font import Font
from luce_ui.theme import Theme
from luce_ui.widgets.panel import Panel
from luce_ui.widgets.action_popup import ActionPopup
from luce_ui.docking.model import Model, Geometry, DockPosition
from luce_ui.painter import Painter

type PanelSlot = interop.Reference[Panel]?
type ConnectionSlot = interop.Reference[interop.Connection]?
type FrameSlot = interop.Reference[Frame]?

## The frame around a floating panel's content, and the band of it that
## resizes the window.
let float_border: f64 = 4.0
## Two presses on a title within this many nanoseconds dock the window.
let double_press: u64 = 400000000

## What a press on a floating window started.
enum Gesture as u8:
    idle = 0
    moving = 1
    closing = 2
    resizing = 3

pub struct DockRequest:
    pub let panel: interop.Reference[Panel]?
    pub let position: DockPosition

    pub func init(panel: interop.Reference[Panel]?, position: DockPosition):
        var retained: interop.Reference[Panel]? = none
        if let value = panel: retained = value.clone()
        self.panel = retained
        self.position = position

    pub mutating func close():
        release_panel(self.panel)

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let panel = self.panel: panel.trace(visit, context)

pub let dock_request_type: interop.Type[DockRequest] = interop.Type[DockRequest]("Dock request", DockRequest.close, DockRequest.trace, closeable = true, main_thread = true)

pub struct State: Arrangement, CursorSource:
    pub let box: interop.WeakReference[Layout]
    pub let font: interop.Reference[Font]
    pub var panels: PanelSlot[]
    pub var model: Model
    var detached: Model?
    pub var popup: interop.Reference[ActionPopup]?
    pub var overlay: interop.Interface[Widget]?
    pub var connections: ConnectionSlot[]
    pub let selected: interop.Signal[interop.Reference[Panel]]
    pub let added: interop.Signal[interop.Reference[DockRequest]]
    pub let closed: interop.Signal[interop.Reference[Panel]]
    var close_handler: interop.Callback[interop.Reference[Panel], bool]?
    var menu_target: usize
    var pressed_tab: usize
    var pressed_close: usize
    var pressed_add: usize
    var resize: usize
    pub var focused_divider: usize
    var grab: f64
    var start: Point
    pub var drag_pointer: Point
    pub var dragging: bool
    var drag_inside: bool
    ## The state itself, for the frames it makes; set by its owner.
    var me: interop.WeakReference[State]?
    ## Floating panel slots, back to front, and each one's window in stack
    ## coordinates.
    var stacking: usize[129]
    var float_count: usize
    var floats: gpu.Rect[129]
    var frames: FrameSlot[]
    var float_pressed: usize
    var gesture: Gesture
    ## Resized edges: 1 left, 2 right, 4 top, 8 bottom.
    var edges: u8
    var float_origin: gpu.Rect
    var float_moved: bool
    var last_press: u64
    var last_pressed: usize

    pub func init(box: interop.Reference[Layout], font: interop.Reference[Font]) -> !:
        let selected = try interop.Signal[interop.Reference[Panel]]()
        errdefer selected.release()
        let added = try interop.Signal[interop.Reference[DockRequest]]()
        errdefer added.release()
        let closed = try interop.Signal[interop.Reference[Panel]]()
        errdefer closed.release()
        let panels = try alloc PanelSlot[129] in memory.heap
        errdefer free(panels) in memory.heap
        let connections = try alloc ConnectionSlot[3] in memory.heap
        errdefer free(connections) in memory.heap
        let frames = try alloc FrameSlot[129] in memory.heap
        for index in 0..<panels.length: panels[index] = none
        for index in 0..<frames.length: frames[index] = none
        for index in 0..<connections.length: connections[index] = none
        self.box = interop.WeakReference[Layout](box)
        self.font = font.clone()
        self.panels = panels
        self.model = Model()
        self.detached = none
        self.popup = none
        self.overlay = none
        self.connections = connections
        self.selected = selected
        self.added = added
        self.closed = closed
        self.close_handler = none
        self.menu_target = 0
        self.pressed_tab = 0
        self.pressed_close = 0
        self.pressed_add = 0
        self.resize = 0
        self.focused_divider = 0
        self.grab = 0.0
        self.start = Point()
        self.drag_pointer = Point()
        self.dragging = false
        self.drag_inside = false
        self.me = none
        var stacking: usize[129]
        var floats: gpu.Rect[129]
        for index in 0..<stacking.length:
            stacking[index] = 0
            floats[index] = gpu.Rect()
        self.stacking = stacking
        self.floats = floats
        self.float_count = 0
        self.frames = frames
        self.float_pressed = 0
        self.gesture = Gesture.idle
        self.edges = 0
        self.float_origin = gpu.Rect()
        self.float_moved = false
        self.last_press = 0
        self.last_pressed = 0

    pub func theme() -> Theme:
        let box = self.box.get() else return Theme()
        defer box.release()
        return box.value().theme()

    pub func height() -> f64:
        return self.theme().row_height(self.font)

    pub func size() -> Size:
        let box = self.box.get() else return Size()
        defer box.release()
        let bounds = box.value().bounds()
        return Size(bounds.width, bounds.height)

    ## The committed topology keeps ownership and cancellation stable. Only the
    ## detached copy participates in placement and hit testing during a drag.
    pub func visible_model() -> Model:
        return self.detached else self.model

    pub func geometry(size: Size) -> Geometry:
        return self.geometry_for(self.visible_model(), size)

    func geometry_for(model: Model, size: Size) -> Geometry:
        var minimums: Size[129]
        for index in 1..<self.panels.length:
            if let panel = self.panels[index]:
                let box = panel.value().layout()
                defer box.release()
                minimums[index] = box.value().minimum_size()
        return model.geometry(size, minimums, self.height(), 5.0)

    pub func place(child: i64, available: Size) -> interop.Outcome[gpu.Rect]:
        for order in 0..<self.float_count:
            let index = self.stacking[order]
            if let frame = self.frames[index]:
                let box = frame.value().layout()
                defer box.release()
                if box.value().id() == child:
                    return result.success[gpu.Rect](self.floats[index])
        for index in 1..<self.panels.length:
            if let panel = self.panels[index]:
                let box = panel.value().layout()
                defer box.release()
                if box.value().id() == child:
                    if self.floating(index):
                        return result.success[gpu.Rect](self.float_content(index))
                    let geometry = self.geometry(available)
                    let visible = self.visible_model()
                    let bounds = geometry.panes[visible.tabs[index].group]
                    return result.success[gpu.Rect](gpu.Rect(bounds.x + 1.0, bounds.y + self.height() + 1.0,
                        math.max(0.0, bounds.width - 2.0), math.max(0.0, bounds.height - self.height() - 2.0)))
        return result.success[gpu.Rect](gpu.Rect(width = available.width, height = available.height))

    pub func index(panel: interop.Reference[Panel]) -> usize!:
        let sought = (try panel.get()).layout()
        defer sought.release()
        for index in 1..<self.panels.length:
            if let current = self.panels[index]:
                let box = current.value().layout()
                defer box.release()
                if box.value().id() == sought.value().id(): return index
        error(result.invalid, "panel does not belong to this dynamic stack")

    pub func panel(index: usize) -> interop.Reference[Panel]!:
        if index == 0 or index >= self.panels.length: error(result.invalid, "panel does not belong to this dynamic stack")
        let panel = self.panels[index] else error(result.invalid, "panel slot is empty")
        return panel.clone()

    pub func active() -> usize:
        # Content receives its own pointer events. Descendant focus identifies
        # the active panel without intercepting editor input or polling events.
        for index in 1..<self.panels.length:
            if let panel = self.panels[index]:
                let box = panel.value().layout()
                defer box.release()
                if box.value().contains_focus(): return index
        return self.model.active

    pub func strip(group: usize, bounds: gpu.Rect) -> strip.Strip:
        let model = self.visible_model()
        let selected = model.nodes[group].selected
        return strip.arrange(gpu.Rect(bounds.x + 1.0, bounds.y + 1.0,
            math.max(0.0, bounds.width - 2.0), self.height()), model.tab_count(group),
            model.tabs[selected].order, self.font.value().advance())

    pub func tab_bounds(index: usize) -> gpu.Rect!:
        discard(try self.model.require(index))
        let model = self.visible_model()
        let group = model.tabs[index].group
        if group == 0: return gpu.Rect()
        let geometry = self.geometry(self.size())
        return self.strip(group, geometry.panes[group]).tab(model.tabs[index].order)

    pub func invalidate():
        if let box = self.box.get():
            defer box.release()
            box.value().invalidate()

    mutating func publish(model: Model):
        self.model = model
        self.show_visible()

    mutating func show_visible():
        let model = self.visible_model()
        for index in 1..<self.panels.length:
            if let panel = self.panels[index]:
                let box = panel.value().layout()
                defer box.release()
                let group = model.tabs[index].group
                box.value().set_visible((group != 0 and model.nodes[group].selected == index) or self.floating(index))
        self.invalidate()

    ## Layout allocates its replacement edges before detaching anything. The
    ## model and retained slots are published only after that operation succeeds.
    func children(add: usize = 0, candidate: interop.Reference[Panel]? = none, remove: usize = 0) -> !:
        let box = self.box.get() else error(result.invalid, "dynamic stack is closed")
        defer box.release()
        let children = try alloc interop.Interface[Widget][260] in memory.heap
        defer free(children) in memory.heap
        var count: usize = 0
        defer release_children(children, count)
        for index in 1..<self.panels.length:
            if index == remove or self.floating(index): continue
            let selected = candidate if index == add else self.panels[index]
            if let panel = selected:
                children[count] = panel.as_interface[Widget](panel.value())
                count += 1
        for order in 0..<self.float_count:
            let index = self.stacking[order]
            if index == remove: continue
            let frame = self.frames[index] else trap("a floating panel without a frame")
            children[count] = frame.as_interface[Widget](frame.value())
            count += 1
            let selected = candidate if index == add else self.panels[index]
            if let panel = selected:
                children[count] = panel.as_interface[Widget](panel.value())
                count += 1
        if let overlay = self.overlay:
            children[count] = overlay.clone()
            count += 1
        if let popup = self.popup:
            children[count] = popup.as_interface[Widget](popup.value())
            count += 1
        try box.value().set_children(children[..<count])

    pub mutating func install(overlay: interop.Interface[Widget], popup: interop.Reference[ActionPopup]) -> !:
        self.overlay = overlay.clone()
        self.popup = popup.clone()
        try self.children()

    pub mutating func add(panel: interop.Reference[Panel], relative: interop.Reference[Panel]?, position: DockPosition) -> !:
        self.cancel()
        var slot: usize = 0
        for index in 1..<self.panels.length:
            if self.panels[index] == none:
                slot = index
                break
        if slot == 0: error(result.limit, "a dynamic stack supports at most 128 panels")
        var target = self.active()
        if self.floating(target): target = self.model.active
        if let other = relative:
            target = try self.index(other)
            if self.floating(target): target = self.model.active
        let caption = (try panel.get()).text()
        defer caption.release()
        discard(try self.font.value().measure(caption.value))
        var next = self.model
        try next.add(slot, target, position)
        try self.children(slot, panel)
        self.panels[slot] = panel.clone()
        self.publish(next)
        try self.select(slot)

    pub mutating func select(index: usize, focus: bool = true) -> !:
        if self.floating(index):
            try self.raise(index)
        else:
            var next = self.model
            try next.select(index)
            self.publish(next)
        if focus:
            let panel = try self.panel(index)
            defer panel.release()
            let box = panel.value().layout()
            defer box.release()
            box.value().request_focus()
            let delivered = self.selected.emit(panel)
            defer delivered.release()
            try delivered.get()

    pub mutating func move(panel: interop.Reference[Panel], relative: interop.Reference[Panel], position: DockPosition) -> !:
        self.cancel()
        let index = try self.index(panel)
        let target = try self.index(relative)
        if self.floating(index):
            var next = self.model
            try next.add(index, 0 if next.root == 0 else (self.model.active if self.floating(target) else target), position)
            try self.dock(index, next)
            return
        var next = self.model
        try next.move(index, target, position)
        self.publish(next)
        try self.select(index)

    pub mutating func remove(panel: interop.Reference[Panel]) -> !:
        self.cancel()
        let index = try self.index(panel)
        let removed = panel.clone()
        defer removed.release()
        var next = self.model
        let floated = self.floating(index)
        if not floated: try next.remove(index)
        try self.children(remove = index)
        if floated:
            self.unstack(index)
            if let frame = self.frames[index]:
                self.frames[index] = none
                frame.release()
        let previous = self.panels[index] else trap("missing retained panel")
        self.panels[index] = none
        previous.release()
        self.publish(next)
        if next.active != 0: try self.select(next.active)
        let delivered = self.closed.emit(removed)
        defer delivered.release()
        try delivered.get()

    pub mutating func set_close_handler(callback: interop.Callback[interop.Reference[Panel], bool]):
        let replacement = callback.clone()
        if let previous = self.close_handler: previous.release()
        self.close_handler = replacement

    mutating func request_close(index: usize) -> !:
        let panel = try self.panel(index)
        defer panel.release()
        if not panel.value().is_closable(): return
        if let callback = self.close_handler:
            let allowed = callback.invoke(panel)
            defer allowed.release()
            if not (try allowed.get()): return
        try self.remove(panel)

    pub mutating func open_menu(group: usize) -> !:
        let popup = self.popup else error(result.invalid, "dynamic stack has no add menu")
        let geometry = self.geometry(self.size())
        let bounds = self.strip(group, geometry.panes[group]).add if group != 0 else gpu.Rect(math.max(0.0, self.size().width - self.height()), 0.0, self.height(), self.height())
        self.menu_target = self.model.nodes[group].selected if group != 0 else 0
        let box = popup.value().layout()
        defer box.release()
        try box.value().set_popup_point(bounds.x, bounds.y + bounds.height)
        try popup.value().open()

    func request(position: DockPosition) -> interop.Outcome[unit]:
        var target: interop.Reference[Panel]? = none
        if self.menu_target != 0:
            let panel = self.panel(self.menu_target) catch failure:
                return result.failure[unit](failure.code, failure.message)
            target = panel
        defer release_panel(target)
        let request = interop.Reference[DockRequest].adopt(new DockRequest(target, position) in memory.heap, dock_request_type, memory.heap) catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer request.release()
        return self.added.emit(request)

    pub mutating func add_tab(argument: unit) -> interop.Outcome[unit]:
        return self.request(DockPosition.tab)

    pub mutating func split_vertical(argument: unit) -> interop.Outcome[unit]:
        return self.request(DockPosition.right)

    pub mutating func split_horizontal(argument: unit) -> interop.Outcome[unit]:
        return self.request(DockPosition.bottom)

    pub func current_drop() -> drag.Drop:
        # A window may resize beneath a stationary pointer. Always resolve the
        # preview from current detached geometry, just like the final release.
        if self.gesture == Gesture.moving and self.float_moved:
            return self.drop_for(self.float_pressed, self.model, self.drag_pointer.x, self.drag_pointer.y, false)
        return self.drop_at(self.drag_pointer.x, self.drag_pointer.y) if self.dragging and self.drag_inside else drag.Drop()

    ## Where a dragged tab would float if let go here, or nothing while it
    ## would dock.
    pub func float_preview() -> gpu.Rect:
        if not self.dragging or self.current_drop().accepted: return gpu.Rect()
        return self.float_window(self.pressed_tab, self.drag_pointer)

    pub func dragged_tab() -> usize:
        return self.pressed_tab if self.dragging else 0

    pub func drag_bounds() -> gpu.Rect:
        if not self.dragging: return gpu.Rect()
        let size = self.size()
        let width = math.min(size.width, self.font.value().advance() * 28.0)
        let height = self.height() + 2.0
        return gpu.Rect(math.clamp(self.drag_pointer.x + 14.0, 0.0, math.max(0.0, size.width - width)),
            math.clamp(self.drag_pointer.y + 18.0, 0.0, math.max(0.0, size.height - height)), width, height)

    func insertion(drop: drag.Drop, x: f64, y: f64) -> Model!:
        return try self.inserted(self.pressed_tab, self.visible_model(), drop, x, y)

    ## `base` with `tab` added where `drop` says; within a header, at the tab
    ## under the pointer.
    func inserted(tab: usize, base: Model, drop: drag.Drop, x: f64, y: f64) -> Model!:
        var next = base
        let relative = next.nodes[drop.group].selected if drop.group != 0 else 0
        var order = next.tab_count(drop.group)
        if drop.group != 0 and drop.position == DockPosition.tab:
            let geometry = self.geometry(self.size())
            let header = self.strip(drop.group, geometry.panes[drop.group])
            for index in header.first..<header.first + header.count:
                let bounds = header.tab(index)
                if strip.contains(bounds, x, y):
                    order = index + (1 if x >= bounds.x + bounds.width * 0.5 else 0)
                    break
        try next.add(tab, relative, drop.position)
        if drop.position == DockPosition.tab:
            try next.reorder(tab, order)
        return next

    func drop_at(x: f64, y: f64) -> drag.Drop:
        return self.drop_for(self.pressed_tab, self.visible_model(), x, y, true)

    ## The dock target for `tab` over `base` at a point: a header joins its
    ## group, an edge splits beside it, and a pane's middle is no target, so
    ## the panel floats there. An empty stack takes a dragged tab anywhere, a
    ## floating window only by a double press on its title.
    func drop_for(tab: usize, base: Model, x: f64, y: f64, empty: bool) -> drag.Drop:
        let size = self.size()
        let area = gpu.Rect(width = size.width, height = size.height)
        if not strip.contains(area, x, y): return drag.Drop()
        if base.root == 0 and not empty: return drag.Drop()
        var model = base
        var geometry = self.geometry_for(base, size)
        var drop = drag.Drop(accepted = true, preview = area) if model.root == 0 else drag.target(&model, &geometry, x, y, self.height())
        if not drop.accepted: return drop
        let inserted = self.inserted(tab, base, drop, x, y) catch failure: return drag.Drop()
        let placed = self.geometry_for(inserted, size)
        drop.preview = placed.panes[inserted.tabs[tab].group]
        return drop

    pub func cursor(position: Point, captured: bool) -> input.Cursor:
        if self.dragging: return input.Cursor.grabbing
        let model = self.visible_model()
        if captured and self.resize != 0:
            return input.Cursor.resize_horizontal if model.nodes[self.resize].horizontal else input.Cursor.resize_vertical
        let geometry = self.geometry(self.size())
        for node in 1..<model.nodes.length:
            if not model.nodes[node].used: continue
            if model.nodes[node].first != 0:
                if strip.contains(geometry.dividers[node], position.x, position.y):
                    return input.Cursor.resize_horizontal if model.nodes[node].horizontal else input.Cursor.resize_vertical
                continue
            let bounds = geometry.panes[node]
            let header = self.strip(node, bounds)
            if strip.contains(header.add, position.x, position.y) or strip.contains(header.previous, position.x, position.y) or strip.contains(header.next, position.x, position.y):
                return input.Cursor.pointer
            if strip.contains(gpu.Rect(bounds.x, bounds.y, bounds.width, self.height() + 1.0), position.x, position.y):
                for order in header.first..<header.first + header.count:
                    let tab = header.tab(order)
                    if strip.contains(tab, position.x, position.y) and position.x >= tab.x + tab.width - self.height():
                        if let panel = self.panels[model.at(node, order)]:
                            if panel.value().is_closable(): return input.Cursor.pointer
                return input.Cursor.grab
        if model.root == 0 and strip.contains(gpu.Rect(math.max(0.0, self.size().width - self.height()), 0.0, self.height(), self.height()), position.x, position.y):
            return input.Cursor.pointer
        return input.Cursor.arrow

    pub mutating func cancel():
        self.gesture = Gesture.idle
        self.float_pressed = 0
        self.detached = none
        self.pressed_tab = 0
        self.pressed_close = 0
        self.pressed_add = 0
        self.resize = 0
        self.dragging = false
        self.drag_inside = false
        self.show_visible()

    pub mutating func handle(event: Event) -> !:
        if event.cancelled or (event.kind == input.EventKind.key_down and event.key == input.Key.escape):
            self.cancel()
            return
        let geometry = self.geometry(self.size())
        if event.kind == input.EventKind.pointer_down and event.button == 0 and event.inside:
            self.cancel()
            self.focused_divider = 0
            self.start = Point(event.x, event.y)
            for node in 1..<self.model.nodes.length:
                if self.model.nodes[node].used and self.model.nodes[node].first != 0 and strip.contains(geometry.dividers[node], event.x, event.y):
                    self.resize = node
                    self.focused_divider = node
                    self.grab = event.x - geometry.dividers[node].x if self.model.nodes[node].horizontal else event.y - geometry.dividers[node].y
                    return
            if self.model.root == 0:
                let add = gpu.Rect(math.max(0.0, self.size().width - self.height()), 0.0, self.height(), self.height())
                if strip.contains(add, event.x, event.y): self.pressed_add = 65
                return
            for group in 1..<self.model.nodes.length:
                if not self.model.nodes[group].used or self.model.nodes[group].first != 0: continue
                let header = self.strip(group, geometry.panes[group])
                if strip.contains(header.add, event.x, event.y):
                    self.pressed_add = group
                    return
                if strip.contains(header.previous, event.x, event.y) or strip.contains(header.next, event.x, event.y):
                    try self.step(group, strip.contains(header.previous, event.x, event.y))
                    return
                if event.y < geometry.panes[group].y + 1.0 or event.y >= geometry.panes[group].y + 1.0 + self.height() or not strip.contains(geometry.panes[group], event.x, event.y): continue
                var selected = self.model.nodes[group].selected
                for order in header.first..<header.first + header.count:
                    let bounds = header.tab(order)
                    if strip.contains(bounds, event.x, event.y):
                        selected = self.model.at(group, order)
                        let panel = try self.panel(selected)
                        defer panel.release()
                        if panel.value().is_closable() and event.x >= bounds.x + bounds.width - self.height():
                            self.pressed_close = selected
                            return
                        break
                self.pressed_tab = selected
                try self.select(selected, focus = false)
                return
        elif event.kind == input.EventKind.pointer_moved:
            if self.resize != 0:
                try self.resize_to(geometry, event.x, event.y)
            elif self.pressed_tab != 0:
                let dx = event.x - self.start.x
                let dy = event.y - self.start.y
                if not self.dragging and dx * dx + dy * dy >= 16.0:
                    var detached = self.model
                    try detached.remove(self.pressed_tab)
                    self.detached = detached
                    self.dragging = true
                    self.show_visible()
                if self.dragging:
                    self.drag_pointer = Point(event.x, event.y)
                    self.drag_inside = event.inside
                    self.invalidate()
        elif event.kind == input.EventKind.pointer_up and event.button == 0:
            let tab = self.pressed_tab
            let closing = self.pressed_close
            let adding = self.pressed_add
            let dragged = self.dragging
            let drop = self.drop_at(event.x, event.y) if dragged and event.inside else drag.Drop()
            # Prepare the final topology while the detached geometry is still
            # available, then restore/cancel the gesture before publishing it.
            var committed: Model? = none
            if dragged and drop.accepted:
                committed = try self.insertion(drop, event.x, event.y)
            let window = self.float_window(tab, Point(event.x, event.y)) if dragged and not drop.accepted else gpu.Rect()
            self.cancel()
            if adding != 0 and event.inside:
                let group = 0 if adding == 65 else adding
                if group == 0 or strip.contains(self.strip(group, geometry.panes[group]).add, event.x, event.y):
                    try self.open_menu(group)
            elif closing != 0 and event.inside:
                let bounds = try self.tab_bounds(closing)
                if strip.contains(bounds, event.x, event.y) and event.x >= bounds.x + bounds.width - self.height():
                    try self.request_close(closing)
            elif tab != 0:
                if window.width > 0.0:
                    try self.float(tab, window)
                    return
                if let next = committed: self.publish(next)
                try self.select(tab)
        elif event.kind == input.EventKind.scroll:
            for group in 1..<self.model.nodes.length:
                if self.model.nodes[group].used and self.model.nodes[group].first == 0:
                    let bounds = geometry.panes[group]
                    if strip.contains(gpu.Rect(bounds.x, bounds.y, bounds.width, self.height() + 1.0), event.x, event.y):
                        try self.step(group, event.scroll_y > 0.0 or event.scroll_x > 0.0)
                        return
        elif event.kind == input.EventKind.key_down and not event.repeated:
            if self.focused_divider != 0 and self.model.nodes[self.focused_divider].used and self.model.nodes[self.focused_divider].first != 0:
                let node = self.focused_divider
                let horizontal = self.model.nodes[node].horizontal
                let backward = event.key == input.Key.left if horizontal else event.key == input.Key.up
                let forward = event.key == input.Key.right if horizontal else event.key == input.Key.down
                if event.key == input.Key.home or event.key == input.Key.end:
                    self.model.nodes[node].fraction = 0.0 if event.key == input.Key.home else 1.0
                    self.invalidate()
                elif backward or forward:
                    let bounds = geometry.dividers[node]
                    let delta = (32.0 if event.shift else 8.0) * (-1.0 if backward else 1.0)
                    self.resize = node
                    self.grab = 0.0
                    try self.resize_to(geometry, bounds.x + (delta if horizontal else 0.0), bounds.y + (0.0 if horizontal else delta))
                    self.resize = 0
            elif self.active() != 0:
                let group = self.model.tabs[self.active()].group
                if event.key == input.Key.left or event.key == input.Key.right:
                    try self.step(group, event.key == input.Key.left)
                elif event.key == input.Key.enter or event.key == input.Key.down:
                    try self.select(self.model.nodes[group].selected)
                elif event.key == input.Key.n and event.control:
                    try self.open_menu(group)

    # mark: Floating windows ================================================================

    ## Give the state its own reference, for the frames it makes.
    pub mutating func set_owner(state: interop.Reference[State]):
        if let previous = self.me: previous.release()
        self.me = interop.WeakReference[State](state)

    ## A floating panel's window, title bar included.
    pub func float_bounds(index: usize) -> gpu.Rect:
        return self.floats[index]

    pub func floating_count() -> usize:
        return self.float_count

    pub func floating(index: usize) -> bool:
        if index == 0: return false
        for order in 0..<self.float_count:
            if self.stacking[order] == index: return true
        return false

    ## A floating window's title bar, close button and content, in stack coordinates.
    pub func float_title(index: usize) -> gpu.Rect:
        let window = self.floats[index]
        return gpu.Rect(window.x, window.y, window.width, self.height() + 1.0)

    pub func float_close(index: usize) -> gpu.Rect:
        let title = self.float_title(index)
        let extent = math.min(title.width, title.height)
        return gpu.Rect(title.x + title.width - extent, title.y, extent, extent)

    pub func float_content(index: usize) -> gpu.Rect:
        let window = self.floats[index]
        let top = self.height() + 1.0
        return gpu.Rect(window.x + float_border, window.y + top, math.max(0.0, window.width - float_border * 2.0),
            math.max(0.0, window.height - top - float_border))

    ## The smallest window that holds the panel's content.
    func float_minimum(index: usize) -> Size:
        var minimum = Size(120.0, 60.0)
        if let panel = self.panels[index]:
            let box = panel.value().layout()
            defer box.release()
            let content = box.value().minimum_size()
            minimum = Size(math.max(minimum.width, content.width), math.max(minimum.height, content.height))
        return Size(minimum.width + float_border * 2.0, minimum.height + self.height() + 1.0 + float_border)

    ## `window` no smaller than its panel needs, no larger than the stack, and inside it.
    func fitted(index: usize, window: gpu.Rect) -> gpu.Rect:
        let size = self.size()
        let minimum = self.float_minimum(index)
        let width = math.min(math.max(window.width, minimum.width), math.max(minimum.width, size.width))
        let height = math.min(math.max(window.height, minimum.height), math.max(minimum.height, size.height))
        return gpu.Rect(math.clamp(window.x, 0.0, math.max(0.0, size.width - width)),
            math.clamp(window.y, 0.0, math.max(0.0, size.height - height)), width, height)

    ## The window a tab floats into when let go at `pointer`: about its pane's
    ## size, with the title under the pointer.
    func float_window(index: usize, pointer: Point) -> gpu.Rect:
        let size = self.size()
        var width = size.width * 0.35
        var height = size.height * 0.5
        let group = self.model.tabs[index].group
        if group != 0:
            let pane = self.geometry_for(self.model, size).panes[group]
            width = math.min(pane.width, size.width * 0.5)
            height = math.min(pane.height, size.height * 0.6)
        return self.fitted(index, gpu.Rect(pointer.x - math.min(60.0, width * 0.5), pointer.y - self.height() * 0.5, width, height))

    ## A window for a panel that has none yet: centred, tall, as wide as it asks.
    pub func default_window(index: usize) -> gpu.Rect:
        let size = self.size()
        let width = math.max(self.float_minimum(index).width, 360.0)
        let height = size.height * 0.7
        return self.fitted(index, gpu.Rect((size.width - width) * 0.5, (size.height - height) * 0.5, width, height))

    mutating func unstack(index: usize):
        var kept: usize = 0
        for order in 0..<self.float_count:
            if self.stacking[order] != index:
                self.stacking[kept] = self.stacking[order]
                kept += 1
        self.float_count = kept

    mutating func stack_on_top(index: usize):
        self.unstack(index)
        self.stacking[self.float_count] = index
        self.float_count += 1

    ## Bring a floating window to the front.
    mutating func raise(index: usize) -> !:
        if self.float_count > 0 and self.stacking[self.float_count - 1] == index: return
        self.stack_on_top(index)
        try self.children()
        self.invalidate()

    mutating func ensure_frame(index: usize) -> !:
        if self.frames[index] != none: return
        let me = self.me else error(result.invalid, "dynamic stack state has no owner")
        let state = me.get() else error(result.invalid, "dynamic stack is closed")
        defer state.release()
        self.frames[index] = try make_frame(state, index)

    ## Float a docked panel in `window`, or move a floating one there.
    pub mutating func float(index: usize, window: gpu.Rect) -> !:
        self.cancel()
        if self.floating(index):
            self.floats[index] = self.fitted(index, window)
            try self.select(index)
            return
        var next = self.model
        try next.remove(index)
        try self.ensure_frame(index)
        self.floats[index] = self.fitted(index, window)
        self.stack_on_top(index)
        errdefer self.unstack(index)
        try self.children()
        self.publish(next)
        try self.select(index)

    ## Add a panel that is not in the stack yet as a floating window: in
    ## `window`, or centred when none.
    pub mutating func add_floating(panel: interop.Reference[Panel], window: gpu.Rect?) -> !:
        self.cancel()
        var slot: usize = 0
        for index in 1..<self.panels.length:
            if self.panels[index] == none:
                slot = index
                break
        if slot == 0: error(result.limit, "a dynamic stack supports at most 128 panels")
        try self.ensure_frame(slot)
        self.stack_on_top(slot)
        errdefer self.unstack(slot)
        try self.children(slot, panel)
        self.panels[slot] = panel.clone()
        self.floats[slot] = self.default_window(slot)
        if let chosen = window: self.floats[slot] = self.fitted(slot, chosen)
        self.show_visible()
        try self.select(slot)

    ## Dock a floating panel: `next` is the model with it already added.
    mutating func dock(index: usize, next: Model) -> !:
        self.unstack(index)
        errdefer self.stack_on_top(index)
        try self.children()
        self.publish(next)
        try self.select(index)

    ## The window edges at a point: 1 left, 2 right, 4 top, 8 bottom. A corner
    ## grip at the bottom right is wider than the border.
    func edges_at(index: usize, x: f64, y: f64) -> u8:
        let window = self.floats[index]
        let right = window.x + window.width
        let bottom = window.y + window.height
        if x >= right - 12.0 and y >= bottom - 12.0: return 10
        var edges: u8 = 0
        if x < window.x + float_border: edges |= 1
        elif x >= right - float_border: edges |= 2
        if y < window.y + 3.0: edges |= 4
        elif y >= bottom - float_border: edges |= 8
        return edges

    ## A pointer event on floating window `index`'s frame, at stack coordinates:
    ## the title moves the window and, let go over a header or a pane's edge,
    ## docks it there; a double press on the title docks it with the active
    ## group; the border resizes it.
    pub mutating func float_event(index: usize, event: Event, x: f64, y: f64) -> !:
        if event.cancelled:
            if self.gesture == Gesture.moving and self.float_pressed == index: self.floats[index] = self.float_origin
            self.gesture = Gesture.idle
            self.float_pressed = 0
            self.invalidate()
            return
        if not self.floating(index): return
        if event.kind == input.EventKind.pointer_down and event.button == 0:
            self.cancel()
            try self.select(index)
            self.float_pressed = index
            self.start = Point(x, y)
            self.float_origin = self.floats[index]
            self.float_moved = false
            self.edges = self.edges_at(index, x, y)
            if self.edges != 0:
                self.gesture = Gesture.resizing
                return
            let panel = try self.panel(index)
            defer panel.release()
            if panel.value().is_closable() and strip.contains(self.float_close(index), x, y):
                self.gesture = Gesture.closing
                return
            if strip.contains(self.float_title(index), x, y):
                # A second click on the title soon after a first, neither of them a drag.
                if self.last_pressed == index and time.now() - self.last_press < double_press:
                    self.last_press = 0
                    self.cancel()
                    var next = self.model
                    try next.add(index, 0 if next.root == 0 else next.active, DockPosition.tab)
                    try self.dock(index, next)
                    return
                self.gesture = Gesture.moving
            self.last_press = 0
            return
        if self.float_pressed != index: return
        let dx = x - self.start.x
        let dy = y - self.start.y
        let origin = self.float_origin
        if event.kind == input.EventKind.pointer_moved:
            if self.gesture == Gesture.moving:
                self.floats[index] = self.fitted(index, gpu.Rect(origin.x + dx, origin.y + dy, origin.width, origin.height))
                self.float_moved = self.float_moved or dx * dx + dy * dy >= 16.0
                self.drag_pointer = Point(x, y)
                self.invalidate()
            elif self.gesture == Gesture.resizing:
                let minimum = self.float_minimum(index)
                var window = origin
                if (self.edges & 1) != 0:
                    let shift = math.min(dx, origin.width - minimum.width)
                    window.x = origin.x + shift
                    window.width = origin.width - shift
                if (self.edges & 2) != 0: window.width = origin.width + dx
                if (self.edges & 4) != 0:
                    let shift = math.min(dy, origin.height - minimum.height)
                    window.y = origin.y + shift
                    window.height = origin.height - shift
                if (self.edges & 8) != 0: window.height = origin.height + dy
                self.floats[index] = self.fitted(index, window)
                self.invalidate()
        elif event.kind == input.EventKind.pointer_up and event.button == 0:
            let gesture = self.gesture
            let moved = self.float_moved
            self.last_press = time.now() if gesture == Gesture.moving and not moved else 0
            self.last_pressed = index
            self.gesture = Gesture.idle
            self.float_pressed = 0
            self.float_moved = false
            if gesture == Gesture.closing and strip.contains(self.float_close(index), x, y):
                try self.request_close(index)
            elif gesture == Gesture.moving and moved:
                let drop = self.drop_for(index, self.model, x, y, false)
                if drop.accepted:
                    try self.dock(index, try self.inserted(index, self.model, drop, x, y))
            self.invalidate()

    ## The pointer over floating window `index` at stack coordinates.
    pub func float_cursor(index: usize, x: f64, y: f64) -> input.Cursor:
        if self.gesture == Gesture.moving and self.float_pressed == index: return input.Cursor.grabbing
        let edges = self.edges if self.gesture == Gesture.resizing and self.float_pressed == index else self.edges_at(index, x, y)
        if (edges & 12) != 0 and (edges & 3) == 0: return input.Cursor.resize_vertical
        if edges != 0: return input.Cursor.resize_horizontal
        if let panel = self.panels[index]:
            if panel.value().is_closable() and strip.contains(self.float_close(index), x, y): return input.Cursor.pointer
        if strip.contains(self.float_title(index), x, y): return input.Cursor.grab
        return input.Cursor.arrow

    ## A floating window's chrome, in its own coordinates: border, title bar
    ## with the panel's name and close button, and the surface under the content.
    pub func draw_float(index: usize, target: interop.View[gpu.RenderTarget], pointer: Point, hovered: bool) -> !:
        let panel = try self.panel(index)
        defer panel.release()
        let content = panel.value().layout()
        defer content.release()
        var painter = try Painter(target)
        defer painter.close()
        let theme = self.theme()
        let window = self.floats[index]
        let title = self.height()
        try painter.rectangle(gpu.Rect(width = window.width, height = window.height), theme.active_border if content.value().contains_focus() else theme.strip)
        try painter.rectangle(gpu.Rect(1.0, 1.0, math.max(0.0, window.width - 2.0), math.max(0.0, window.height - 2.0)), theme.panel)
        try painter.rectangle(gpu.Rect(1.0, 1.0, math.max(0.0, window.width - 2.0), title - 1.0), theme.strip)
        try painter.rectangle(gpu.Rect(1.0, title, math.max(0.0, window.width - 2.0), 1.0), theme.background)
        let close = self.float_close(index)
        let closing = panel.value().is_closable()
        let label_end = close.x - window.x if closing else window.width
        let inset = theme.inset(self.font)
        let label = panel.value().text()
        defer label.release()
        let clipped = try target.get().clipped(gpu.Rect(inset, 0.0, math.max(0.0, label_end - inset * 2.0), title))
        defer clipped.release()
        var labels = try Painter(clipped)
        defer labels.close()
        try labels.text(label.value, inset, (title - self.font.value().height()) * 0.5, theme.foreground, self.font)
        if closing:
            let button = gpu.Rect(close.x - window.x, close.y - window.y, close.width, close.height)
            if hovered and strip.contains(button, pointer.x, pointer.y):
                try painter.rectangle(button, theme.hover())
            let middle = Point(button.x + button.width * 0.5, button.y + button.height * 0.5)
            let extent = self.font.value().advance() * 0.3
            try painter.line(Point(middle.x - extent, middle.y - extent), Point(middle.x + extent, middle.y + extent), 1.0, theme.muted)
            try painter.line(Point(middle.x - extent, middle.y + extent), Point(middle.x + extent, middle.y - extent), 1.0, theme.muted)

    mutating func step(group: usize, backwards: bool) -> !:
        let current = self.model.tabs[self.model.nodes[group].selected].order
        let count = self.model.tab_count(group)
        let next = (current + count - 1) % count if backwards else (current + 1) % count
        let index = self.model.at(group, next)
        try self.select(index, focus = false)
        let panel = try self.panel(index)
        defer panel.release()
        let delivered = self.selected.emit(panel)
        defer delivered.release()
        try delivered.get()

    mutating func resize_to(geometry: Geometry, x: f64, y: f64) -> !:
        if not math.is_finite(x) or not math.is_finite(y):
            error(result.invalid, "divider position must be finite")
        let bounds = geometry.panes[self.resize]
        let horizontal = self.model.nodes[self.resize].horizontal
        let available = math.max(0.0, (bounds.width if horizontal else bounds.height) - 5.0)
        if available == 0.0: return
        self.model.nodes[self.resize].fraction = math.clamp(((x - bounds.x if horizontal else y - bounds.y) - self.grab) / available, 0.0, 1.0)
        self.invalidate()

    pub mutating func close():
        for retained in self.connections:
            if let connection = retained:
                # Connection disposal disconnects. Collector finalizers may
                # already have closed an alias, so cleanup only releases it.
                connection.release()
        if let callback = self.close_handler: callback.release()
        self.selected.close()
        self.selected.release()
        self.added.close()
        self.added.release()
        self.closed.close()
        self.closed.release()
        if let popup = self.popup: popup.release()
        if let overlay = self.overlay: overlay.release()
        for panel in self.panels: release_panel(panel)
        for retained in self.frames:
            if let frame = retained: frame.release()
        free(self.frames) in memory.heap
        if let me = self.me: me.release()
        free(self.panels) in memory.heap
        free(self.connections) in memory.heap
        self.font.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        for retained in self.connections:
            if let connection = retained: connection.trace(visit, context)
        if let callback = self.close_handler: callback.trace(visit, context)
        self.selected.trace(visit, context)
        self.added.trace(visit, context)
        self.closed.trace(visit, context)
        if let popup = self.popup: popup.trace(visit, context)
        if let overlay = self.overlay: overlay.trace(visit, context)
        for retained in self.panels:
            if let panel = retained: panel.trace(visit, context)
        for retained in self.frames:
            if let frame = retained: frame.trace(visit, context)
        self.font.trace(visit, context)

func release_panel(retained: interop.Reference[Panel]?):
    if let panel = retained: panel.release()

func release_children(children: interop.Interface[Widget][], count: usize):
    for child in children[..<count]: child.release()

pub let state_type: interop.Type[State] = interop.Type[State]("Dynamic stack state", State.close, State.trace, closeable = true, main_thread = true)

# mark: Floating window frames ================================================================

## The chrome behind one floating panel: it takes the presses on the title and
## border that the panel's content does not cover, and hands them to the state.
pub struct Frame: Widget:
    let box: interop.Reference[Layout]
    let state: interop.WeakReference[State]
    let slot: usize

    pub func init(state: interop.Reference[State], slot: usize) -> !:
        let box = try layout.make_layout()
        errdefer box.release()
        box.value().set_interactive(true)
        let cursor = try interop.Reference[FrameCursor].adopt(new FrameCursor(state, slot) in memory.heap, frame_cursor_type, memory.heap)
        defer cursor.release()
        let source = cursor.as_interface[CursorSource](cursor.value())
        defer source.release()
        try box.value().set_cursor_source(source)
        self.box = box
        self.state = interop.WeakReference[State](state)
        self.slot = slot

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub func measure(available: layout.Constraints) -> interop.Outcome[Size]:
        return result.success[Size](Size())

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        let state = self.state.get() else return result.success[unit](())
        defer state.release()
        state.value().draw_float(self.slot, target, self.box.value().pointer_position(), self.box.value().contains_pointer()) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        let state = self.state.get() else return result.success[unit](())
        defer state.release()
        let stack = state.value().box.get() else return result.success[unit](())
        defer stack.release()
        let mine = self.box.value().bounds()
        let base = stack.value().bounds()
        state.value().float_event(self.slot, event, event.x + mine.x - base.x, event.y + mine.y - base.y) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    pub mutating func close():
        self.state.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.box.trace(visit, context)

pub let frame_type: interop.Type[Frame] = interop.Type[Frame]("Floating panel frame", Frame.close, Frame.trace, closeable = true, main_thread = true)

func make_frame(state: interop.Reference[State], slot: usize) -> interop.Reference[Frame]!:
    return try interop.Reference[Frame].adopt(new Frame(state, slot) in memory.heap, frame_type, memory.heap)

## A frame's cursors; it holds the state weakly, so the frame's box can keep it.
struct FrameCursor: CursorSource:
    let state: interop.WeakReference[State]
    let slot: usize

    pub func init(state: interop.Reference[State], slot: usize):
        self.state = interop.WeakReference[State](state)
        self.slot = slot

    pub func cursor(position: Point, captured: bool) -> input.Cursor:
        let state = self.state.get() else return input.Cursor.arrow
        defer state.release()
        let window = state.value().floats[self.slot]
        return state.value().float_cursor(self.slot, position.x + window.x, position.y + window.y)

    pub mutating func close():
        self.state.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        discard(context)

let frame_cursor_type: interop.Type[FrameCursor] = interop.Type[FrameCursor]("Floating frame cursor", FrameCursor.close, FrameCursor.trace, closeable = true, main_thread = true)
