## Semantic colors and font-relative metrics. Themes are values, inherited by
## layouts; a subtree may override one without mutating another application.
import gpu
import interop
import math
import color
from luce_ui.font import Font
from luce_ui.text.style import EditorTheme
import luce_ui.result as result

pub struct Theme:
    pub var background: gpu.Color = gpu.Color(0.012, 0.017, 0.027)
    pub var panel: gpu.Color = gpu.Color(0.021, 0.028, 0.041)
    pub var foreground: gpu.Color = gpu.Color(0.68, 0.73, 0.82)
    pub var muted: gpu.Color = gpu.Color(0.26, 0.34, 0.45)
    pub var selection: gpu.Color = gpu.Color(0.035, 0.11, 0.22)
    pub var accent: gpu.Color = gpu.Color(0.2, 0.66, 0.92)
    pub var button: gpu.Color = gpu.Color(0.032, 0.044, 0.064)
    pub var pressed: gpu.Color = gpu.Color(0.055, 0.1, 0.16)
    pub var border: gpu.Color = gpu.Color(0.06, 0.085, 0.12)
    pub var active_border: gpu.Color = gpu.Color(0.10, 0.22, 0.32)
    pub var gutter: gpu.Color = gpu.Color(0.021, 0.028, 0.041)
    pub var shadow: gpu.Color = gpu.Color()
    pub var shadow_offset: f64 = 4.0
    pub var shadow_opacity: f64 = 0.35
    pub var control_lines: f64 = 1.0
    pub var inset_cells: f64 = 1.0
    pub var header_inset_cells: f64 = 1.5
    pub var caret_width: f64 = 2.0

    pub func validate() -> !:
        if not math.is_finite(self.header_inset_cells) or self.header_inset_cells < 0.0 or self.header_inset_cells > 4.0:
            error(result.invalid, "header inset must be in 0..4 character cells")
        if not math.is_finite(self.shadow_offset) or self.shadow_offset < 0.0 or self.shadow_offset > 32.0:
            error(result.invalid, "popup shadow offset must be in 0..32 points")
        if not math.is_finite(self.shadow_opacity) or self.shadow_opacity < 0.0 or self.shadow_opacity > 1.0:
            error(result.invalid, "popup shadow opacity must be in 0..1")
        if not math.is_finite(self.control_lines) or self.control_lines < 1.0 or self.control_lines > 4.0:
            error(result.invalid, "control height must be in 1..4 text lines")
        if not math.is_finite(self.inset_cells) or self.inset_cells < 0.0 or self.inset_cells > 4.0:
            error(result.invalid, "control inset must be in 0..4 character cells")
        if not math.is_finite(self.caret_width) or self.caret_width < 1.0 or self.caret_width > 8.0:
            error(result.invalid, "caret width must be in 1..8 points")

    pub func row_height(font: interop.Reference[Font]) -> f64:
        return math.ceil(font.value().line_height() * self.control_lines)

    pub func inset(font: interop.Reference[Font]) -> f64:
        return math.ceil(font.value().advance() * self.inset_cells)

    ## Interaction states are derived, not stored, so a palette cannot fall out of
    ## step with itself. Each lifts a surface toward the foreground in perceptual
    ## lightness, keeping its hue: a grayscale theme stays gray, a tinted one tints.
    pub func hover() -> gpu.Color:
        return lift(self.panel, self.foreground, 0.1)

    ## A hovered frame border sits partway from its resting to its focused color.
    pub func hover_border() -> gpu.Color:
        return between(self.border, self.active_border, 0.5)

    pub func gutter_active() -> gpu.Color:
        return lift(self.gutter, self.foreground, 0.12)

    pub func gutter_hover() -> gpu.Color:
        return lift(self.gutter, self.foreground, 0.06)

    pub func editor() -> EditorTheme:
        return EditorTheme(background = self.background, foreground = self.foreground,
            gutter = self.gutter, line_number = self.muted, current_line = self.panel,
            gutter_active = self.gutter_active(), gutter_hover = self.gutter_hover(), active_line_number = self.foreground,
            selection = lift(self.selection, self.foreground, 0.28), caret = lift(self.accent, self.foreground, 0.6), caret_width = self.caret_width, scrollbar = self.border)

## Perceptual lift of a surface toward a reference lightness, keeping its hue.
func lift(base: gpu.Color, reference: gpu.Color, amount: f64) -> gpu.Color:
    let shade = color.elevate(carry(base), carry(reference), amount)
    return gpu.Color(shade.red, shade.green, shade.blue)

## A perceptual blend between two colors, for a midpoint state like a hovered border.
func between(first: gpu.Color, second: gpu.Color, amount: f64) -> gpu.Color:
    let shade = color.blend(carry(first), carry(second), amount)
    return gpu.Color(shade.red, shade.green, shade.blue)

## Both models are linear-light sRGB triples, so bridging is a field-wise copy.
func carry(value: gpu.Color) -> color.Color:
    return color.Color(value.red, value.green, value.blue)
