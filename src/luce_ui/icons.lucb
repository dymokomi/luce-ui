## Editor icons are the shared luciaos rounded SVGs (24×24, currentColor), rasterised by
## luce-svg to an anti-aliased coverage bitmap and drawn as a tinted mask, like glyphs. IconKind names the icon; the artwork lives in the embedded
## icon_assets table. A blank kind draws nothing.
import gpu
import interop
import math
import memory
from luce_ui.painter import Painter
import svg
import luce_ui.icon_assets as icon_assets

pub enum IconKind as u8:
    blank = 0
    folder = 1
    folder_open = 2
    file = 3
    code = 4
    terminal = 5
    settings = 6

func name_of(kind: IconKind) -> str:
    if kind == IconKind.folder:
        return "folder"
    if kind == IconKind.folder_open:
        return "folder_open"
    if kind == IconKind.file:
        return "file"
    if kind == IconKind.code:
        return "code"
    if kind == IconKind.terminal:
        return "terminal"
    if kind == IconKind.settings:
        return "settings"
    return ""

pub func draw(painter: Painter*, kind: IconKind, bounds: gpu.Rect, color: gpu.Color) -> !:
    if kind == IconKind.blank:
        return
    try draw_named(painter, name_of(kind), bounds, color)

## Draw the luciaos-assets icon called `name` ("brush-tool", "layer-mask", ...)
## fitted into `bounds`, stroked in `color`. Unknown names draw nothing.
pub func draw_named(painter: Painter*, name: str, bounds: gpu.Rect, color: gpu.Color) -> !:
    if bounds.width <= 0.0 or bounds.height <= 0.0:
        return
    let source = icon_assets.source(name)
    if source == "":
        return
    let drawing = try svg.parse(source)
    defer drawing.release()
    try render(painter, try drawing.get(), bounds, color)

## Whether `name` is an icon in the set.
pub func known(name: str) -> bool:
    return icon_assets.source(name) != ""

## Draw a named icon onto a render target: the entry Luce widgets use.
pub func draw_icon(target: interop.View[gpu.RenderTarget], name: str, bounds: gpu.Rect, color: gpu.Color) -> !:
    var painter = try Painter(target)
    defer painter.close()
    try draw_named(&painter, name, bounds, color)

## Rasterise the drawing to an 8-bit coverage bitmap at the target's pixel scale
## (round caps and joins, exact-area anti-aliasing, fill opacity — luce-svg's work)
## and draw it the way glyphs are drawn: one coverage mask, tinted with `color`,
## snapped so each texel lands on one physical pixel.
func render(painter: Painter*, drawing: svg.Drawing*, bounds: gpu.Rect, color: gpu.Color) -> !:
    let view = painter.target()
    defer view.release()
    let destination = try view.get()
    let size = try destination.size()
    if size.width <= 0.0 or size.height <= 0.0:
        return
    let scale = math.clamp(size.scale, 0.5, 4.0)
    let width = (u32)math.max(1.0, math.floor(bounds.width * scale + 0.5))
    let height = (u32)math.max(1.0, math.floor(bounds.height * scale + 0.5))
    let coverage = try alloc u8[(usize)width * (usize)height] in memory.heap
    defer free(coverage) in memory.heap
    try svg.rasterize(drawing, width, height, coverage)
    let x = math.floor(bounds.x * scale + 0.5) / scale
    let y = math.floor(bounds.y * scale + 0.5) / scale
    try destination.mask(coverage, width, height, gpu.Rect(x, y, (f64)width / scale, (f64)height / scale), color)
