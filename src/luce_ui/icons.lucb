## Small vector symbols use a 16-unit design grid. They do not depend on font
## glyph coverage, platform emoji or private-use characters in patched fonts.
import gpu
from luce_ui.geometry import Point
from luce_ui.painter import Painter

pub enum IconKind as u8:
    blank = 0
    folder = 1
    folder_open = 2
    file = 3
    code = 4
    terminal = 5
    settings = 6

pub func draw(painter: Painter*, kind: IconKind, bounds: gpu.Rect, color: gpu.Color) -> !:
    if bounds.width <= 0.0 or bounds.height <= 0.0:
        return
    if kind == IconKind.folder or kind == IconKind.folder_open:
        try rectangle(painter, bounds, gpu.Rect(1.0, 3.0, 6.0, 3.0), color)
        try rectangle(painter, bounds, gpu.Rect(1.0, 5.0, 14.0, 8.0), color)
        if kind == IconKind.folder_open:
            # An offset front lip distinguishes the current/parent directory.
            try polygon(painter, bounds, [Point(0.0, 8.0), Point(16.0, 8.0), Point(13.0, 14.0), Point(1.0, 14.0)], color)
    elif kind == IconKind.file:
        try path(painter, bounds, [Point(3.0, 1.0), Point(10.0, 1.0), Point(14.0, 5.0), Point(14.0, 15.0), Point(3.0, 15.0), Point(3.0, 1.0)], color)
        try path(painter, bounds, [Point(10.0, 1.0), Point(10.0, 5.0), Point(14.0, 5.0)], color)
        try path(painter, bounds, [Point(5.0, 9.0), Point(11.0, 9.0)], color)
        try path(painter, bounds, [Point(5.0, 12.0), Point(10.0, 12.0)], color)
    elif kind == IconKind.code:
        try path(painter, bounds, [Point(5.0, 4.0), Point(1.0, 8.0), Point(5.0, 12.0)], color)
        try path(painter, bounds, [Point(11.0, 4.0), Point(15.0, 8.0), Point(11.0, 12.0)], color)
        try path(painter, bounds, [Point(9.0, 2.0), Point(7.0, 14.0)], color)
    elif kind == IconKind.terminal:
        try path(painter, bounds, [Point(1.0, 2.0), Point(15.0, 2.0), Point(15.0, 14.0), Point(1.0, 14.0), Point(1.0, 2.0)], color)
        try path(painter, bounds, [Point(4.0, 5.0), Point(7.0, 8.0), Point(4.0, 11.0)], color)
        try path(painter, bounds, [Point(9.0, 11.0), Point(12.0, 11.0)], color)
    elif kind == IconKind.settings:
        for index in 0..<3:
            let y = 4.0 + (f64)index * 4.0
            try path(painter, bounds, [Point(1.0, y), Point(15.0, y)], color)
            try rectangle(painter, bounds, gpu.Rect(4.0 if index != 1 else 10.0, y - 2.0, 2.0, 4.0), color)

func point(bounds: gpu.Rect, value: Point) -> Point:
    return Point(bounds.x + value.x * bounds.width / 16.0, bounds.y + value.y * bounds.height / 16.0)

func rectangle(painter: Painter*, bounds: gpu.Rect, value: gpu.Rect, color: gpu.Color) -> !:
    try painter.rectangle(gpu.Rect(bounds.x + value.x * bounds.width / 16.0, bounds.y + value.y * bounds.height / 16.0,
        value.width * bounds.width / 16.0, value.height * bounds.height / 16.0), color)

func path(painter: Painter*, bounds: gpu.Rect, points: const Point[], color: gpu.Color) -> !:
    for index in 1..<points.length:
        try painter.line(point(bounds, points[index - 1]), point(bounds, points[index]), bounds.width / 16.0, color)

## These internal silhouettes are convex; triangle fans preserve their edges.
func polygon(painter: Painter*, bounds: gpu.Rect, points: const Point[], color: gpu.Color) -> !:
    for index in 1..<points.length - 1:
        try painter.triangle(point(bounds, points[0]), point(bounds, points[index]), point(bounds, points[index + 1]), color)
