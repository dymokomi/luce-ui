## Editor icons are the shared luciaos rounded SVGs (24×24, currentColor), flattened by
## luce-svg and drawn with the painter — strokes as thick lines, fills as triangle fans —
## tinted with the given color. IconKind names the icon; the artwork lives in the embedded
## icon_assets table. A blank kind draws nothing.
import gpu
import interop
import math
from luce_ui.geometry import Point
from luce_ui.painter import Painter
import svg
import luce_ui.icon_assets as icon_assets

pub enum IconKind as u8:
    blank = 0
    folder = 1
    folder_open = 2
    file = 3
    code = 4
    terminal = 5
    settings = 6

func name_of(kind: IconKind) -> str:
    if kind == IconKind.folder:
        return "folder"
    if kind == IconKind.folder_open:
        return "folder_open"
    if kind == IconKind.file:
        return "file"
    if kind == IconKind.code:
        return "code"
    if kind == IconKind.terminal:
        return "terminal"
    if kind == IconKind.settings:
        return "settings"
    return ""

pub func draw(painter: Painter*, kind: IconKind, bounds: gpu.Rect, color: gpu.Color) -> !:
    if bounds.width <= 0.0 or bounds.height <= 0.0 or kind == IconKind.blank:
        return
    let source = icon_assets.source(name_of(kind))
    if source == "":
        return
    let drawing = try svg.parse(source)
    defer drawing.release()
    try render(painter, try drawing.get(), bounds, color)

## Scale the viewBox into `bounds` (uniform, centered), accumulate every contour's
## triangles into one buffer, and submit them as a SINGLE draw. One draw per icon keeps
## a busy file tree well under the canvas's per-frame draw budget (the old one-draw-per-
## segment cost blew past it on large folders and silently closed the window).
func render(painter: Painter*, drawing: svg.Drawing*, bounds: gpu.Rect, color: gpu.Color) -> !:
    let view_w = drawing.view_width()
    let view_h = drawing.view_height()
    if view_w <= 0.0 or view_h <= 0.0:
        return
    let scale = (bounds.width / view_w) if bounds.width / view_w < bounds.height / view_h else bounds.height / view_h
    let origin_x = bounds.x + (bounds.width - view_w * scale) * 0.5
    let origin_y = bounds.y + (bounds.height - view_h * scale) * 0.5
    let stroke = 2.0 * scale if 2.0 * scale > 1.0 else 1.0
    var mesh: Point[2048]
    var used: usize = 0
    for index in 0..<drawing.contour_count():
        let start = drawing.contour_start(index)
        let count = drawing.contour_size(index)
        if drawing.contour_filled(index) and count >= 3:
            let anchor = mapped(drawing.point(start), origin_x, origin_y, scale)
            for step in 1..<count - 1:
                used = add_triangle(mesh, used, anchor, mapped(drawing.point(start + step), origin_x, origin_y, scale),
                    mapped(drawing.point(start + step + 1), origin_x, origin_y, scale))
        if drawing.contour_stroked(index) and count >= 2:
            var step: usize = 1
            while step < count:
                used = add_segment(mesh, used, mapped(drawing.point(start + step - 1), origin_x, origin_y, scale),
                    mapped(drawing.point(start + step), origin_x, origin_y, scale), stroke)
                step += 1
            if drawing.contour_closed(index):
                used = add_segment(mesh, used, mapped(drawing.point(start + count - 1), origin_x, origin_y, scale),
                    mapped(drawing.point(start), origin_x, origin_y, scale), stroke)
    if used >= 3:
        try painter.mesh(mesh[..<used], color)

func mapped(value: svg.Point, origin_x: f64, origin_y: f64, scale: f64) -> Point:
    return Point(origin_x + value.x * scale, origin_y + value.y * scale)

func add_triangle(mesh: Point[], used: usize, a: Point, b: Point, c: Point) -> usize:
    if used + 3 > mesh.length:
        return used
    mesh[used] = a
    mesh[used + 1] = b
    mesh[used + 2] = c
    return used + 3

## A stroke segment as a quad (two triangles), offset perpendicular by half the width.
func add_segment(mesh: Point[], used: usize, a: Point, b: Point, width: f64) -> usize:
    if used + 6 > mesh.length:
        return used
    let dx = b.x - a.x
    let dy = b.y - a.y
    let length = math.sqrt(dx * dx + dy * dy)
    if length == 0.0:
        return used
    let ox = -dy * width * 0.5 / length
    let oy = dx * width * 0.5 / length
    mesh[used] = Point(a.x + ox, a.y + oy)
    mesh[used + 1] = Point(b.x + ox, b.y + oy)
    mesh[used + 2] = Point(b.x - ox, b.y - oy)
    mesh[used + 3] = Point(a.x + ox, a.y + oy)
    mesh[used + 4] = Point(b.x - ox, b.y - oy)
    mesh[used + 5] = Point(a.x - ox, a.y - oy)
    return used + 6
