## Original fixed 5x7 glyphs. Unsupported scalars use one visible replacement.
## Measurement and drawing advance 12 points per scalar, preserving letter case.
import utf8
import luce_ui.result as result

pub struct BitmapFont:
    pub let pixel_size: f64 = 2.0

    pub func measure(text: str) -> f64!:
        if not (self.pixel_size >= 0.25 and self.pixel_size <= 64.0):
            error(result.invalid, "bitmap pixel size must be in 0.25..64 points")
        if text.length > 4096:
            error(result.limit, "a bitmap label supports at most 4096 UTF-8 bytes")
        var offset: usize = 0
        var count: usize = 0
        while offset < text.length:
            let scalar = utf8.decode(text.bytes, offset) else error(result.invalid, "a UI label must be valid UTF-8")
            offset += scalar.width
            count += 1
        if count > 1024:
            error(result.limit, "a bitmap label supports at most 1024 scalars")
        return (f64)count * 6.0 * self.pixel_size

    pub static func glyph(code: char) -> u64:
        match code:
            'A': return 18842895918
            'B': return 16694887983
            'C': return 32246891582
