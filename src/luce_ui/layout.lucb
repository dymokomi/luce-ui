from luce_ui.theme import Theme
from luce_ui.painter import Painter
import luce_ui.splitting as splitting
import gpu
import input
import interop
import math
import memory
import ownership
import thread
import luce_ui.result as result
import luce_ui.geometry as geometry
from luce_ui.arrangement import Arrangement
from luce_ui.cursor import CursorSource

pub type Rect = gpu.Rect

pub type Point = geometry.Point
pub type Size = geometry.Size

pub struct Constraints:
    pub var width: f64 = 16384.0
    pub var height: f64 = 16384.0

pub enum Axis as u8:
    overlay = 0
    horizontal = 1
    vertical = 2

pub enum Alignment as u8:
    start = 0
    center = 1
    end = 2
    stretch = 3

pub enum PopupPlacement as u8:
    below = 0
    point = 1
    window_top = 2
    window_center = 3

## Coordinates are local to the receiving widget. Cancellation clears any press.
pub struct Event:
    pub var kind: input.EventKind
    pub var key: input.Key
    pub var x: f64
    pub var y: f64
    pub var button: i64
    pub var repeated: bool
    pub var shift: bool
    pub var control: bool
    pub var alt: bool
    pub var meta: bool
    pub var codepoint: i64
    pub var inside: bool
    pub var cancelled: bool
    ## Menu triggers receive this request when an open menu session changes peer.
    pub var menu_requested: bool
    pub var scroll_x: f64
    pub var scroll_y: f64
    pub var scroll_unit: input.ScrollUnit

## layout returns one retained reference to the same Layout for this widget's
## lifetime. A measure/draw/event implementation may fail or reenter application
## code. The framework invokes it under an active interface guard.
pub interface Widget:
    func layout() -> interop.Reference[Layout]
    func measure(available: Constraints) -> interop.Outcome[Size]
    mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]
    mutating func event(event: Event) -> interop.Outcome[unit]

var serial: u64 = 0
var revision: u64 = 0

pub func epoch() -> u64:
    return revision

## Layout owns child interfaces and geometry, never control-specific state.
## Parent/application membership is weak identity, so trees have no parent cycle.
pub struct Layout:
    let identifier: u64
    var parent: u64
    var application: u64
    var items: interop.Interface[Widget][]
    let axis: Axis
    let spacing: f64
    let padding: f64
    let alignment: Alignment
    var minimum: Size
    var maximum: Size
    var growth: Size
    var shrink: Size
    var split: f64?
    var arrangement: interop.Interface[Arrangement]?
    var cursor_source: interop.Interface[CursorSource]?
    var pointer_cursor: input.Cursor
    var focus_requested: bool
    var measured: Size
    var local_theme: Theme?
    var appearance: Theme
    var rectangle: Rect
    var clipping: Rect
    var visible: bool
    var popup: bool
    var popup_placement: PopupPlacement
    var popup_point: Point
    var animate_open: bool
    var opening: bool
    var context_menu: bool
    var menu_trigger: bool
    var accepts_focus: bool
    var accepts_pointer: bool
    var accepts_text: bool
    var accepts_tab: bool
    var active: bool
    var focused: bool
    var focus_within: bool
    var hovered: bool
    var pointer_within: bool
    var pointer: Point
    var editing: bool
    var hover_transparent: bool

    pub func init(axis: Axis = Axis.overlay, spacing: f64 = 0.0, padding: f64 = 0.0,
                  alignment: Alignment = Alignment.stretch) -> !:
        try require_main_thread()
        try extent(spacing)
        try extent(padding)
        serial = serial +? 1 else error(result.limit, "UI identities exhausted")
        self.identifier = serial
        self.parent = 0
        self.application = 0
        var empty: interop.Interface[Widget][]
        self.items = empty
        self.arrangement = none
        self.cursor_source = none
        self.pointer_cursor = input.Cursor.arrow
        self.focus_requested = false
        self.axis = axis
        self.spacing = spacing
        self.padding = padding
        self.alignment = alignment
        self.minimum = Size()
        self.maximum = Size(16384.0, 16384.0)
        self.growth = Size()
        self.shrink = Size(1.0, 1.0)
        self.split = none
        self.measured = Size()
        self.local_theme = none
        self.appearance = Theme()
        self.rectangle = Rect()
        self.clipping = Rect()
        self.visible = true
        self.popup = false
        self.popup_placement = PopupPlacement.below
        self.popup_point = Point()
        self.animate_open = false
        self.opening = false
        self.context_menu = false
        self.menu_trigger = false
        self.accepts_focus = false
        self.accepts_pointer = false
        self.accepts_text = false
        self.accepts_tab = false
        self.active = true
        self.focused = false
        self.focus_within = false
        self.hovered = false
        self.pointer_within = false
        self.pointer = Point()
        self.editing = false
        self.hover_transparent = false

    pub func is_visible() -> bool:
        return self.visible

    pub mutating func set_visible(visible: bool):
        self.visible = visible
        self.invalidate()

    ## A popup is measured normally, placed beside its parent and clipped to
    ## the window. Its subtree is drawn last and receives modal input.
    pub mutating func set_popup(popup: bool):
        self.popup = popup
        self.invalidate()

    ## A point is local to the popup's parent. Window placement clamps every
    ## edge; centered command surfaces stay independent of surrounding flow.
    pub mutating func set_popup_point(x: f64, y: f64) -> !:
        if not math.is_finite(x) or not math.is_finite(y):
            error(result.invalid, "popup coordinates must be finite")
        self.popup_placement = PopupPlacement.point
        self.popup_point = Point(x, y)
        self.invalidate()

    pub mutating func set_popup_placement(placement: PopupPlacement):
        self.popup_placement = placement

    ## Let this popup ease to its placement instead of snapping. begin_open restarts
    ## the entrance each time it is shown; a size or position change while open eases too.
    pub mutating func set_animate_open(value: bool):
        self.animate_open = value

    pub mutating func begin_open():
        self.opening = true
        self.invalidate()

    ## Context providers receive a secondary-click request after its target has
    ## selected the clicked content. The nearest enabled ancestor handles it.
    pub mutating func set_context_menu(enabled: bool):
        self.context_menu = enabled
        self.accepts_pointer = enabled or self.accepts_pointer
        self.invalidate()

    ## Sibling triggers form one menu group. Only an already-open menu enables
    ## pointer switching; context menus and other modal popups remain isolated.
    pub mutating func set_menu_trigger(enabled: bool):
        self.menu_trigger = enabled
        self.invalidate()

    pub func theme() -> Theme:
        return self.appearance

    pub mutating func set_theme(theme: Theme) -> !:
        try theme.validate()
        self.local_theme = theme
        self.appearance = theme
        self.invalidate()

    pub mutating func inherit_theme():
        self.local_theme = none
        self.invalidate()

    pub func id() -> i64:
        return (i64)self.identifier

    pub func bounds() -> Rect:
        return self.rectangle

    pub func is_focused() -> bool:
        return self.focused

    pub func contains_focus() -> bool:
        return self.focus_within

    ## Resolve to the first eligible descendant after the next arrangement.
    ## Containers can reveal a tab and focus its content in the same operation.
    pub mutating func request_focus():
        self.focus_requested = true
        self.invalidate()

    ## Hover follows the topmost visible, enabled branch, independently of
    ## keyboard focus and pointer capture. Ancestors can style their whole pane.
    pub func is_hovered() -> bool:
        return self.hovered

    pub func contains_pointer() -> bool:
        return self.pointer_within

    ## Coordinates are local to this layout, valid while contains_pointer is true.
    pub func pointer_position() -> Point:
        return self.pointer

    ## Cursor changes do not invalidate geometry. The application resolves the
    ## current hit or capture after dispatch and after each layout refresh.
    pub mutating func set_cursor(cursor: input.Cursor):
        self.pointer_cursor = cursor

    pub mutating func set_cursor_source(source: interop.Interface[CursorSource]) -> !:
        try source.enter()
        defer source.leave()
        let retained = source.clone()
        if let previous = self.cursor_source: previous.release()
        self.cursor_source = retained

    pub func is_enabled() -> bool:
        return self.active

    pub mutating func set_enabled(enabled: bool):
        self.active = enabled
        self.invalidate()

    pub mutating func set_focusable(focusable: bool):
        self.accepts_focus = focusable
        if focusable:
            self.accepts_pointer = true
        self.invalidate()

    pub mutating func set_interactive(interactive: bool):
        self.accepts_pointer = interactive
        self.invalidate()

    ## A decorative layer that lies over content, such as a drag preview, opts out
    ## of hover so the interactive widgets beneath it still light up under the pointer.
    pub mutating func set_hover_transparent(value: bool):
        self.hover_transparent = value
        self.invalidate()

    ## Text controls receive committed Unicode and may reserve Tab for indentation.
    ## Control-Tab always remains available for moving focus out of an editor.
    pub mutating func set_text_input(enabled: bool, tabs: bool = false):
        self.accepts_text = enabled
        self.accepts_tab = enabled and tabs
        if enabled:
            self.set_focusable(true)
        self.invalidate()

    pub func invalidate():
        revision = revision +? 1 else trap("UI revision exhausted")

    pub mutating func set_limits(minimum: Size, maximum: Size) -> !:
        try extent(minimum.width)
        try extent(minimum.height)
        try extent(maximum.width)
        try extent(maximum.height)
        if minimum.width > maximum.width or minimum.height > maximum.height:
            error(result.invalid, "layout minimum exceeds maximum")
        self.minimum = minimum
        self.maximum = maximum
        self.invalidate()

    pub mutating func set_size(width: f64, height: f64) -> !:
        try self.set_limits(Size(width, height), Size(width, height))

    ## Shrink weights are independent of growth. Fixed-height chrome can keep
    ## its line while flexible content absorbs a smaller window.
    pub mutating func set_shrink(horizontal: f64 = 1.0, vertical: f64 = 1.0) -> !:
        try extent(horizontal)
        try extent(vertical)
        self.shrink = Size(horizontal, vertical)
        self.invalidate()

    pub mutating func set_flex(horizontal: f64 = 1.0, vertical: f64 = 1.0) -> !:
        try extent(horizontal)
        try extent(vertical)
        self.growth = Size(horizontal, vertical)
        self.invalidate()

    pub func minimum_size() -> Size:
        return self.minimum

    pub func maximum_size() -> Size:
        return self.maximum

    ## Decorators can preserve a content widget's sizing policy while owning a
    ## separate layout for popup children or framing.
    pub mutating func copy_sizing_from(source: interop.Reference[Layout]) -> !:
        let value = try source.get()
        self.minimum = value.minimum
        self.maximum = value.maximum
        self.growth = value.growth
        self.shrink = value.shrink
        self.invalidate()

    ## Split layouts contain first pane, divider and second pane, in that order.
    ## The fraction is a preference; placement enforces the children's limits.
    pub mutating func set_split(fraction: f64) -> !:
        if self.axis == Axis.overlay or not math.is_finite(fraction) or fraction < 0.0 or fraction > 1.0:
            error(result.invalid, "a split needs a horizontal/vertical axis and a fraction in 0..1")
        if self.items.length != 3:
            error(result.invalid, "a split needs two panes and one divider")
        self.split = fraction
        self.invalidate()

    pub func split_fraction() -> f64:
        return self.split else 0.5

    pub mutating func set_arrangement(arrangement: interop.Interface[Arrangement]) -> !:
        if self.axis != Axis.overlay or self.split != none:
            error(result.invalid, "custom arrangement needs an overlay layout")
        try arrangement.enter()
        defer arrangement.leave()
        let replacement = arrangement.clone()
        if let previous = self.arrangement:
            previous.release()
        self.arrangement = replacement
        self.invalidate()

    pub func child_count() -> i64:
        return (i64)self.items.length

    pub func child(index: i64) -> interop.Interface[Widget]!:
        if index < 0 or (usize)index >= self.items.length:
            error(result.invalid, "child index is outside this layout")
        return self.items[(usize)index].clone()

    ## Replacement is transactional: validate and allocate before changing edges.
    pub mutating func set_children(children: const interop.Interface[Widget][]) -> !:
        if self.editing:
            error(result.busy, "child replacement cannot reenter the same layout")
        if self.split != none and children.length != 3:
            error(result.invalid, "a split needs two panes and one divider")
        self.editing = true
        defer self.finish_edit()
        if children.length > 1024:
            error(result.limit, "a layout supports at most 1024 children")
        var index: usize = 0
        for child in children:
            try child.enter()
            defer child.leave()
            let layout = child.value().layout()
            defer layout.release()
            let state = try layout.get()
            if state.parent != 0 and state.parent != self.identifier:
                error(result.busy, "a widget already has a parent")
            # Traversal membership may outlive a just-removed parent edge until
            # the next arrangement. Reattaching within that same application is
            # safe; its retained snapshot still protects any active dispatch.
            if state.application != 0 and state.parent != self.identifier and state.application != self.application:
                error(result.busy, "a widget is mounted in an application")
            if try contains(child, self.identifier, 0):
                error(result.invalid, "a widget tree cannot contain a cycle")
            for previous in children[..<index]:
                let other = try widget_layout(previous)
                defer other.release()
                if other.value().identifier == state.identifier:
                    error(result.invalid, "a layout cannot contain the same widget twice")
            index += 1
        var replacement: interop.Interface[Widget][]
        if children.length > 0:
            replacement = try alloc interop.Interface[Widget][children.length] in memory.heap
        index = 0
        for child in children:
            replacement[index] = child.clone()
            index += 1
        self.detach()
        self.items = replacement
        for child in self.items:
            let layout = try widget_layout(child)
            defer layout.release()
            layout.value().parent = self.identifier
        self.invalidate()

    pub func content_size(available: Constraints) -> Size!:
        var size = Size()
        var count: usize = 0
        for child in self.items:
            let layout = try widget_layout(child)
            defer layout.release()
            if not layout.value().visible or layout.value().popup:
                continue
            count += 1
            let measured = layout.value().measured
            if self.axis == Axis.horizontal:
                size.width += measured.width
                size.height = math.max(size.height, measured.height)
            elif self.axis == Axis.vertical:
                size.width = math.max(size.width, measured.width)
                size.height += measured.height
            else:
                size.width = math.max(size.width, measured.width)
                size.height = math.max(size.height, measured.height)
        let gaps = (f64)(count - 1) * self.spacing if count > 0 else 0.0
        size.width += self.padding * 2.0 + (gaps if self.axis == Axis.horizontal else 0.0)
        size.height += self.padding * 2.0 + (gaps if self.axis == Axis.vertical else 0.0)
        return Size(math.min(size.width, available.width), math.min(size.height, available.height))

    mutating func finish_edit():
        self.editing = false

    mutating func detach():
        let previous = self.items
        var empty: interop.Interface[Widget][]
        self.items = empty
        for child in previous:
            # Parents retain interfaces; a child's explicit close may precede
            # removal. Closed children need no further membership mutation.
            let layout = widget_layout(child) catch failure:
                child.release()
                continue
            # Collection finalizes every owner before releasing graph edges.
            # A still-open widget can therefore return an already-closed layout.
            let state: Layout*? = layout.get() catch failure: recover none
            if let open = state: open.parent = 0
            layout.release()
            child.release()
        if previous.length > 0:
            free(previous) in memory.heap

    mutating func dispose():
        self.detach()
        if let source = self.cursor_source: source.release()
        if let arrangement = self.arrangement:
            arrangement.release()
        self.invalidate()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let source = self.cursor_source: source.trace(visit, context)
        if let arrangement = self.arrangement:
            arrangement.trace(visit, context)
        for child in self.items:
            child.trace(visit, context)

pub let layout_type: interop.Type[Layout] = interop.Type[Layout]("UI layout", Layout.dispose, Layout.trace, main_thread = true)

pub func make_layout(axis: Axis = Axis.overlay, spacing: f64 = 0.0, padding: f64 = 0.0,
                     alignment: Alignment = Alignment.stretch) -> interop.Reference[Layout]!:
    return try interop.Reference[Layout].adopt(new Layout(axis, spacing, padding, alignment) in memory.heap, layout_type, memory.heap)

pub func widget_layout(widget: interop.Interface[Widget]) -> interop.Reference[Layout]!:
    try widget.enter()
    defer widget.leave()
    return widget.value().layout()

func contains(widget: interop.Interface[Widget], identifier: u64, depth: usize) -> bool!:
    if depth >= 64:
        error(result.limit, "a widget tree supports at most 64 levels")
    let layout = try widget_layout(widget)
    defer layout.release()
    let state = try layout.get()
    if state.identifier == identifier:
        return true
    for child in state.items:
        if try contains(child, identifier, depth + 1):
            return true
    return false

pub func extent(value: f64) -> !:
    if not (value >= 0.0 and value <= 16384.0):
        error(result.invalid, "layout dimensions must be finite and in 0..16384")

struct Entry:
    let widget: interop.Interface[Widget]
    let box: interop.Reference[Layout]
    let parent: i64
    var end: usize

## A retained traversal protects callbacks against reentrant tree replacement.
## It is rebuilt transactionally and bounded independently of recursion depth.
pub struct Tree:
    let root: interop.Interface[Widget]
    let identifier: u64
    var entries: Entry[]
    var count: usize
    var width: f64
    var height: f64
    var version: u64
    var focus: u64
    var requested_focus: u64
    var capture: u64
    var return_focus: u64
    var appearance: Theme
    var pointer_present: bool
    var pointer_x: f64
    var pointer_y: f64
    var animating: bool

    pub func init(content: interop.Interface[Widget], theme: Theme = Theme()) -> !:
        try require_main_thread()
        try theme.validate()
        serial = serial +? 1 else error(result.limit, "UI identities exhausted")
        self.identifier = serial
        self.root = content.clone()
        var empty: Entry[]
        self.entries = empty
        self.count = 0
        self.width = 0.0
        self.height = 0.0
        self.version = 0
        self.focus = 0
        self.requested_focus = 0
        self.capture = 0
        self.return_focus = 0
        self.appearance = theme
        self.pointer_present = false
        self.pointer_x = 0.0
        self.pointer_y = 0.0
        self.animating = false

    ## Whether a popup is still easing toward its placement, so the run loop keeps
    ## drawing frames until it settles instead of blocking.
    pub func is_animating() -> bool:
        return self.animating

    pub func theme() -> Theme:
        return self.appearance

    pub mutating func set_theme(theme: Theme) -> !:
        try theme.validate()
        self.appearance = theme
        revision = revision +? 1 else trap("UI revision exhausted")

    pub mutating func refresh() -> interop.Outcome[unit]:
        return self.arrange(self.width, self.height)

    pub mutating func arrange(width: f64, height: f64) -> interop.Outcome[unit]:
        extent(width) catch failure:
            return result.failure[unit](failure.code, failure.message)
        extent(height) catch failure:
            return result.failure[unit](failure.code, failure.message)
        if self.count > 0 and self.width == width and self.height == height and self.version == epoch():
            return result.success[unit](())
        self.animating = false
        let replacement = alloc Entry[1024] in memory.heap catch failure:
            return result.failure[unit](failure.code, failure.message)
        var count: usize = 0
        var committed = false
        defer discard_replacement(replacement, &count, &committed)
        let started = epoch()
        gather(self.root, replacement, &count, -1, 0, self.identifier) catch failure:
            return result.failure[unit](failure.code, failure.message)
        # Resolve parent context before measuring descendants. Values avoid
        # shared mutable theme state and require no work in widget draw paths.
        for position in 0..<count:
            let entry = &replacement[position]
            let inherited = replacement[(usize)entry.parent].box.value().appearance if entry.parent >= 0 else self.appearance
            entry.box.value().appearance = entry.box.value().local_theme else inherited
        var index = count
        while index > 0:
            index -= 1
            let entry = &replacement[index]
            entry.widget.enter() catch failure:
                return result.failure[unit](failure.code, failure.message)
            defer entry.widget.leave()
            let measured = entry.widget.value().measure(Constraints(width, height))
            defer measured.release()
            let size = measured.get() catch failure:
                return result.failure[unit](failure.code, failure.message)
            extent(size.width) catch failure:
                return result.failure[unit](failure.code, failure.message)
            extent(size.height) catch failure:
                return result.failure[unit](failure.code, failure.message)
            let box = entry.box.value()
            box.measured = Size(math.clamp(size.width, box.minimum.width, box.maximum.width),
                                math.clamp(size.height, box.minimum.height, box.maximum.height))
        if epoch() != started:
            return result.failure[unit](result.busy, "a widget changed the tree during measurement")
        let bounds = Rect(width = width, height = height)
        place(replacement, 0, bounds, bounds) catch failure:
            return result.failure[unit](failure.code, failure.message)
        var popup: u64 = 0
        for entry in replacement[..<count]:
            let box = entry.box.value()
            if box.popup and entry.parent >= 0:
                let anchor = replacement[(usize)entry.parent].box.value().rectangle
                let popup_width = math.min(box.measured.width, bounds.width)
                let popup_height = math.min(box.measured.height, bounds.height)
                var x = math.clamp(anchor.x, 0.0, bounds.width - popup_width)
                let below = anchor.y + anchor.height
                var y = below if below + popup_height <= bounds.height else math.max(0.0, anchor.y - popup_height)
                if box.popup_placement == PopupPlacement.point:
                    x = math.clamp(anchor.x + box.popup_point.x, 0.0, bounds.width - popup_width)
                    y = math.clamp(anchor.y + box.popup_point.y, 0.0, bounds.height - popup_height)
                elif box.popup_placement == PopupPlacement.window_top:
                    x = (bounds.width - popup_width) * 0.5
                    y = math.min(math.min(40.0, bounds.height * 0.1), bounds.height - popup_height)
                elif box.popup_placement == PopupPlacement.window_center:
                    x = (bounds.width - popup_width) * 0.5
                    y = math.max(0.0, (bounds.height - popup_height) * 0.5)
                var placed = Rect(x, y, popup_width, popup_height)
                if box.animate_open and box.visible:
                    if box.opening:
                        # Grow downward from the pinned top: start at half height with the
                        # same top and width, so the search field never moves — only the
                        # bottom eases open. Height changes while open animate the same way.
                        box.opening = false
                        box.rectangle = Rect(placed.x, placed.y, placed.width, placed.height * 0.5)
                    let eased = ease_rect(box.rectangle, placed, 0.22)
                    if not settled(eased, placed):
                        placed = eased
                        self.animating = true
                        revision = revision +? 1 else trap("UI revision exhausted")
                let position = find_entry(replacement, count, box.identifier) else trap("popup missing from tree")
                place(replacement, position, placed, bounds) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                popup = box.identifier
        if popup != 0 and popup != self.focus:
            if self.return_focus == 0:
                self.return_focus = self.focus
            self.focus = popup
        # Cancel against the old retained snapshot before its edges are released.
        if self.capture != 0 and not eligible(replacement, count, self.capture, false):
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            self.capture = 0
        if self.focus != 0 and not eligible(replacement, count, self.focus, true):
            if self.focus != self.capture:
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.focus = 0
        if popup == 0 and self.return_focus != 0:
            if eligible(replacement, count, self.return_focus, true):
                self.focus = self.return_focus
            self.return_focus = 0
        if popup == 0:
            for position in 0..<count:
                let entry = &replacement[position]
                if entry.box.value().focus_requested:
                    entry.box.value().focus_requested = false
                    for descendant in position..<entry.end:
                        let identifier = replacement[descendant].box.value().identifier
                        if eligible(replacement, count, identifier, true):
                            self.focus = identifier
                            break
        if self.requested_focus != 0 and popup == 0:
            if eligible(replacement, count, self.requested_focus, true):
                self.focus = self.requested_focus
            self.requested_focus = 0
        for entry in self.entries[..<self.count]:
            entry.box.value().application = 0
            entry.box.value().focused = false
            entry.box.value().focus_within = false
            entry.box.value().hovered = false
            entry.box.value().pointer_within = false
        release_entries(self.entries, self.count)
        committed = true
        self.entries = replacement
        self.count = count
        self.width = width
        self.height = height
        self.version = started
        for entry in self.entries[..<self.count]:
            let box = entry.box.value()
            box.application = self.identifier
            box.focused = box.identifier == self.focus
        mark_focus(self.entries, self.count, self.focus, self.return_focus)
        self.update_hover()
        return result.success[unit](())

    pub func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        for pass in 0..<2:
            for index in 0..<self.count:
                if in_popup(self.entries, index) != (pass == 1):
                    continue
                let entry = self.entries[index]
                let box = entry.box.value()
                if box.clipping.width <= 0.0 or box.clipping.height <= 0.0:
                    continue
                let native_target = target.get() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                # Shadows use the window target before popup clipping. They do
                # not enlarge layout or hit bounds, and remain sharp at any scale.
                if box.popup:
                    self.draw_shadow(target, box.rectangle, box.appearance) catch failure:
                        return result.failure[unit](failure.code, failure.message)
                let clipped = native_target.clipped(box.clipping) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer clipped.release()
                let native_clipped = clipped.get() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                let region = native_clipped.region(box.rectangle) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer region.release()
                entry.widget.enter() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer entry.widget.leave()
                var widget = entry.widget.value()
                let drawn = widget.draw(region)
                if not drawn.is_success():
                    return drawn
                drawn.release()
        return result.success[unit](())

    ## A soft drop shadow around the whole popup: several expanding layers, densest at
    ## the box and fading outward, with a slight downward bias so the surface reads as
    ## lifted off the content behind it. Drawn before the popup's own clip.
    func draw_shadow(target: interop.View[gpu.RenderTarget], bounds: Rect, theme: Theme) -> !:
        if theme.shadow_offset == 0.0 or theme.shadow_opacity == 0.0:
            return
        var painter = try Painter(target)
        defer painter.close()
        # Many thin nested layers feather smoothly instead of banding. Each adds the
        # same alpha, chosen so the layers composite to shadow_opacity right at the box
        # and fall off across `spread`; a downward bias reads as a lifted surface.
        let layers = 24
        let spread = theme.shadow_offset * 6.0
        let step = spread / (f64)layers
        let bias = theme.shadow_offset * 0.6
        let per = 1.0 - math.pow(1.0 - theme.shadow_opacity, 1.0 / (f64)layers)
        for ring in 0..<layers:
            let grow = step * (f64)(ring + 1)
            try painter.rectangle(Rect(bounds.x - grow, bounds.y - grow + bias,
                bounds.width + grow * 2.0, bounds.height + grow * 2.0), theme.shadow, per)

    pub mutating func dispatch(event: input.Event) -> interop.Outcome[unit]:
        let arranged = self.arrange(self.width, self.height)
        if not arranged.is_success():
            return arranged
        arranged.release()
        if event.kind == input.EventKind.pointer_left:
            self.pointer_present = false
            self.update_hover()
            return result.success[unit](())
        if event.kind == input.EventKind.pointer_moved or event.kind == input.EventKind.pointer_entered or event.kind == input.EventKind.pointer_down or event.kind == input.EventKind.pointer_up or event.kind == input.EventKind.scroll or event.kind == input.EventKind.magnify:
            self.pointer_x = event.x
            self.pointer_y = event.y
            self.pointer_present = math.is_finite(event.x) and math.is_finite(event.y)
            self.update_hover()
        if event.kind == input.EventKind.focus_lost or event.kind == input.EventKind.overflow:
            self.pointer_present = false
            self.update_hover()
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            if self.focus != self.capture:
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.capture = 0
            self.return_focus = 0
            self.requested_focus = 0
            self.set_focus(0)
            return result.success[unit](())
        if let popup = self.popup_index():
            let box = self.entries[popup].box.value()
            if event.kind == input.EventKind.pointer_moved or (event.kind == input.EventKind.pointer_down and event.button == 0):
                if let peer = self.menu_at(popup, event.x, event.y):
                    if self.entries[popup].parent != (i64)peer:
                        return self.switch_menu(popup, peer)
            if event.kind == input.EventKind.key_down and not event.repeated and (event.key == input.Key.left or event.key == input.Key.right):
                if let peer = self.next_menu(popup, event.key == input.Key.left):
                    return self.switch_menu(popup, peer)
            if event.kind == input.EventKind.pointer_down and not inside(box.clipping, event.x, event.y):
                let cancelled = self.cancel(box.identifier)
                if not cancelled.is_success():
                    return cancelled
                cancelled.release()
                self.capture = 0
                return self.arrange(self.width, self.height)
            # Tab stays within the popup; its widget chooses how to navigate.
            if event.kind == input.EventKind.key_down or event.kind == input.EventKind.key_up or event.kind == input.EventKind.text_input or event.kind == input.EventKind.modifiers_changed:
                let delivered = self.send(popup, Event(kind = event.kind, key = event.key,
                    repeated = event.repeated, shift = event.modifiers.shift,
                    control = event.modifiers.control, alt = event.modifiers.alt, meta = event.modifiers.super,
                    codepoint = (i64)event.codepoint))
                if not delivered.is_success():
                    return delivered
                delivered.release()
                return self.arrange(self.width, self.height)
        let secondary = event.kind == input.EventKind.pointer_down and event.button == 1
        let keyboard_context = event.kind == input.EventKind.key_down and event.key == input.Key.f10 and event.modifiers.shift and not event.repeated
        if (secondary or keyboard_context) and not self.has_popup():
            let destination = self.hit(event.x, event.y) if secondary else self.focus
            if let target = self.find(destination):
                let box = self.entries[target].box.value()
                if secondary:
                    let cancelled = self.cancel(self.capture)
                    if not cancelled.is_success():
                        return cancelled
                    cancelled.release()
                    self.capture = 0
                    if box.accepts_focus:
                        if self.focus != destination:
                            let cancelled_focus = self.cancel(self.focus)
                            if not cancelled_focus.is_success():
                                return cancelled_focus
                            cancelled_focus.release()
                        self.set_focus(destination)
                    if not box.context_menu:
                        let selected = self.send(target, Event(kind = event.kind, button = 1,
                            x = event.x - box.rectangle.x, y = event.y - box.rectangle.y, inside = true))
                        if not selected.is_success():
                            return selected
                        selected.release()
                var ancestor = (i64)target
                while ancestor >= 0:
                    let provider = self.entries[(usize)ancestor].box.value()
                    if provider.context_menu and path_enabled(self.entries, (usize)ancestor):
                        let x = event.x - provider.rectangle.x if secondary else 0.0
                        let y = event.y - provider.rectangle.y if secondary else math.min(box.rectangle.y - provider.rectangle.y + box.rectangle.height, provider.rectangle.height)
                        let opened = self.send((usize)ancestor, Event(kind = input.EventKind.pointer_down, button = 1, x = x, y = y, inside = true))
                        if not opened.is_success():
                            return opened
                        opened.release()
                        return self.arrange(self.width, self.height)
                    ancestor = self.entries[(usize)ancestor].parent
            return result.success[unit](())
        var text_tab = false
        if let focused = self.find(self.focus):
            text_tab = self.entries[focused].box.value().accepts_tab and not event.modifiers.control
        if event.kind == input.EventKind.key_down and event.key == input.Key.tab and not text_tab:
            if not event.repeated:
                let capture_cancelled = self.cancel(self.capture)
                if not capture_cancelled.is_success():
                    return capture_cancelled
                capture_cancelled.release()
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
                self.capture = 0
                self.advance_focus(event.modifiers.shift)
            return result.success[unit](())
        var destination: u64 = 0
        if event.kind == input.EventKind.pointer_down and event.button == 0:
            destination = self.hit(event.x, event.y)
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            if destination != self.focus:
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.capture = destination
            let selected = self.find(destination)
            if let index = selected:
                self.set_focus(destination if self.entries[index].box.value().accepts_focus else 0)
            else:
                self.set_focus(0)
        elif event.kind == input.EventKind.pointer_up and event.button == 0:
            destination = self.capture
            self.capture = 0
        elif event.kind == input.EventKind.pointer_moved:
            destination = self.capture if self.capture != 0 else self.hit(event.x, event.y)
        elif event.kind == input.EventKind.scroll or event.kind == input.EventKind.magnify:
            destination = self.hit(event.x, event.y)
        elif event.kind == input.EventKind.key_down or event.kind == input.EventKind.key_up or event.kind == input.EventKind.text_input or event.kind == input.EventKind.modifiers_changed:
            destination = self.focus
        if let index = self.find(destination):
            let box = self.entries[index].box.value()
            let translated = Event(kind = event.kind, key = event.key,
                x = event.x - box.rectangle.x, y = event.y - box.rectangle.y,
                button = (i64)event.button, repeated = event.repeated, shift = event.modifiers.shift,
                control = event.modifiers.control, alt = event.modifiers.alt, meta = event.modifiers.super,
                codepoint = (i64)event.codepoint, scroll_unit = event.scroll_unit,
                inside = inside(box.clipping, event.x, event.y), scroll_x = event.scroll_x, scroll_y = event.scroll_y)
            let delivered = self.send(index, translated)
            if not delivered.is_success():
                return delivered
            delivered.release()
        let refreshed = self.arrange(self.width, self.height)
        if not refreshed.is_success():
            return refreshed
        refreshed.release()
        return result.success[unit](())

    func popup_index() -> usize?:
        var index = self.count
        while index > 0:
            index -= 1
            let box = self.entries[index].box.value()
            if box.popup and box.visible:
                return index
        return none

    func menu_owner(popup: usize) -> usize?:
        let parent = self.entries[popup].parent
        if parent < 0 or not self.entries[(usize)parent].box.value().menu_trigger:
            return none
        return (usize)parent

    func menu_at(popup: usize, x: f64, y: f64) -> usize?:
        let owner = self.menu_owner(popup) else return none
        let group = self.entries[owner].parent
        for index in 0..<self.count:
            let box = self.entries[index].box.value()
            if self.entries[index].parent == group and box.menu_trigger and path_enabled(self.entries, index) and inside(box.clipping, x, y):
                return index
        return none

    func next_menu(popup: usize, backwards: bool) -> usize?:
        let owner = self.menu_owner(popup) else return none
        let group = self.entries[owner].parent
        var index = owner
        for visited in 0..<self.count:
            index = (self.count - 1 if index == 0 else index - 1) if backwards else (index + 1) % self.count
            let box = self.entries[index].box.value()
            if self.entries[index].parent == group and box.menu_trigger and path_enabled(self.entries, index) and box.clipping.width > 0.0 and box.clipping.height > 0.0:
                return index
        return none

    mutating func switch_menu(popup: usize, peer: usize) -> interop.Outcome[unit]:
        let cancelled = self.cancel(self.entries[popup].box.value().identifier)
        if not cancelled.is_success():
            return cancelled
        cancelled.release()
        let capture_cancelled = self.cancel(self.capture)
        if not capture_cancelled.is_success():
            return capture_cancelled
        capture_cancelled.release()
        self.capture = 0
        self.return_focus = self.entries[peer].box.value().identifier
        let opened = self.send(peer, Event(menu_requested = true))
        if not opened.is_success():
            return opened
        opened.release()
        return self.arrange(self.width, self.height)

    ## Hover is derived from current geometry, including after layout changes
    ## beneath a stationary pointer. Updating it never remeasures the widget tree.
    mutating func update_hover():
        for entry in self.entries[..<self.count]:
            let box = entry.box.value()
            box.hovered = false
            box.pointer_within = false
            box.pointer = Point(self.pointer_x - box.rectangle.x, self.pointer_y - box.rectangle.y)
        if not self.pointer_present:
            return
        var hovered: usize? = none
        let popup = self.popup_index()
        if let active = popup:
            if not inside(self.entries[active].box.value().clipping, self.pointer_x, self.pointer_y):
                hovered = self.menu_at(active, self.pointer_x, self.pointer_y)
        if hovered == none:
            var index = self.count
            while index > 0:
                index -= 1
                let box = self.entries[index].box.value()
                if (popup == none or in_popup(self.entries, index)) and path_enabled(self.entries, index) and not box.hover_transparent and inside(box.clipping, self.pointer_x, self.pointer_y):
                    hovered = index
                    break
        let index = hovered else return
        self.entries[index].box.value().hovered = true
        var ancestor = (i64)index
        while ancestor >= 0:
            self.entries[(usize)ancestor].box.value().pointer_within = true
            ancestor = self.entries[(usize)ancestor].parent

    pub func has_popup() -> bool:
        return self.popup_index() != none

    pub func wants_text_input() -> bool:
        let index = self.find(self.focus) else return false
        return self.entries[index].box.value().accepts_text

    pub func cursor() -> input.Cursor!:
        if not self.pointer_present and self.capture == 0: return input.Cursor.arrow
        var target = self.capture
        if target == 0:
            if let popup = self.popup_index():
                if let menu = self.menu_at(popup, self.pointer_x, self.pointer_y):
                    target = self.entries[menu].box.value().identifier
            if target == 0: target = self.hit(self.pointer_x, self.pointer_y)
        let index = self.find(target) else return input.Cursor.arrow
        if not path_enabled(self.entries, index): return input.Cursor.arrow
        let box = self.entries[index].box.value()
        if let source = box.cursor_source:
            try source.enter()
            defer source.leave()
            let started = epoch()
            let cursor = source.value().cursor(Point(self.pointer_x - box.rectangle.x, self.pointer_y - box.rectangle.y), self.capture == target)
            if epoch() != started: error(result.busy, "a cursor query changed the widget tree")
            return cursor
        return box.pointer_cursor

    func find(identifier: u64) -> usize?:
        if identifier == 0:
            return none
        var index: usize = 0
        while index < self.count:
            if self.entries[index].box.value().identifier == identifier:
                return index
            index += 1
        return none

    func hit(x: f64, y: f64) -> u64:
        let modal = self.has_popup()
        var index = self.count
        while index > 0:
            index -= 1
            let box = self.entries[index].box.value()
            if (not modal or in_popup(self.entries, index)) and path_enabled(self.entries, index) and box.accepts_pointer and inside(box.clipping, x, y):
                return box.identifier
        return 0

    func send(index: usize, event: Event) -> interop.Outcome[unit]:
        let widget = self.entries[index].widget
        widget.enter() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer widget.leave()
        var native = widget.value()
        let delivered = native.event(event)
        return delivered

    func cancel(identifier: u64) -> interop.Outcome[unit]:
        if let index = self.find(identifier):
            let cancelled = self.send(index, Event(cancelled = true))
            if not cancelled.is_success():
                return cancelled
            cancelled.release()
        return result.success[unit](())

    ## Apply after the next arrangement, including children replaced during an
    ## input callback. Detached or disabled targets cannot acquire focus.
    pub mutating func focus_layout(target: interop.Reference[Layout]):
        self.requested_focus = target.value().identifier
        target.value().invalidate()

    mutating func set_focus(identifier: u64):
        self.focus = identifier
        for entry in self.entries[..<self.count]:
            entry.box.value().focused = entry.box.value().identifier == identifier
        mark_focus(self.entries, self.count, identifier, self.return_focus)
        revision = revision +? 1 else trap("UI revision exhausted")

    mutating func advance_focus(backwards: bool):
        if self.count == 0:
            return
        var index = self.find(self.focus) else (0 if backwards else self.count - 1)
        var visited: usize = 0
        while visited < self.count:
            index = (self.count - 1 if index == 0 else index - 1) if backwards else (index + 1) % self.count
            let box = self.entries[index].box.value()
            if path_enabled(self.entries, index) and box.accepts_focus and box.clipping.width > 0.0 and box.clipping.height > 0.0:
                self.set_focus(box.identifier)
                return
            visited += 1
        self.set_focus(0)

    pub mutating func close():
        for entry in self.entries[..<self.count]:
            # Cycle collection can finalize a layout before its application.
            # Closed layouts already released their state; only detach live ones.
            if not entry.box.is_closed():
                let box = entry.box.value()
                box.application = 0
                box.focused = false
                box.focus_within = false
                box.hovered = false
                box.pointer_within = false
        release_entries(self.entries, self.count)
        self.count = 0
        var empty: Entry[]
        self.entries = empty
        self.root.release()

    pub func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.root.trace(visit, context)
        for entry in self.entries[..<self.count]:
            entry.widget.trace(visit, context)
            entry.box.trace(visit, context)

func mark_focus(entries: Entry[], count: usize, focus: u64, return_focus: u64):
    for entry in entries[..<count]:
        entry.box.value().focus_within = false
    for identifier in [focus, return_focus]:
        if let index = find_entry(entries, count, identifier):
            var ancestor = (i64)index
            while ancestor >= 0:
                entries[(usize)ancestor].box.value().focus_within = true
                ancestor = entries[(usize)ancestor].parent

func release_entries(entries: Entry[], count: usize):
    for entry in entries[..<count]:
        entry.widget.release()
        entry.box.release()
    if entries.length > 0:
        free(entries) in memory.heap

func path_enabled(entries: const Entry[], index: usize) -> bool:
    var cursor = (i64)index
    while cursor >= 0:
        let entry = &entries[(usize)cursor]
        if not entry.box.value().active:
            return false
        cursor = entry.parent
    return true

func eligible(entries: const Entry[], count: usize, identifier: u64, focus: bool) -> bool:
    var index: usize = 0
    while index < count:
        let box = entries[index].box.value()
        if box.identifier == identifier:
            return path_enabled(entries, index) and (box.accepts_focus if focus else box.accepts_pointer) and box.clipping.width > 0.0 and box.clipping.height > 0.0
        index += 1
    return false

func gather(widget: interop.Interface[Widget], entries: Entry[], count: usize*, parent: i64,
            depth: usize, application: u64) -> !:
    if depth >= 64 or *count >= entries.length:
        error(result.limit, "a widget tree supports at most 1024 widgets and 64 levels")
    let box = try widget_layout(widget)
    errdefer box.release()
    let state = try box.get()
    if not state.visible:
        if parent == -1:
            error(result.invalid, "an application root must be visible")
        box.release()
        return
    if state.application != 0 and state.application != application:
        error(result.busy, "a widget already belongs to another application")
    if parent == -1 and state.parent != 0:
        error(result.busy, "an application root already has a parent")
    for previous in entries[..<*count]:
        if previous.box.value().identifier == state.identifier:
            error(result.invalid, "widgets must return distinct stable layouts")
    let index = *count
    entries[index] = Entry(widget.clone(), box.clone(), parent, 0)
    *count += 1
    let length = state.child_count()
    var child_index: i64 = 0
    while child_index < length:
        let child = try state.child(child_index)
        defer child.release()
        if state.split != none:
            let child_box = try widget_layout(child)
            defer child_box.release()
            if not child_box.value().visible or child_box.value().popup:
                error(result.invalid, "split panes and dividers must be visible ordinary children")
        try gather(child, entries, count, (i64)index, depth + 1, application)
        child_index += 1
    entries[index].end = *count
    box.release()

func inside(rectangle: Rect, x: f64, y: f64) -> bool:
    return x >= rectangle.x and y >= rectangle.y and x < rectangle.x + rectangle.width and y < rectangle.y + rectangle.height

func intersection(a: Rect, b: Rect) -> Rect:
    let x = math.max(a.x, b.x)
    let y = math.max(a.y, b.y)
    return Rect(x, y, math.max(0.0, math.min(a.x + a.width, b.x + b.width) - x),
                math.max(0.0, math.min(a.y + a.height, b.y + b.height) - y))

func along(size: Size, horizontal: bool) -> f64:
    return size.width if horizontal else size.height

## One exponential step of `current` toward `target`; called each frame while a popup
## animates, so the motion is fast at first and eases in as it approaches its place.
func ease_rect(current: Rect, target: Rect, factor: f64) -> Rect:
    return Rect(current.x + (target.x - current.x) * factor,
        current.y + (target.y - current.y) * factor,
        current.width + (target.width - current.width) * factor,
        current.height + (target.height - current.height) * factor)

## Within half a pixel on every side, so the ease can snap to the target and stop.
func settled(a: Rect, b: Rect) -> bool:
    return math.abs(a.x - b.x) < 0.5 and math.abs(a.y - b.y) < 0.5 and math.abs(a.width - b.width) < 0.5 and math.abs(a.height - b.height) < 0.5

func place(entries: Entry[], index: usize, bounds: Rect, clip: Rect) -> !:
    let box = entries[index].box.value()
    box.rectangle = bounds
    box.clipping = intersection(bounds, clip)
    let horizontal = box.axis == Axis.horizontal
    let inner = Rect(bounds.x + box.padding, bounds.y + box.padding,
        math.max(0.0, bounds.width - box.padding * 2.0), math.max(0.0, bounds.height - box.padding * 2.0))
    # A child may retain its minimum size in a smaller window. Clip it to the
    # content area so it cannot paint or hit-test over its parent's frame.
    let content_clip = intersection(box.clipping, inner)
    if let fraction = box.split:
        try place_split(entries, index, inner, content_clip, fraction)
        return
    if let arrangement = box.arrangement:
        try place_custom(entries, index, inner, content_clip, arrangement)
        return
    var child = index + 1
    var total: f64 = 0.0
    var length: usize = 0
    while child < entries[index].end:
        let item = entries[child].box.value()
        if item.popup:
            child = entries[child].end
            continue
        item.rectangle = Rect(width = item.measured.width, height = item.measured.height)
        total += along(item.measured, horizontal)
        length += 1
        child = entries[child].end
    let gaps = (f64)(length - 1) * box.spacing if length > 0 else 0.0
    let available = math.max(0.0, (inner.width if horizontal else inner.height) - gaps)
    var remaining = available - total
    # Weighted water filling respects per-child maxima. Shrinking distributes
    # according to available capacity rather than driving any child below minimum.
    var pass: usize = 0
    while box.axis != Axis.overlay and math.abs(remaining) > 0.000001 and pass <= length:
        var weight: f64 = 0.0
        child = index + 1
        while child < entries[index].end:
            let item = entries[child].box.value()
            if item.popup:
                child = entries[child].end
                continue
            let current = item.rectangle.width if horizontal else item.rectangle.height
            if remaining > 0.0 and current < along(item.maximum, horizontal):
                weight += along(item.growth, horizontal)
            elif remaining < 0.0:
                weight += math.max(0.0, current - along(item.minimum, horizontal)) * along(item.shrink, horizontal)
            child = entries[child].end
        if weight <= 0.0:
            break
        var changed: f64 = 0.0
        child = index + 1
        while child < entries[index].end:
            let item = entries[child].box.value()
            if item.popup:
                child = entries[child].end
                continue
            let current = item.rectangle.width if horizontal else item.rectangle.height
            let capacity = along(item.maximum, horizontal) - current if remaining > 0.0 else current - along(item.minimum, horizontal)
            let share = along(item.growth, horizontal) if remaining > 0.0 else math.max(0.0, capacity) * along(item.shrink, horizontal)
            let delta = math.min(math.max(0.0, capacity), math.abs(remaining) * share / weight) * (1.0 if remaining > 0.0 else -1.0)
            if horizontal:
                item.rectangle.width += delta
            else:
                item.rectangle.height += delta
            changed += delta
            child = entries[child].end
        remaining -= changed
        pass += 1
    var cursor = inner.x if horizontal else inner.y
    child = index + 1
    while child < entries[index].end:
        let item = entries[child].box.value()
        if item.popup:
            child = entries[child].end
            continue
        var rectangle = item.rectangle
        if box.axis == Axis.overlay:
            rectangle = Rect(inner.x, inner.y, math.clamp(inner.width, item.minimum.width, item.maximum.width),
                             math.clamp(inner.height, item.minimum.height, item.maximum.height))
        else:
            let cross = inner.height if horizontal else inner.width
            let desired = rectangle.height if horizontal else rectangle.width
            let minimum = item.minimum.height if horizontal else item.minimum.width
            let maximum = item.maximum.height if horizontal else item.maximum.width
            let placed = math.clamp(cross if box.alignment == Alignment.stretch else math.min(cross, desired), minimum, maximum)
            let spare = math.max(0.0, cross - placed)
            let offset = spare * 0.5 if box.alignment == Alignment.center else (spare if box.alignment == Alignment.end else 0.0)
            if horizontal:
                rectangle.x = cursor
                rectangle.y = inner.y + offset
                rectangle.height = placed
                cursor += rectangle.width + box.spacing
            else:
                rectangle.x = inner.x + offset
                rectangle.y = cursor
                rectangle.width = placed
                cursor += rectangle.height + box.spacing
        try place(entries, child, rectangle, content_clip)
        child = entries[child].end

func discard_replacement(entries: Entry[], count: usize*, committed: bool*):
    if not *committed:
        release_entries(entries, *count)

## Base callers can construct storage before adopting it into an interop owner.
## Check before touching the shared identity/revision state in either path.
func require_main_thread() -> !:
    if not thread.is_main():
        error(interop.wrong_thread, "UI layout requires the main thread")

func find_entry(entries: const Entry[], count: usize, identifier: u64) -> usize?:
    for index in 0..<count:
        if entries[index].box.value().identifier == identifier:
            return index
    return none

func in_popup(entries: const Entry[], index: usize) -> bool:
    var cursor = (i64)index
    while cursor >= 0:
        if entries[(usize)cursor].box.value().popup:
            return true
        cursor = entries[(usize)cursor].parent
    return false

func place_split(entries: Entry[], index: usize, bounds: Rect, clip: Rect, fraction: f64) -> !:
    let first = index + 1
    if first >= entries[index].end:
        return
    let divider = entries[first].end
    if divider >= entries[index].end:
        return
    let second = entries[divider].end
    if second >= entries[index].end:
        return
    let horizontal = entries[index].box.value().axis == Axis.horizontal
    let leading = entries[first].box.value()
    let trailing = entries[second].box.value()
    let handle = entries[divider].box.value()
    let gap = along(handle.measured, horizontal)
    let available = math.max(0.0, (bounds.width if horizontal else bounds.height) - gap)
    let sizes = splitting.distribute(available, fraction, along(leading.minimum, horizontal),
        along(leading.maximum, horizontal), along(trailing.minimum, horizontal), along(trailing.maximum, horizontal))
    if horizontal:
        try place(entries, first, Rect(bounds.x, bounds.y, sizes.first, math.clamp(bounds.height, leading.minimum.height, leading.maximum.height)), clip)
        try place(entries, divider, Rect(bounds.x + sizes.first, bounds.y, gap, bounds.height), clip)
        try place(entries, second, Rect(bounds.x + sizes.first + gap, bounds.y, sizes.second, math.clamp(bounds.height, trailing.minimum.height, trailing.maximum.height)), clip)
    else:
        try place(entries, first, Rect(bounds.x, bounds.y, math.clamp(bounds.width, leading.minimum.width, leading.maximum.width), sizes.first), clip)
        try place(entries, divider, Rect(bounds.x, bounds.y + sizes.first, bounds.width, gap), clip)
        try place(entries, second, Rect(bounds.x, bounds.y + sizes.first + gap, math.clamp(bounds.width, trailing.minimum.width, trailing.maximum.width), sizes.second), clip)

func place_custom(entries: Entry[], index: usize, bounds: Rect, clip: Rect, arrangement: interop.Interface[Arrangement]) -> !:
    # Validate the complete direct-child plan before applying any rectangle.
    # Stable child identities let policies retain geometry across tab visibility.
    var rectangles: Rect[1024]
    var count: usize = 0
    var child = index + 1
    let started = epoch()
    try arrangement.enter()
    defer arrangement.leave()
    while child < entries[index].end:
        let item = entries[child].box.value()
        if not item.popup:
            let placed = arrangement.value().place((i64)item.identifier, Size(bounds.width, bounds.height))
            defer placed.release()
            let rectangle = try placed.get()
            if not math.is_finite(rectangle.x) or not math.is_finite(rectangle.y):
                error(result.invalid, "custom placement coordinates must be finite")
            try extent(rectangle.width)
            try extent(rectangle.height)
            rectangles[count] = rectangle
            count += 1
        child = entries[child].end
    if epoch() != started:
        error(result.busy, "a custom arrangement changed the widget tree")
    count = 0
    child = index + 1
    while child < entries[index].end:
        if not entries[child].box.value().popup:
            let rectangle = rectangles[count]
            try place(entries, child, Rect(bounds.x + rectangle.x, bounds.y + rectangle.y, rectangle.width, rectangle.height), clip)
            count += 1
        child = entries[child].end
