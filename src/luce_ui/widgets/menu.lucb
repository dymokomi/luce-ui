## A menu composes a compact trigger and a popup action list. Layout owns popup
## placement, clipping, modal dispatch and focus restoration; this module owns
## only menu selection and command presentation.
import gpu
import input
import interop
import math
import memory
import ownership
import luce_ui.layout as layout
import luce_ui.result as result
from luce_ui.layout import Widget, Layout, Size, Constraints, Event
from luce_ui.font import Font, selected_font
from luce_ui.action import Action, Actions
from luce_ui.painter import Painter

struct MenuPopup: Widget:
    let box: interop.Reference[Layout]
    let font: interop.Reference[Font]
    var actions: Actions
    var selected: i64
    var first: i64
    var pressed: i64

    pub func init(actions: const interop.Reference[Action][], font: interop.Reference[Font]) -> !:
        if actions.length == 0:
            error(result.invalid, "a menu needs at least one action")
        var copied = Actions()
        errdefer copied.close()
        try copied.set(actions)
        let box = try layout.make_layout()
        errdefer box.release()
        try box.value().set_shrink(vertical = 0.0)
        box.value().set_focusable(true)
        box.value().set_popup(true)
        box.value().set_visible(false)
        self.box = box
        self.font = font.clone()
        self.actions = copied
        self.selected = -1
        self.first = 0
        self.pressed = -1

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub mutating func open():
        self.selected = -1
        self.first = 0
        self.pressed = -1
        self.move(1)
        self.box.value().set_visible(true)

    func row_height() -> f64:
        return self.box.value().theme().row_height(self.font)

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        var width: f64 = 0.0
        for action in self.actions.values():
            let text = action.value().text()
            defer text.release()
            let measured = self.font.value().measure(text.value) catch failure:
                return result.failure[Size](failure.code, failure.message)
            width = math.max(width, measured)
        return result.success[Size](Size(width + self.box.value().theme().inset(self.font) * 4.0,
            self.row_height() * (f64)self.actions.values().length))

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        self.paint(target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    func paint(target: interop.View[gpu.RenderTarget]) -> !:
        var painter = try Painter(target)
        defer painter.close()
        let size = try target.get().size()
        let theme = self.box.value().theme()
        try painter.rectangle(gpu.Rect(width = size.width, height = size.height), theme.panel)
        var index = self.first
        while index < (i64)self.actions.values().length:
            let y = (f64)(index - self.first) * self.row_height()
            if y >= size.height:
                break
            let action = self.actions.values()[(usize)index]
            if index == self.selected:
                try painter.rectangle(gpu.Rect(y = y, width = size.width, height = self.row_height()), theme.selection)
            let caption = action.value().text()
            defer caption.release()
            try painter.text(caption.value, theme.inset(self.font), y + (self.row_height() - self.font.value().height()) * 0.5,
                theme.foreground if action.value().is_enabled() else theme.muted, self.font)
            index += 1
        try painter.rectangle(gpu.Rect(width = size.width, height = 1.0), theme.border)
        try painter.rectangle(gpu.Rect(y = math.max(0.0, size.height - 1.0), width = size.width, height = 1.0), theme.border)

    mutating func move(direction: i64):
        let count = (i64)self.actions.values().length
        if count == 0:
            return
        var index = self.selected
        for visited in 0..<count:
            index = (index + direction + count) % count
            if self.actions.values()[(usize)index].value().is_enabled():
                self.selected = index
                let rows = (i64)math.max(1.0, self.box.value().bounds().height / self.row_height())
                if index < self.first:
                    self.first = index
                elif index >= self.first + rows:
                    self.first = index - rows + 1
                self.box.value().invalidate()
                return

    mutating func activate() -> interop.Outcome[unit]:
        if self.selected < 0:
            return result.success[unit](())
        let action = self.actions.values()[(usize)self.selected].clone()
        defer action.release()
        if not action.value().is_enabled():
            return result.success[unit](())
        # Close before invoking application code, including callbacks which
        # replace the containing view or fail while saving a document.
        self.box.value().set_visible(false)
        self.pressed = -1
        return action.value().trigger()

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        if event.cancelled:
            self.box.value().set_visible(false)
            self.pressed = -1
        elif event.kind == input.EventKind.key_down:
            if event.key == input.Key.escape:
                self.box.value().set_visible(false)
            elif event.key == input.Key.down or (event.key == input.Key.tab and not event.shift):
                self.move(1)
            elif event.key == input.Key.up or (event.key == input.Key.tab and event.shift):
                self.move(-1)
            elif (event.key == input.Key.enter or event.key == input.Key.space) and not event.repeated:
                return self.activate()
        elif event.kind == input.EventKind.scroll:
            self.move(1 if event.scroll_y < 0.0 else -1)
        elif event.kind == input.EventKind.pointer_moved or event.kind == input.EventKind.pointer_down:
            let index = self.first + (i64)(event.y / self.row_height())
            if event.inside and index >= 0 and index < (i64)self.actions.values().length:
                self.selected = index
                if event.kind == input.EventKind.pointer_down and event.button == 0:
                    self.pressed = index
                self.box.value().invalidate()
        elif event.kind == input.EventKind.pointer_up and event.button == 0:
            let index = self.first + (i64)(event.y / self.row_height())
            let activate = event.inside and self.pressed >= 0 and index == self.pressed
            self.pressed = -1
            if activate:
                return self.activate()
        return result.success[unit](())

    pub mutating func close():
        self.actions.close()
        self.font.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.actions.trace(visit, context)
        self.font.trace(visit, context)
        self.box.trace(visit, context)

let popup_type: interop.Type[MenuPopup] = interop.Type[MenuPopup]("Menu popup", MenuPopup.close, MenuPopup.trace, closeable = true, main_thread = true)

pub struct Menu: Widget:
    let box: interop.Reference[Layout]
    let caption: interop.Owned[str]
    let font: interop.Reference[Font]
    let popup: interop.Reference[MenuPopup]
    var pressed: bool

    pub func init(text: str, actions: const interop.Reference[Action][], font: interop.Reference[Font]? = none) -> !:
        let selected = try selected_font(font)
        errdefer selected.release()
        discard(try selected.value().measure(text))
        let caption = try interop.copy_text(text)
        errdefer caption.release()
        let box = try layout.make_layout()
        errdefer box.release()
        try box.value().set_shrink(vertical = 0.0)
        box.value().set_focusable(true)
        let popup = try interop.Reference[MenuPopup].adopt(new MenuPopup(actions, selected) in memory.heap, popup_type, memory.heap)
        errdefer popup.release()
        let widget = popup.as_interface[Widget](popup.value())
        defer widget.release()
        try box.value().set_children([widget])
        self.box = box
        self.caption = caption
        self.font = selected
        self.popup = popup
        self.pressed = false

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub mutating func open():
        self.popup.value().open()

    pub func is_open() -> bool:
        return self.popup.value().box.value().is_visible()

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        let width = self.font.value().measure(self.caption.value) catch failure:
            return result.failure[Size](failure.code, failure.message)
        let theme = self.box.value().theme()
        return result.success[Size](Size(width + theme.inset(self.font) * 2.0, theme.row_height(self.font)))

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        self.paint(target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    func paint(target: interop.View[gpu.RenderTarget]) -> !:
        var painter = try Painter(target)
        defer painter.close()
        let size = try target.get().size()
        let theme = self.box.value().theme()
        if self.is_open() or self.box.value().is_focused():
            try painter.rectangle(gpu.Rect(width = size.width, height = size.height), theme.selection)
        try painter.text(self.caption.value, theme.inset(self.font), (size.height - self.font.value().height()) * 0.5, theme.foreground, self.font)

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        if event.cancelled:
            self.pressed = false
        elif event.kind == input.EventKind.pointer_down and event.button == 0 and event.inside:
            self.pressed = true
        elif event.kind == input.EventKind.pointer_up and event.button == 0:
            let activate = self.pressed and event.inside
            self.pressed = false
            if activate:
                self.open()
        elif event.kind == input.EventKind.key_down and not event.repeated and (event.key == input.Key.enter or event.key == input.Key.space or event.key == input.Key.down):
            self.open()
        return result.success[unit](())

    pub mutating func close():
        self.popup.release()
        self.font.release()
        self.caption.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.popup.trace(visit, context)
        self.font.trace(visit, context)
        self.caption.trace(visit, context)
        self.box.trace(visit, context)

pub let menu_type: interop.Type[Menu] = interop.Type[Menu]("Menu", Menu.close, Menu.trace, closeable = true, main_thread = true)
