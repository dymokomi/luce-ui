## The Toolbar widget.
import gpu
import interop
import math
import ownership
import luce_ui.layout as layout
import luce_ui.result as result
from luce_ui.layout import Widget, Layout, Size, Constraints, Event
from luce_ui.painter import Painter
from luce_ui.font import Font, selected_font

## A horizontal bar of controls on the panel surface with a one-point border
## beneath, at least one control row tall, its children centered vertically.
pub struct Toolbar: Widget:
    let box: interop.Reference[Layout]
    let font: interop.Reference[Font]

    ## Children keep their own intrinsic widths; Spacer consumes remaining room.
    ## No outer padding is added to the shared one-line control height.
    pub func init(children: const interop.Interface[Widget][], font: interop.Reference[Font]? = none) -> !:
        let selected = try selected_font(font)
        errdefer selected.release()
        let box = try layout.make_layout(layout.Axis.horizontal, 0.0, 0.0, layout.Alignment.center)
        errdefer box.release()
        try box.value().set_shrink(vertical = 0.0)
        try box.value().set_children(children)
        self.box = box
        self.font = selected

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    ## Replace the bar's controls.
    pub mutating func set_children(children: const interop.Interface[Widget][]) -> !:
        try self.box.value().set_children(children)

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        let size = self.box.value().content_size(available) catch failure:
            return result.failure[Size](failure.code, failure.message)
        return result.success[Size](Size(size.width, math.max(size.height, self.box.value().theme().row_height(self.font))))

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        self.paint(target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    func paint(target: interop.View[gpu.RenderTarget]) -> !:
        var painter = try Painter(target)
        defer painter.close()
        let size = try target.get().size()
        let theme = self.box.value().theme()
        try painter.rectangle(gpu.Rect(width = size.width, height = size.height), theme.panel)
        try painter.rectangle(gpu.Rect(y = math.max(0.0, size.height - 1.0), width = size.width, height = 1.0), theme.border)

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        return result.success[unit](())

    pub mutating func close():
        self.font.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.font.trace(visit, context)
        self.box.trace(visit, context)

pub let toolbar_type: interop.Type[Toolbar] = interop.Type[Toolbar]("Toolbar", Toolbar.close, Toolbar.trace, closeable = true, main_thread = true)
