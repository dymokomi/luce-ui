## Dynamic workspace composition. Applications supply panels and respond to add
## and close requests; the framework owns all geometry and docking interaction.
import gpu
import interop
import memory
import math
import ownership
import luce_ui.layout as layout
import luce_ui.result as result
import luce_ui.docking.chrome as chrome
from luce_ui.layout import Widget, Layout, Size, Constraints, Event
from luce_ui.arrangement import Arrangement
from luce_ui.cursor import CursorSource
from luce_ui.font import Font, selected_font
from luce_ui.command import Command, command_type
from luce_ui.widgets.panel import Panel
from luce_ui.widgets.action_popup import ActionPopup, action_popup_type
from luce_ui.docking.state import State, DockRequest, state_type
from luce_ui.docking.model import DockPosition

struct Overlay: Widget:
    let box: interop.Reference[Layout]
    let state: interop.WeakReference[State]

    pub func init(state: interop.Reference[State]) -> !:
        let box = try layout.make_layout()
        box.value().set_hover_transparent(true)
        self.box = box
        self.state = interop.WeakReference[State](state)

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        return result.success[Size](Size())

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        let state = self.state.get() else return result.success[unit](())
        defer state.release()
        chrome.preview(state.value(), target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        return result.success[unit](())

    pub mutating func close():
        self.state.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.box.trace(visit, context)

let overlay_type: interop.Type[Overlay] = interop.Type[Overlay]("Dock preview", Overlay.close, Overlay.trace, closeable = true, main_thread = true)

pub struct DStack: Widget:
    let box: interop.Reference[Layout]
    let state: interop.Reference[State]

    pub func init(panels: const interop.Reference[Panel][], font: interop.Reference[Font]? = none) -> !:
        let selected = try selected_font(font)
        defer selected.release()
        let box = try layout.make_layout()
        errdefer box.release()
        box.value().set_focusable(true)
        try box.value().set_flex()
        let state = try interop.Reference[State].adopt(new State(box, selected) in memory.heap, state_type, memory.heap)
        errdefer state.release()
        errdefer state.close()
        let arrangement = state.as_interface[Arrangement](state.value())
        defer arrangement.release()
        try box.value().set_arrangement(arrangement)
        let cursor = state.as_interface[CursorSource](state.value())
        defer cursor.release()
        try box.value().set_cursor_source(cursor)
        let overlay = try interop.Reference[Overlay].adopt(new Overlay(state) in memory.heap, overlay_type, memory.heap)
        defer overlay.release()
        let overlay_widget = overlay.as_interface[Widget](overlay.value())
        defer overlay_widget.release()
        let tab = try interop.Reference[Command].adopt(new Command("Add Tab") in memory.heap, command_type, memory.heap)
        defer tab.release()
        let vertical = try interop.Reference[Command].adopt(new Command("Split Vertical") in memory.heap, command_type, memory.heap)
        defer vertical.release()
        let horizontal = try interop.Reference[Command].adopt(new Command("Split Horizontal") in memory.heap, command_type, memory.heap)
        defer horizontal.release()
        let add_tab = try interop.Callback[unit, unit].bind_mutating(state, State.add_tab)
        defer add_tab.release()
        state.value().connections[0] = try tab.value().on_trigger(add_tab)
        let split_vertical = try interop.Callback[unit, unit].bind_mutating(state, State.split_vertical)
        defer split_vertical.release()
        state.value().connections[1] = try vertical.value().on_trigger(split_vertical)
        let split_horizontal = try interop.Callback[unit, unit].bind_mutating(state, State.split_horizontal)
        defer split_horizontal.release()
        state.value().connections[2] = try horizontal.value().on_trigger(split_horizontal)
        let popup = try interop.Reference[ActionPopup].adopt(new ActionPopup([vertical, horizontal, tab], selected) in memory.heap, action_popup_type, memory.heap)
        defer popup.release()
        try state.value().install(overlay_widget, popup)
        for panel in panels:
            try state.value().add(panel, none, DockPosition.tab)
        self.box = box
        self.state = state

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub mutating func add(panel: interop.Reference[Panel], relative_to: interop.Reference[Panel]? = none, position: DockPosition = DockPosition.tab) -> !:
        try self.state.value().add(panel, relative_to, position)

    pub mutating func move(panel: interop.Reference[Panel], relative_to: interop.Reference[Panel], position: DockPosition = DockPosition.tab) -> !:
        try self.state.value().move(panel, relative_to, position)

    pub mutating func remove(panel: interop.Reference[Panel]) -> !:
        try self.state.value().remove(panel)

    pub mutating func select(panel: interop.Reference[Panel]) -> !:
        self.state.value().cancel()
        try self.state.value().select(try self.state.value().index(panel))

    ## Cycle visible groups in reading order; selection reveals that group's
    ## active tab and deferred focus finds its first keyboard-capable control.
    pub mutating func focus_next(backwards: bool = false) -> !:
        let state = self.state.value()
        state.cancel()
        if state.model.root == 0: return
        let geometry = state.geometry(state.size())
        let current = state.model.tabs[state.active()].group
        var next: usize = 0
        var wrap: usize = 0
        for group in 1..<state.model.nodes.length:
            if not state.model.nodes[group].used or state.model.nodes[group].first != 0: continue
            let bounds = geometry.panes[group]
            if wrap == 0 or (earlier(bounds, geometry.panes[wrap]) != backwards): wrap = group
            let follows = earlier(bounds, geometry.panes[current]) if backwards else earlier(geometry.panes[current], bounds)
            if follows and (next == 0 or (earlier(bounds, geometry.panes[next]) != backwards)):
                next = group
        let chosen = next if next != 0 else wrap
        try state.select(state.model.nodes[chosen].selected)

    pub func active_panel() -> interop.Reference[Panel]?!:
        let index = self.state.value().active()
        return none if index == 0 else try self.state.value().panel(index)

    pub func panel_count() -> i64:
        return (i64)self.state.value().model.count()

    pub func group_count() -> i64:
        return (i64)self.state.value().model.group_count()

    pub func tab_count(panel: interop.Reference[Panel]) -> i64!:
        let index = try self.state.value().index(panel)
        return (i64)self.state.value().model.tab_count(self.state.value().model.tabs[index].group)

    pub func same_group(first: interop.Reference[Panel], second: interop.Reference[Panel]) -> bool!:
        let a = try self.state.value().index(first)
        let b = try self.state.value().index(second)
        return self.state.value().model.tabs[a].group == self.state.value().model.tabs[b].group

    pub func panel_bounds(panel: interop.Reference[Panel]) -> gpu.Rect!:
        let index = try self.state.value().index(panel)
        let geometry = self.state.value().geometry(self.state.value().size())
        let model = self.state.value().visible_model()
        return geometry.panes[model.tabs[index].group]

    pub func tab_bounds(panel: interop.Reference[Panel]) -> gpu.Rect!:
        return try self.state.value().tab_bounds(try self.state.value().index(panel))

    pub func add_bounds(panel: interop.Reference[Panel]) -> gpu.Rect!:
        let index = try self.state.value().index(panel)
        let model = self.state.value().visible_model()
        let group = model.tabs[index].group
        return gpu.Rect() if group == 0 else self.state.value().strip(group, try self.panel_bounds(panel)).add

    pub func drop_preview() -> gpu.Rect:
        return self.state.value().current_drop().preview

    pub func drag_bounds() -> gpu.Rect:
        return self.state.value().drag_bounds()

    pub mutating func set_fraction(panel: interop.Reference[Panel], fraction: f64) -> !:
        self.state.value().cancel()
        let index = try self.state.value().index(panel)
        let group = self.state.value().model.tabs[index].group
        let branch = self.state.value().model.nodes[group].parent
        if branch == 0 or not math.is_finite(fraction) or fraction < 0.0 or fraction > 1.0:
            error(result.invalid, "panel must have a split parent and a fraction in 0..1")
        self.state.value().model.nodes[branch].fraction = fraction
        self.box.value().invalidate()

    pub func on_select(callback: interop.Callback[interop.Reference[Panel], unit]) -> interop.Reference[interop.Connection]!:
        return try self.state.value().selected.connect(callback)

    pub func on_add(callback: interop.Callback[interop.Reference[DockRequest], unit]) -> interop.Reference[interop.Connection]!:
        return try self.state.value().added.connect(callback)

    pub func on_close(callback: interop.Callback[interop.Reference[Panel], unit]) -> interop.Reference[interop.Connection]!:
        return try self.state.value().closed.connect(callback)

    pub mutating func set_close_handler(callback: interop.Callback[interop.Reference[Panel], bool]):
        self.state.value().set_close_handler(callback)

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        return result.success[Size](Size(400.0, 300.0))

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        chrome.draw(self.state.value(), target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        self.state.value().handle(event) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    pub mutating func close():
        self.state.close()
        self.state.release()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.state.trace(visit, context)
        self.box.trace(visit, context)

pub let dstack_type: interop.Type[DStack] = interop.Type[DStack]("DStack", DStack.close, DStack.trace, closeable = true, main_thread = true)

func earlier(first: gpu.Rect, second: gpu.Rect) -> bool:
    return first.y < second.y or (first.y == second.y and first.x < second.x)
