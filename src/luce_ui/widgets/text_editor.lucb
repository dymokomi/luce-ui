import clipboard
import gpu
import input
import interop
import math
import memory
import ownership
import time
import utf8
import luce_ui.layout as layout
import luce_ui.result as result
import luce_ui.text.drawing as drawing
import luce_ui.text.editing as editing
from luce_ui.text.decorations import Decorations
from luce_ui.text.folding import FoldRange, Folding
from luce_ui.text.projection import Projection
from luce_ui.text.diff import LineDiff
from luce_ui.font import Font, selected_font
from luce_ui.layout import Widget, Layout, Size, Constraints, Event
from luce_ui.painter import Painter
from luce_ui.text.document import Document, TextChange
from luce_ui.text.style import Highlight, EditorTheme

## A reusable multiline editor. Its document owns text and history; the widget
## owns focus, selection gestures, scrolling, drawing and application signals.
pub struct TextEditor: Widget:
    let box: interop.Reference[Layout]
    var document: Document
    let changed: interop.Signal[unit]
    let read_only: bool
    let line_numbers: bool
    let font: interop.Reference[Font]
    let theme: EditorTheme?
    var highlights: Decorations
    var folds: Folding
    var projection: Projection
    var scroll_x: f64
    var scroll_y: f64
    var dragging: bool
    var dragging_scroll: bool
    var preferred_column: usize
    var vertical_move: bool
    var active_since: u64
    var last_click: u64
    var last_offset: usize
    var clicks: i64
    var ai_first: i64 = 0
    var ai_last: i64 = 0
    var wrap: bool
    var baseline: interop.Owned[str]?
    var diff: LineDiff
    var diff_version: i64

    pub func init(text: str = "", read_only: bool = false, line_numbers: bool = true,
                  font: interop.Reference[Font]? = none, theme: EditorTheme? = none, wrap: bool = false) -> !:
        var selected = try selected_font(font)
        errdefer selected.release()
        let box = try layout.make_layout()
        errdefer box.release()
        try box.value().set_limits(Size(120.0, 60.0), Size(16384.0, 16384.0))
        try box.value().set_flex()
        box.value().set_focusable(true)
        box.value().set_cursor(input.Cursor.text)
        box.value().set_text_input(not read_only, tabs = not read_only)
        let normalized = try editing.normalize_lines(text)
        defer normalized.release()
        var document = try Document(normalized.value)
        errdefer document.close()
        let changed = try interop.Signal[unit]()
        errdefer changed.release()
        let highlights = Decorations()
        var folds = Folding()
        var projection = Projection()
        try projection.refresh(&document, &folds)
        errdefer projection.close()
        self.box = box
        self.document = document
        self.changed = changed
        self.read_only = read_only
        self.line_numbers = line_numbers
        self.font = selected
        self.theme = theme
        self.highlights = highlights
        self.folds = folds
        self.projection = projection
        self.scroll_x = 0.0
        self.scroll_y = 0.0
        self.dragging = false
        self.dragging_scroll = false
        self.preferred_column = 0
        self.vertical_move = false
        self.active_since = time.now()
        self.last_click = 0
        self.last_offset = 0
        self.clicks = 0
        self.ai_first = 0
        self.ai_last = 0
        self.wrap = wrap
        self.baseline = none
        self.diff = LineDiff()
        self.diff_version = -1

    pub func layout() -> interop.Reference[Layout]:
        return self.box.clone()

    pub func text() -> interop.Owned[str]!:
        return try self.document.text()

    pub func selected_text() -> interop.Owned[str]!:
        return try self.document.text(self.document.first(), self.document.last())

    pub func has_selection() -> bool:
        return self.document.first() != self.document.last()

    pub func is_read_only() -> bool:
        return self.read_only

    pub func can_undo() -> bool:
        return not self.read_only and self.document.can_undo()

    pub func can_redo() -> bool:
        return not self.read_only and self.document.can_redo()

    pub mutating func select_all() -> !:
        try self.set_selection(0, self.length())

    pub func copy() -> !:
        if self.has_selection():
            let text = try self.selected_text()
            defer text.release()
            try clipboard.write_text(text.value)

    pub mutating func cut() -> interop.Outcome[unit]:
        if self.read_only or not self.has_selection():
            return result.success[unit](())
        self.copy() catch failure:
            return result.failure[unit](failure.code, failure.message)
        return self.insert("")

    pub mutating func paste() -> interop.Outcome[unit]:
        if self.read_only:
            return result.success[unit](())
        let text = clipboard.read_text() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer text.release()
        return self.insert(text.value)

    pub func version() -> i64:
        return (i64)self.document.version()

    pub func length() -> i64:
        return (i64)self.document.length()

    pub func caret() -> i64:
        return (i64)self.document.caret()

    pub func line() -> i64:
        return (i64)self.document.line_number(self.document.caret()) + 1

    pub func column() -> i64:
        return (i64)editing.column(&self.document, self.document.caret()) + 1

    ## The 1-based first and last lines the selection spans (equal when it is a caret).
    pub func selection_first_line() -> i64:
        return (i64)self.document.line_number(self.document.first()) + 1

    pub func selection_last_line() -> i64:
        return (i64)self.document.line_number(self.document.last()) + 1

    ## Mark the 1-based line range the AI is working on; its gutter shows 45° stripes.
    ## Pass 0, 0 (or call clear_ai_lines) to remove the marking.
    pub mutating func set_ai_lines(first: i64, last: i64):
        self.ai_first = first if first <= last else last
        self.ai_last = last if last >= first else first
        self.box.value().invalidate()

    pub mutating func clear_ai_lines():
        self.ai_first = 0
        self.ai_last = 0
        self.box.value().invalidate()

    pub func on_change(callback: interop.Callback[unit, unit]) -> interop.Reference[interop.Connection]!:
        return try self.changed.connect(callback)

    pub mutating func set_text(text: str) -> interop.Outcome[unit]:
        let normalized = editing.normalize_lines(text) catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer normalized.release()
        self.document.set_text(normalized.value) catch failure:
            return result.failure[unit](failure.code, failure.message)
        self.scroll_x = 0.0
        self.scroll_y = 0.0
        return self.notify_changed()

    pub mutating func set_selection(anchor: i64, caret: i64) -> !:
        if anchor < 0 or caret < 0:
            error(result.invalid, "selection offsets must be nonnegative")
        # A programmatic selection interrupts any in-progress multi-click gesture.
        self.clicks = 0
        try self.document.select((usize)anchor, (usize)caret)
        try self.reveal_caret()
        self.box.value().invalidate()

    ## Replace a complete decoration set, or publish a bounded analysis result.
    ## Stale results are ignored before validation and cannot recolor newer text.
    pub mutating func set_highlights(highlights: const Highlight[]) -> !:
        try self.highlights.replace(0, (i64)self.document.length(), highlights)
        self.box.value().invalidate()

    pub mutating func update_highlights(start: i64, end: i64, highlights: const Highlight[], version: i64) -> bool!:
        if version != self.version():
            return false
        if start < 0 or end < start or end > self.length():
            error(result.invalid, "highlight interval is outside the document")
        try self.highlights.replace(start, end, highlights)
        self.box.value().invalidate()
        return true

    pub func highlight_at(offset: i64) -> gpu.Color?:
        return self.highlights.color_at(offset)

    pub func change() -> TextChange:
        return self.document.last_change()

    pub func text_range(start: i64, end: i64) -> interop.Owned[str]!:
        if start < 0 or end < start or end > self.length():
            error(result.invalid, "text interval is outside the document")
        return try self.document.text((usize)start, (usize)end)

    pub func line_start(offset: i64) -> i64!:
        if offset < 0 or offset > self.length():
            error(result.invalid, "line offset is outside the document")
        return (i64)self.document.line_start((usize)offset)

    pub func line_end(offset: i64) -> i64!:
        if offset < 0 or offset > self.length():
            error(result.invalid, "line offset is outside the document")
        return (i64)self.document.line_end((usize)offset)

    pub mutating func insert(text: str) -> interop.Outcome[unit]:
        if self.read_only:
            return result.failure[unit](result.invalid, "the text editor is read only")
        let normalized = editing.normalize_lines(text) catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer normalized.release()
        let before = self.document.version()
        self.document.insert(normalized.value) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return self.notify_changed() if before != self.document.version() else result.success[unit](())

    pub mutating func undo() -> interop.Outcome[unit]:
        if self.read_only:
            return result.success[unit](())
        let changed = self.document.undo() catch failure:
            return result.failure[unit](failure.code, failure.message)
        return self.notify_changed() if changed else result.success[unit](())

    pub mutating func redo() -> interop.Outcome[unit]:
        if self.read_only:
            return result.success[unit](())
        let changed = self.document.redo() catch failure:
            return result.failure[unit](failure.code, failure.message)
        return self.notify_changed() if changed else result.success[unit](())

    ## Fold headers and endpoints are scalar offsets; user-facing line numbers
    ## are one-based, matching line(). Collapsing never edits source or history.
    pub mutating func set_folds(ranges: const FoldRange[], version: i64) -> bool!:
        if version != self.version():
            return false
        try self.folds.replace(ranges, &self.document)
        try self.finish_folding()
        return true

    pub mutating func set_folded(line: i64, collapsed: bool) -> bool!:
        try self.refresh_view()
        if line < 1 or line > (i64)self.projection.line_count():
            error(result.invalid, "fold line is outside the document")
        let changed = self.folds.set(self.projection.line((usize)(line - 1)).start, collapsed)
        if changed:
            try self.finish_folding()
        return changed

    pub mutating func toggle_fold(line: i64) -> bool!:
        return try self.set_folded(line, not self.is_folded(line))

    pub func is_folded(line: i64) -> bool:
        if line < 1 or line > (i64)self.projection.line_count():
            return false
        let index = self.folds.at(self.projection.line((usize)(line - 1)).start) else return false
        return self.folds.values()[index].collapsed

    pub mutating func fold_all() -> !:
        self.folds.set_all(true)
        try self.finish_folding()

    pub mutating func unfold_all() -> !:
        self.folds.set_all(false)
        try self.finish_folding()

    pub func visible_line_count() -> i64:
        return (i64)self.projection.visible_count()

    pub func wrapping() -> bool:
        return self.wrap

    ## Set the saved text to diff against for gutter change bars, or clear it. The
    ## bars update as the buffer diverges from this baseline; pass the current text
    ## (for example after a save) to clear them.
    pub mutating func set_baseline(text: str) -> !:
        let replacement = try interop.copy_text(text)
        if let previous = self.baseline:
            previous.release()
        self.baseline = replacement
        self.diff_version = -1
        self.box.value().invalidate()

    pub mutating func clear_baseline():
        if let previous = self.baseline:
            previous.release()
        self.baseline = none
        self.diff.clear()
        self.diff_version = -1
        self.box.value().invalidate()

    pub func has_changes() -> bool:
        return self.diff.present()

    ## Soft wrap long lines to the viewport width, or restore horizontal scrolling.
    ## The caret keeps its place and is revealed on its new visual row.
    pub mutating func set_wrap(enabled: bool) -> !:
        if self.wrap == enabled:
            return
        self.wrap = enabled
        self.scroll_x = 0.0
        try self.refresh_view()
        try self.reveal_caret()
        self.box.value().invalidate()

    pub func scroll_offset() -> Size:
        return Size(math.clamp(self.scroll_x, 0.0, self.maximum_scroll_x()), math.clamp(self.scroll_y, 0.0, self.maximum_scroll()))

    ## Columns per visual row when wrapping, or 0 to disable it. One column is
    ## reserved so the caret past the last glyph never sits under the scrollbar.
    func wrap_columns() -> usize:
        if not self.wrap:
            return 0
        let columns = (usize)(self.content_width() / self.font.value().advance())
        return columns if columns > 1 else 1

    mutating func refresh_view() -> !:
        try self.projection.refresh(&self.document, &self.folds, self.wrap_columns())
        try self.refresh_diff()
        self.clamp_scroll()

    ## Recompute change bars only when the text changed since the last diff.
    mutating func refresh_diff() -> !:
        if let baseline = self.baseline:
            if self.diff_version != (i64)self.document.version():
                let current = try self.document.text()
                defer current.release()
                try self.diff.compute(baseline.value, current.value, (i64)self.document.version())
                self.diff_version = (i64)self.document.version()

    mutating func finish_folding() -> !:
        try self.refresh_view()
        if self.projection.is_hidden(self.document.caret()):
            let row = self.projection.physical_row(self.projection.visual_row(self.document.caret()))
            let offset = self.projection.line(row).end
            try self.document.select(offset, offset)
        self.clamp_scroll()
        self.box.value().invalidate()

    pub func measure(available: Constraints) -> interop.Outcome[Size]:
        return result.success[Size](Size(640.0, 360.0))

    pub mutating func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        self.paint(target) catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    mutating func paint(target: interop.View[gpu.RenderTarget]) -> !:
        try self.refresh_view()
        var painter = try Painter(target)
        defer painter.close()
        let size = try target.get().size()
        var hovered_row: usize? = none
        let pointer = self.box.value().pointer_position()
        if self.box.value().contains_pointer() and pointer.x < self.gutter_width():
            hovered_row = (usize)((pointer.y + self.scroll_y) / self.font.value().line_height())
        try drawing.paint(&self.document, &painter, size.width, size.height, self.scroll_x, self.scroll_y,
            self.line_numbers, self.box.value().is_focused(), time.since(self.active_since) % 1000000000 < 600000000,
            self.font, (self.theme else self.box.value().theme().editor()), self.highlights.values(), &self.projection, &self.folds, &self.diff, hovered_row,
            (usize)self.ai_first, (usize)self.ai_last)

    pub mutating func event(event: Event) -> interop.Outcome[unit]:
        # Passive hover is derived by Layout and rendered without remeasuring
        # controls or rebuilding text projections for each pointer movement.
        if event.kind == input.EventKind.pointer_moved and not event.cancelled and not self.dragging and not self.dragging_scroll:
            return result.success[unit](())
        let before = self.document.version()
        self.handle(event) catch failure:
            return result.failure[unit](failure.code, failure.message)
        self.box.value().invalidate()
        if self.document.version() != before:
            return self.notify_changed()
        return result.success[unit](())

    mutating func handle(event: Event) -> !:
        try self.refresh_view()
        if event.cancelled:
            self.dragging = false
            self.dragging_scroll = false
            return
        if event.kind == input.EventKind.pointer_down and event.button == 1:
            let position = self.position_at(event.x, event.y)
            if position < self.document.first() or position >= self.document.last():
                try self.set_selection((i64)position, (i64)position)
            return
        if event.kind == input.EventKind.scroll:
            if not math.is_finite(event.scroll_x) or not math.is_finite(event.scroll_y):
                error(result.invalid, "scroll deltas must be finite")
            let x_scale = self.font.value().advance() * 3.0 if event.scroll_unit == input.ScrollUnit.lines else 1.0
            let y_scale = self.font.value().line_height() * 3.0 if event.scroll_unit == input.ScrollUnit.lines else 1.0
            self.scroll_y -= event.scroll_y * y_scale
            self.scroll_x -= event.scroll_x * x_scale
            self.clamp_scroll()
            return
        if event.kind == input.EventKind.pointer_down and event.button == 0:
            if self.folds.values().length > 0 and event.x >= self.gutter_width() - self.font.value().advance() * 2.0 and event.x < self.gutter_width():
                let visible = (usize)(math.max(0.0, event.y - drawing.vertical_padding(self.font) + self.scroll_y) / self.font.value().line_height())
                if visible < self.projection.visible_count():
                    discard(try self.toggle_fold((i64)self.projection.physical_row(visible) + 1))
                return
            self.dragging_scroll = event.x >= self.box.value().bounds().width - 10.0
            self.dragging = not self.dragging_scroll
            if self.dragging_scroll:
                self.scroll_to_pointer(event.y)
            else:
                let position = self.position_at(event.x, event.y)
                let now = time.now()
                self.clicks = self.clicks + 1 if now - self.last_click < 400000000 and position == self.last_offset and not event.shift else 1
                self.last_click = now
                self.last_offset = position
                if self.clicks >= 2:
                    try editing.select_word(&self.document, position)
                    self.dragging = false
                else:
                    try self.document.select(self.document.anchor() if event.shift else position, position)
                self.active_since = time.now()
            self.vertical_move = false
            return
        if event.kind == input.EventKind.pointer_moved:
            if self.dragging_scroll:
                self.scroll_to_pointer(event.y)
            elif self.dragging:
                if event.y < 0.0:
                    self.scroll_y = math.max(0.0, self.scroll_y - self.font.value().line_height())
                if event.y > self.box.value().bounds().height:
                    self.scroll_y = math.min(self.maximum_scroll(), self.scroll_y + self.font.value().line_height())
                try self.document.select(self.document.anchor(), self.position_at(event.x, event.y))
            return
        if event.kind == input.EventKind.pointer_up and event.button == 0:
            self.dragging = false
            self.dragging_scroll = false
            return
        if event.kind == input.EventKind.text_input and not self.read_only:
            var bytes: u8[4]
            let count = utf8.encode((u32)event.codepoint, bytes) else error(result.invalid, "text input is not a Unicode scalar")
            try self.document.insert((str)bytes[..<count])
            return
        if event.kind != input.EventKind.key_down:
            return
        try self.key(event)
        self.active_since = time.now()
        try self.reveal_caret()

    mutating func key(event: Event) -> !:
        let command = (event.control and not event.alt) or event.meta
        if command:
            if event.key == input.Key.a:
                try self.document.select(0, self.document.length())
                return
            if event.key == input.Key.c or (event.key == input.Key.x and not self.read_only):
                if self.document.first() != self.document.last():
                    let text = try self.selected_text()
                    defer text.release()
                    try clipboard.write_text(text.value)
                    if event.key == input.Key.x:
                        try self.document.insert("")
                return
            if event.key == input.Key.v and not self.read_only:
                let text = try clipboard.read_text()
                defer text.release()
                let normalized = try editing.normalize_lines(text.value)
                defer normalized.release()
                try self.document.insert(normalized.value)
                return
            if event.key == input.Key.z and not self.read_only:
                discard(try self.document.redo() if event.shift else try self.document.undo())
                return
            if event.key == input.Key.y and not self.read_only:
                discard(try self.document.redo())
                return
        let caret = self.document.caret()
        let extend = event.shift
        if event.key == input.Key.left:
            let next = self.document.line_start(caret) if event.meta else (editing.word_left(&self.document, caret) if command or event.alt else (caret - 1 if caret > 0 else 0))
            try editing.move(&self.document, self.document.first() if not extend and self.document.first() != self.document.last() else next, extend)
        elif event.key == input.Key.right:
            let next = self.document.line_end(caret) if event.meta else (editing.word_right(&self.document, caret) if command or event.alt else (caret + 1 if caret < self.document.length() else caret))
            try editing.move(&self.document, self.document.last() if not extend and self.document.first() != self.document.last() else next, extend)
        elif event.key == input.Key.home:
            try editing.move(&self.document, 0 if command else self.document.line_start(caret), extend)
        elif event.key == input.Key.end:
            try editing.move(&self.document, self.document.length() if command else self.document.line_end(caret), extend)
        elif event.key == input.Key.up or event.key == input.Key.down or event.key == input.Key.page_up or event.key == input.Key.page_down:
            if not self.vertical_move:
                let here = self.projection.row(self.projection.visual_row(caret))
                self.preferred_column = editing.column(&self.document, caret) - here.column
            let row = self.projection.visual_row(caret)
            let page = (usize)math.max(1.0, self.box.value().bounds().height / self.font.value().line_height() - 1.0)
            let step = page if event.key == input.Key.page_up or event.key == input.Key.page_down else 1
            let upwards = event.key == input.Key.up or event.key == input.Key.page_up
            let rows = self.projection.visible_count()
            let raw = row - step if upwards and row >= step else (0 if upwards else row + step)
            let target = self.projection.row(raw if raw < rows else (rows - 1 if rows > 0 else 0))
            var offset = editing.at_column(&self.document, target.physical, target.column + self.preferred_column)
            if offset > target.end:
                offset = target.end
            if offset < target.start:
                offset = target.start
            try editing.move(&self.document, offset, extend)
            self.vertical_move = true
            return
        elif not self.read_only:
            if event.key == input.Key.backspace or event.key == input.Key.delete:
                if self.document.first() == self.document.last():
                    for fold in self.folds.values():
                        if fold.collapsed and ((event.key == input.Key.delete and caret + 1 == fold.hidden) or (event.key == input.Key.backspace and caret == fold.end)):
                            discard(self.folds.set(fold.header, false))
                            try self.finish_folding()
                            return
                try editing.erase(&self.document, event.key == input.Key.backspace, command or event.alt)
            elif event.key == input.Key.enter and not command:
                try editing.newline(&self.document)
            elif event.key == input.Key.tab:
                try editing.indent(&self.document, event.shift)
        self.vertical_move = false

    func position_at(x: f64, y: f64) -> usize:
        let rows = self.projection.visible_count()
        let raw = (usize)(math.max(0.0, y - drawing.vertical_padding(self.font) + self.scroll_y) / self.font.value().line_height())
        let segment = self.projection.row(raw if raw < rows else (rows - 1 if rows > 0 else 0))
        let cells = (usize)(math.max(0.0, x - self.gutter_width() - self.font.value().advance() + self.scroll_x) / self.font.value().advance() + 0.5)
        var offset = editing.at_column(&self.document, segment.physical, segment.column + cells)
        if offset > segment.end:
            offset = segment.end
        if offset < segment.start:
            offset = segment.start
        return offset

    func maximum_scroll() -> f64:
        return math.max(0.0, (f64)self.projection.visible_count() * self.font.value().line_height() + drawing.vertical_padding(self.font) * 2.0 - self.box.value().bounds().height)

    mutating func scroll_to_pointer(y: f64):
        let height = self.box.value().bounds().height
        self.scroll_y = math.clamp(y / math.max(1.0, height), 0.0, 1.0) * self.maximum_scroll()

    func gutter_width() -> f64:
        return drawing.gutter_width(self.line_numbers, self.font, self.projection.line_count(), self.folds.values().length > 0)

    func content_width() -> f64:
        return math.max(1.0, self.box.value().bounds().width - self.gutter_width() - self.font.value().advance() - 8.0)

    func maximum_scroll_x() -> f64:
        if self.wrap:
            return 0.0
        return math.max(0.0, (f64)(self.projection.maximum_columns() + 1) * self.font.value().advance() - self.content_width())

    mutating func clamp_scroll():
        self.scroll_x = math.clamp(self.scroll_x, 0.0, self.maximum_scroll_x())
        self.scroll_y = math.clamp(self.scroll_y, 0.0, self.maximum_scroll())

    mutating func reveal_caret() -> !:
        self.folds.reveal(self.document.caret())
        try self.refresh_view()
        if self.projection.is_hidden(self.document.caret()):
            self.folds.reveal(self.document.caret(), include_end = true)
            try self.refresh_view()
        let bounds = self.box.value().bounds()
        let y = (f64)self.projection.visual_row(self.document.caret()) * self.font.value().line_height()
        let height = math.max(self.font.value().line_height(), bounds.height - drawing.vertical_padding(self.font) * 2.0)
        if y < self.scroll_y:
            self.scroll_y = y
        if y + self.font.value().line_height() > self.scroll_y + height:
            self.scroll_y = y + self.font.value().line_height() - height
        self.scroll_y = math.clamp(self.scroll_y, 0.0, self.maximum_scroll())
        if not self.wrap:
            let x = (f64)editing.column(&self.document, self.document.caret()) * self.font.value().advance()
            let width = self.content_width()
            if x < self.scroll_x:
                self.scroll_x = x
            if x + self.font.value().advance() > self.scroll_x + width:
                self.scroll_x = x + self.font.value().advance() - width
        self.clamp_scroll()

    mutating func notify_changed() -> interop.Outcome[unit]:
        self.highlights.transform(self.document.last_change())
        self.folds.transform(self.document.last_change())
        self.vertical_move = false
        self.active_since = time.now()
        self.reveal_caret() catch failure:
            return result.failure[unit](failure.code, failure.message)
        self.box.value().invalidate()
        return self.changed.emit(())

    pub mutating func close():
        self.font.release()
        self.changed.close()
        self.changed.release()
        self.document.close()
        self.highlights.close()
        self.folds.close()
        self.projection.close()
        if let baseline = self.baseline:
            baseline.release()
        self.diff.close()
        self.box.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.font.trace(visit, context)
        self.box.trace(visit, context)
        self.changed.trace(visit, context)

pub let text_editor_type: interop.Type[TextEditor] = interop.Type[TextEditor]("Text editor", TextEditor.close, TextEditor.trace, closeable = true, main_thread = true)
