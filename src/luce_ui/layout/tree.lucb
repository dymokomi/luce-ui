#==============================================================================================
#
#   layout/tree - The Tree: gathering, focus, capture, dispatch and drawing
#
#==============================================================================================

struct Entry:
    let widget: interop.Interface[Widget]
    let box: interop.Reference[Layout]
    let parent: i64
    var end: usize

## A retained traversal protects callbacks against reentrant tree replacement.
## It is rebuilt transactionally and bounded independently of recursion depth.
pub struct Tree:
    let root: interop.Interface[Widget]
    let identifier: u64
    var entries: Entry[]
    var count: usize
    var width: f64
    var height: f64
    var version: u64
    var focus: u64
    var requested_focus: u64
    var capture: u64
    ## The widget a secondary (right) press went to, which its release goes to as well.
    var secondary_holder: u64
    var return_focus: u64
    var appearance: Theme
    var pointer_present: bool
    var pointer_x: f64
    var pointer_y: f64
    var animating: bool
    ## The drop area a drag is over, or 0.
    var drop_hover: u64

    ## A tree rooted at `content`, which must be visible and parentless; nothing is
    ## gathered until the first arrangement.
    pub func init(content: interop.Interface[Widget], theme: Theme = Theme()) -> !:
        try require_main_thread()
        try theme.validate()
        serial = serial +? 1 else error(result.limit, "UI identities exhausted")
        self.identifier = serial
        self.root = content.clone()
        var empty: Entry[]
        self.entries = empty
        self.count = 0
        self.width = 0.0
        self.height = 0.0
        self.version = 0
        self.focus = 0
        self.requested_focus = 0
        self.capture = 0
        self.secondary_holder = 0
        self.return_focus = 0
        self.appearance = theme
        self.pointer_present = false
        self.pointer_x = 0.0
        self.pointer_y = 0.0
        self.animating = false
        self.drop_hover = 0

    ## Whether a popup is still easing toward its placement, so the run loop keeps
    ## drawing frames until it settles instead of blocking.
    pub func is_animating() -> bool:
        return self.animating

    ## The application theme, inherited by every box that sets none of its own.
    pub func theme() -> Theme:
        return self.appearance

    pub mutating func set_theme(theme: Theme) -> !:
        try theme.validate()
        self.appearance = theme
        bump_revision()

    ## Arrange again at the last size; see `arrange`.
    pub mutating func refresh() -> interop.Outcome[unit]:
        return self.arrange(self.width, self.height)

    ## Rebuild the arrangement for a `width` by `height` window, unless neither the
    ## size nor the layout epoch changed since the last one. Gathers the visible
    ## widgets, resolves themes top-down, measures bottom-up, places boxes and then
    ## popups, and settles focus, capture and hover. A popup that opens takes
    ## focus and hands it back when it closes. On failure the previous arrangement
    ## stays in effect; a widget that invalidates while measuring fails it.
    pub mutating func arrange(width: f64, height: f64) -> interop.Outcome[unit]:
        extent(width) catch failure:
            return result.failure[unit](failure.code, failure.message)
        extent(height) catch failure:
            return result.failure[unit](failure.code, failure.message)
        if self.count > 0 and self.width == width and self.height == height and self.version == epoch():
            return result.success[unit](())
        self.animating = false
        let replacement = alloc Entry[1024] in memory.heap catch failure:
            return result.failure[unit](failure.code, failure.message)
        var count: usize = 0
        var committed = false
        defer discard_replacement(replacement, &count, &committed)
        let started = epoch()
        gather(self.root, replacement, &count, -1, 0, self.identifier) catch failure:
            return result.failure[unit](failure.code, failure.message)
        # Resolve parent context before measuring descendants. Values avoid
        # shared mutable theme state and require no work in widget draw paths.
        for position in 0..<count:
            let entry = &replacement[position]
            let inherited = replacement[(usize)entry.parent].box.value().appearance if entry.parent >= 0 else self.appearance
            entry.box.value().appearance = entry.box.value().local_theme else inherited
        # Inside a box that takes scroll (a scroll view) a box measures its
        # natural height, unbounded; parents come before their children.
        let unbounded = alloc bool[count + 1] in memory.heap catch _:
            return result.failure[unit](result.limit, "out of memory measuring the tree")
        defer free(unbounded) in memory.heap
        for position in 0..<count:
            let parent = replacement[position].parent
            unbounded[position] = parent >= 0 and (replacement[(usize)parent].box.value().scrolls or unbounded[(usize)parent])
        var index = count
        while index > 0:
            index -= 1
            let entry = &replacement[index]
            entry.widget.enter() catch failure:
                return result.failure[unit](failure.code, failure.message)
            defer entry.widget.leave()
            let measured = entry.widget.value().measure(Constraints(width, 16384.0 if unbounded[index] else height))
            defer measured.release()
            let size = measured.get() catch failure:
                return result.failure[unit](failure.code, failure.message)
            extent(size.width) catch failure:
                return result.failure[unit](failure.code, failure.message)
            extent(size.height) catch failure:
                return result.failure[unit](failure.code, failure.message)
            let box = entry.box.value()
            box.measured = Size(math.clamp(size.width, box.minimum.width, box.maximum.width),
                                math.clamp(size.height, box.minimum.height, box.maximum.height))
        if epoch() != started:
            return result.failure[unit](result.busy, "a widget changed the tree during measurement")
        let bounds = Rect(width = width, height = height)
        place(replacement, 0, bounds, bounds) catch failure:
            return result.failure[unit](failure.code, failure.message)
        var popup: u64 = 0
        for entry in replacement[..<count]:
            let box = entry.box.value()
            if box.popup and entry.parent >= 0:
                let anchor = replacement[(usize)entry.parent].box.value().rectangle
                let popup_width = math.min(box.measured.width, bounds.width)
                let popup_height = math.min(box.measured.height, bounds.height)
                var x = math.clamp(anchor.x, 0.0, bounds.width - popup_width)
                let below = anchor.y + anchor.height
                var y = below if below + popup_height <= bounds.height else math.max(0.0, anchor.y - popup_height)
                if box.popup_placement == PopupPlacement.point:
                    x = math.clamp(anchor.x + box.popup_point.x, 0.0, bounds.width - popup_width)
                    y = math.clamp(anchor.y + box.popup_point.y, 0.0, bounds.height - popup_height)
                elif box.popup_placement == PopupPlacement.window_top:
                    x = (bounds.width - popup_width) * 0.5
                    y = math.min(math.min(40.0, bounds.height * 0.1), bounds.height - popup_height)
                elif box.popup_placement == PopupPlacement.window_center:
                    # Centred, moved by its offset (a dragged dialog), kept inside.
                    x = math.clamp((bounds.width - popup_width) * 0.5 + box.popup_point.x, 0.0, math.max(0.0, bounds.width - popup_width))
                    y = math.clamp((bounds.height - popup_height) * 0.5 + box.popup_point.y, 0.0, math.max(0.0, bounds.height - popup_height))
                var placed = Rect(x, y, popup_width, popup_height)
                if box.animate_open and box.visible:
                    if box.opening:
                        # Grow downward from the pinned top: start at half height with the
                        # same top and width, so the search field never moves — only the
                        # bottom eases open. Height changes while open animate the same way.
                        box.opening = false
                        box.rectangle = Rect(placed.x, placed.y, placed.width, placed.height * 0.5)
                    let eased = ease_rect(box.rectangle, placed, 0.22)
                    if not settled(eased, placed):
                        placed = eased
                        self.animating = true
                        bump_revision()
                let position = find_entry(replacement, count, box.identifier) else trap("popup missing from tree")
                place(replacement, position, placed, bounds) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                if box.modal and box.visible:
                    popup = box.identifier
        if popup != 0 and popup != self.focus:
            if self.return_focus == 0:
                self.return_focus = self.focus
            self.focus = popup
        # A box that claims the press under way (a flyout a held button opened)
        # takes the capture: the drag and its release are its now.
        for entry in replacement[..<count]:
            let claimant = entry.box.value()
            if claimant.claims_press and claimant.visible:
                claimant.claims_press = false
                if self.capture != 0 and self.capture != claimant.identifier:
                    let claimed = self.cancel(self.capture)
                    if not claimed.is_success():
                        return claimed
                    claimed.release()
                    self.capture = claimant.identifier
        # Cancel against the old retained snapshot before its edges are released.
        if self.capture != 0 and not eligible(replacement, count, self.capture, false):
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            self.capture = 0
        if self.focus != 0 and not eligible(replacement, count, self.focus, true):
            if self.focus != self.capture:
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.focus = 0
        if popup == 0 and self.return_focus != 0:
            if eligible(replacement, count, self.return_focus, true):
                self.focus = self.return_focus
            self.return_focus = 0
        if popup == 0:
            for position in 0..<count:
                let entry = &replacement[position]
                if entry.box.value().focus_requested:
                    entry.box.value().focus_requested = false
                    for descendant in position..<entry.end:
                        let identifier = replacement[descendant].box.value().identifier
                        if eligible(replacement, count, identifier, true):
                            self.focus = identifier
                            break
        if self.requested_focus != 0 and popup == 0:
            if eligible(replacement, count, self.requested_focus, true):
                self.focus = self.requested_focus
            self.requested_focus = 0
        for entry in self.entries[..<self.count]:
            entry.box.value().application = 0
            entry.box.value().focused = false
            entry.box.value().focus_within = false
            entry.box.value().hovered = false
            entry.box.value().pointer_within = false
        # Swap first, release after: a release can run the cycle collector,
        # which traces `self.entries`, so they must never name references
        # already given up.
        let previous = self.entries
        let previous_count = self.count
        committed = true
        self.entries = replacement
        self.count = count
        release_entries(previous, previous_count)
        self.width = width
        self.height = height
        self.version = started
        for entry in self.entries[..<self.count]:
            let box = entry.box.value()
            box.application = self.identifier
            box.focused = box.identifier == self.focus
        mark_focus(self.entries, self.count, self.focus, self.return_focus)
        self.update_hover()
        return result.success[unit](())

    # mark: Drags from other applications ======================================================

    ## Whether a drop would be taken where the drag is now: the application tells
    ## the window so after every drag event.
    pub func drop_accepted() -> bool:
        let index = self.find(self.drop_hover) else return false
        return self.entries[index].box.value().drop_accepted

    ## The innermost visible, enabled drop area under a point (a popup's, while one is open).
    func drop_at(x: f64, y: f64) -> u64:
        let modal = self.has_popup()
        var index = self.count
        while index > 0:
            index -= 1
            let box = self.entries[index].box.value()
            if box.drop_target and (not modal or in_popup(self.entries, index)) and path_enabled(self.entries, index) and inside(box.clipping, x, y):
                return box.identifier
        return 0

    ## Route a drag: the area under the pointer gets entered/moved, the one it
    ## left gets left, and a drop goes to the area that takes it.
    mutating func dispatch_drag(event: input.Event) -> interop.Outcome[unit]:
        let target = 0 if event.kind == input.EventKind.drag_left else self.drop_at(event.x, event.y)
        if target != self.drop_hover:
            let left = self.leave_drop()
            if not left.is_success():
                return left
            left.release()
            if let index = self.find(target):
                let box = self.entries[index].box.value()
                box.drop_accepted = true
                box.drop_hovered = true
                box.invalidate()
                self.drop_hover = target
                let entered = self.send_drag(index, input.EventKind.drag_entered, event.x, event.y)
                if not entered.is_success():
                    return entered
                entered.release()
        elif event.kind == input.EventKind.drag_moved:
            if let index = self.find(target):
                let moved = self.send_drag(index, input.EventKind.drag_moved, event.x, event.y)
                if not moved.is_success():
                    return moved
                moved.release()
        if event.kind == input.EventKind.drop:
            if let index = self.find(self.drop_hover):
                let box = self.entries[index].box.value()
                box.drop_hovered = false
                box.invalidate()
                self.drop_hover = 0
                if box.drop_accepted:
                    return self.send_drag(index, input.EventKind.drop, event.x, event.y)
        return result.success[unit](())

    mutating func leave_drop() -> interop.Outcome[unit]:
        let found = self.find(self.drop_hover)
        if found == none:
            self.drop_hover = 0
            return result.success[unit](())
        let index = found else return result.success[unit](())
        let box = self.entries[index].box.value()
        box.drop_hovered = false
        box.invalidate()
        self.drop_hover = 0
        return self.send_drag(index, input.EventKind.drag_left, 0.0, 0.0)

    func send_drag(index: usize, kind: input.EventKind, x: f64, y: f64) -> interop.Outcome[unit]:
        let box = self.entries[index].box.value()
        return self.send(index, Event(kind = kind, x = x - box.rectangle.x, y = y - box.rectangle.y, inside = true))

    ## The lit drop area: the accent laid thinly over it with a two-point edge,
    ## so the place a drop would land is plain.
    func draw_drop_overlay(target: interop.View[gpu.RenderTarget]) -> !:
        let index = self.find(self.drop_hover) else return
        let box = self.entries[index].box.value()
        if not box.drop_overlay or not box.drop_accepted or box.clipping.width <= 0.0 or box.clipping.height <= 0.0:
            return
        let native_target = try target.get()
        let clipped = try native_target.clipped(box.clipping)
        defer clipped.release()
        let region = try (try clipped.get()).region(box.rectangle)
        defer region.release()
        var painter = try Painter(region)
        defer painter.close()
        let theme = box.appearance
        let area = gpu.Rect(width = box.rectangle.width, height = box.rectangle.height)
        try painter.rounded_rectangle(area, theme.accent, theme.control_radius, 0.14)
        let edge = 2.0
        try painter.rectangle(gpu.Rect(0.0, 0.0, area.width, edge), theme.accent)
        try painter.rectangle(gpu.Rect(0.0, area.height - edge, area.width, edge), theme.accent)
        try painter.rectangle(gpu.Rect(0.0, 0.0, edge, area.height), theme.accent)
        try painter.rectangle(gpu.Rect(area.width - edge, 0.0, edge, area.height), theme.accent)

    ## Draw every visible box in tree order, each clipped to its box, then every
    ## popup subtree over the rest with its shadow — a popup opened inside another
    ## (a menu in a dialog) over that one. The lit drop area goes over the pass it
    ## belongs to.
    pub func draw(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        var failed: interop.Outcome[unit]? = none
        var deepest: usize = 0
        for index in 0..<self.count:
            let depth = popup_depth(self.entries, index)
            if depth > deepest:
                deepest = depth
        for pass in 0..<(deepest + 1):
            for index in 0..<self.count:
                if popup_depth(self.entries, index) != pass:
                    continue
                let entry = self.entries[index]
                let box = entry.box.value()
                if box.clipping.width <= 0.0 or box.clipping.height <= 0.0:
                    continue
                let native_target = target.get() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                # Shadows use the window target before popup clipping. They do
                # not enlarge layout or hit bounds, and remain sharp at any scale.
                if box.popup:
                    self.draw_shadow(target, box.rectangle, box.appearance) catch failure:
                        return result.failure[unit](failure.code, failure.message)
                let clipped = native_target.clipped(box.clipping) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer clipped.release()
                let native_clipped = clipped.get() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                let region = native_clipped.region(box.rectangle) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer region.release()
                entry.widget.enter() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer entry.widget.leave()
                var widget = entry.widget.value()
                let drawn = widget.draw(region)
                if not drawn.is_success():
                    # One widget that cannot draw (a document past the GPU's
                    # memory) must not blank the window: the rest still draw,
                    # and the first failure is reported once they have.
                    if failed == none:
                        failed = drawn
                    else:
                        drawn.release()
                    continue
                drawn.release()
            # Over everything in its pass, the lit drop area.
            if let hovered = self.find(self.drop_hover):
                if popup_depth(self.entries, hovered) == pass:
                    self.draw_drop_overlay(target) catch failure:
                        return result.failure[unit](failure.code, failure.message)
        if let first = failed:
            return first
        return result.success[unit](())

    ## A soft drop shadow around the whole popup: several expanding layers, densest at
    ## the box and fading outward, with a slight downward bias so the surface reads as
    ## lifted off the content behind it. Drawn before the popup's own clip.
    func draw_shadow(target: interop.View[gpu.RenderTarget], bounds: Rect, theme: Theme) -> !:
        if theme.shadow_offset == 0.0 or theme.shadow_opacity == 0.0:
            return
        var painter = try Painter(target)
        defer painter.close()
        # Many thin nested layers feather smoothly instead of banding. Each adds the
        # same alpha, chosen so the layers composite to shadow_opacity right at the box
        # and fall off across `spread`; a downward bias reads as a lifted surface.
        let layers = 24
        let spread = theme.shadow_offset * 6.0
        let step = spread / (f64)layers
        let bias = theme.shadow_offset * 0.6
        let per = 1.0 - math.pow(1.0 - theme.shadow_opacity, 1.0 / (f64)layers)
        for ring in 0..<layers:
            let grow = step * (f64)(ring + 1)
            try painter.rectangle(Rect(bounds.x - grow, bounds.y - grow + bias,
                                       bounds.width + grow * 2.0, bounds.height + grow * 2.0), theme.shadow, per)

    ## Route one window event, arranging before and after. Pointer events go to
    ## the capturing box or the one hit, which a primary press focuses (when
    ## focusable) and captures until release; keys and text go to the focused box,
    ## and Tab moves focus unless the focused box keeps Tab. Secondary clicks and
    ## Shift-F10 open the nearest context menu. Focus loss cancels capture and
    ## focus. While a modal popup is open input is modal: only its subtree is hit,
    ## key and text input go to the popup's root widget, and a press outside it
    ## is swallowed after sending the popup a cancellation. A non-modal popup is
    ## only hit first.
    pub mutating func dispatch(event: input.Event) -> interop.Outcome[unit]:
        # A move while a widget holds the pointer (a stroke, a drag) goes to it on
        # the arrangement already made: a fast pointer sends hundreds a frame, and
        # arranging the whole tree for each is what would slow the frame down.
        if not self.captured_move(event):
            let arranged = self.arrange(self.width, self.height)
            if not arranged.is_success():
                return arranged
            arranged.release()
        if event.kind == input.EventKind.pointer_left:
            self.pointer_present = false
            self.update_hover()
            return result.success[unit](())
        if event.kind == input.EventKind.drag_entered or event.kind == input.EventKind.drag_moved or event.kind == input.EventKind.drag_left or event.kind == input.EventKind.drop:
            return self.dispatch_drag(event)
        if event.kind == input.EventKind.pointer_moved or event.kind == input.EventKind.pointer_entered or event.kind == input.EventKind.pointer_down or event.kind == input.EventKind.pointer_up or event.kind == input.EventKind.scroll or event.kind == input.EventKind.magnify:
            self.pointer_x = event.x
            self.pointer_y = event.y
            self.pointer_present = math.is_finite(event.x) and math.is_finite(event.y)
            self.update_hover()
        if event.kind == input.EventKind.focus_lost or event.kind == input.EventKind.overflow:
            self.pointer_present = false
            self.update_hover()
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            if self.focus != self.capture:
                let focus_cancelled = self.cancel(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.capture = 0
            self.return_focus = 0
            self.requested_focus = 0
            self.set_focus(0)
            return result.success[unit](())
        if let popup = self.popup_index():
            let box = self.entries[popup].box.value()
            if event.kind == input.EventKind.pointer_moved or (event.kind == input.EventKind.pointer_down and event.button == 0):
                if let peer = self.menu_at(popup, event.x, event.y):
                    if self.entries[popup].parent != (i64)peer:
                        return self.switch_menu(popup, peer)
            if event.kind == input.EventKind.key_down and not event.repeated and (event.key == input.Key.left or event.key == input.Key.right):
                if let peer = self.next_menu(popup, event.key == input.Key.left):
                    return self.switch_menu(popup, peer)
            if event.kind == input.EventKind.pointer_down and not inside(box.clipping, event.x, event.y):
                let cancelled = self.cancel(box.identifier)
                if not cancelled.is_success():
                    return cancelled
                cancelled.release()
                self.capture = 0
                return self.arrange(self.width, self.height)
            # Tab stays within the popup; its widget chooses how to navigate.
            if event.kind == input.EventKind.key_down or event.kind == input.EventKind.key_up or event.kind == input.EventKind.text_input or event.kind == input.EventKind.modifiers_changed:
                let delivered = self.send(popup, Event(kind = event.kind, key = event.key,
                                                       repeated = event.repeated, shift = event.modifiers.shift,
                                                       control = event.modifiers.control, alt = event.modifiers.alt, meta = event.modifiers.super,
                                                       codepoint = (i64)event.codepoint))
                if not delivered.is_success():
                    return delivered
                delivered.release()
                return self.arrange(self.width, self.height)
        let secondary = event.kind == input.EventKind.pointer_down and event.button == 1
        let keyboard_context = event.kind == input.EventKind.key_down and event.key == input.Key.f10 and event.modifiers.shift and not event.repeated
        if (secondary or keyboard_context) and not self.has_popup():
            let destination = self.hit(event.x, event.y) if secondary else self.focus
            if let target = self.find(destination):
                let box = self.entries[target].box.value()
                if secondary:
                    let cancelled = self.cancel(self.capture)
                    if not cancelled.is_success():
                        return cancelled
                    cancelled.release()
                    self.capture = 0
                    if box.accepts_focus:
                        if self.focus != destination:
                            let cancelled_focus = self.leave(self.focus)
                            if not cancelled_focus.is_success():
                                return cancelled_focus
                            cancelled_focus.release()
                        self.set_focus(destination)
                    if not box.context_menu:
                        self.secondary_holder = destination
                        let selected = self.send(target, Event(kind = event.kind, button = 1,
                                                               x = event.x - box.rectangle.x, y = event.y - box.rectangle.y, inside = true))
                        if not selected.is_success():
                            return selected
                        selected.release()
                var ancestor = (i64)target
                while ancestor >= 0:
                    let provider = self.entries[(usize)ancestor].box.value()
                    if provider.context_menu and path_enabled(self.entries, (usize)ancestor):
                        let x = event.x - provider.rectangle.x if secondary else 0.0
                        let y = event.y - provider.rectangle.y if secondary else math.min(box.rectangle.y - provider.rectangle.y + box.rectangle.height, provider.rectangle.height)
                        let opened = self.send((usize)ancestor, Event(kind = input.EventKind.pointer_down, button = 1, x = x, y = y, inside = true))
                        if not opened.is_success():
                            return opened
                        opened.release()
                        return self.arrange(self.width, self.height)
                    ancestor = self.entries[(usize)ancestor].parent
            return result.success[unit](())
        var text_tab = false
        if let focused = self.find(self.focus):
            text_tab = self.entries[focused].box.value().accepts_tab and not event.modifiers.control
        if event.kind == input.EventKind.key_down and event.key == input.Key.tab and not text_tab:
            if not event.repeated:
                let capture_cancelled = self.cancel(self.capture)
                if not capture_cancelled.is_success():
                    return capture_cancelled
                capture_cancelled.release()
                let focus_cancelled = self.leave(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
                self.capture = 0
                self.advance_focus(event.modifiers.shift)
            return result.success[unit](())
        var destination: u64 = 0
        if event.kind == input.EventKind.pointer_down and event.button == 0:
            destination = self.hit(event.x, event.y)
            let capture_cancelled = self.cancel(self.capture)
            if not capture_cancelled.is_success():
                return capture_cancelled
            capture_cancelled.release()
            if destination != self.focus:
                let focus_cancelled = self.leave(self.focus)
                if not focus_cancelled.is_success():
                    return focus_cancelled
                focus_cancelled.release()
            self.capture = destination
            let selected = self.find(destination)
            if let index = selected:
                self.set_focus(destination if self.entries[index].box.value().accepts_focus else 0)
            else:
                self.set_focus(0)
        elif event.kind == input.EventKind.pointer_down and event.button >= 2:
            # Middle and extra buttons go to what is under the pointer and hold it for
            # the drag, as the primary button does, but leave keyboard focus alone.
            destination = self.hit(event.x, event.y)
            let held_cancelled = self.cancel(self.capture)
            if not held_cancelled.is_success():
                return held_cancelled
            held_cancelled.release()
            self.capture = destination
        elif event.kind == input.EventKind.pointer_up and (event.button == 0 or event.button >= 2):
            destination = self.capture if self.capture != 0 else self.hit(event.x, event.y)
            self.capture = 0
        elif event.kind == input.EventKind.pointer_up and event.button == 1 and self.secondary_holder != 0:
            # A right-button drag (a brush sized by it) ends where it began.
            destination = self.secondary_holder
            self.secondary_holder = 0
        elif event.kind == input.EventKind.pointer_moved:
            destination = self.capture if self.capture != 0 else self.hit(event.x, event.y)
        elif event.kind == input.EventKind.scroll or event.kind == input.EventKind.magnify:
            destination = self.scroll_target(self.hit(event.x, event.y))
        elif event.kind == input.EventKind.key_down or event.kind == input.EventKind.key_up or event.kind == input.EventKind.text_input or event.kind == input.EventKind.modifiers_changed:
            destination = self.focus
        if let index = self.find(destination):
            let box = self.entries[index].box.value()
            let translated = Event(kind = event.kind, key = event.key,
                                   x = event.x - box.rectangle.x, y = event.y - box.rectangle.y,
                                   button = (i64)event.button, repeated = event.repeated, shift = event.modifiers.shift,
                                   control = event.modifiers.control, alt = event.modifiers.alt, meta = event.modifiers.super,
                                   codepoint = (i64)event.codepoint, scroll_unit = event.scroll_unit,
                                   inside = inside(box.clipping, event.x, event.y), scroll_x = event.scroll_x, scroll_y = event.scroll_y, pressure = event.pressure)
            let delivered = self.send(index, translated)
            if not delivered.is_success():
                return delivered
            delivered.release()
        # A captured move changes no arrangement: the run loop arranges once
        # before it draws, so a fast pointer does not arrange hundreds of times.
        if self.captured_move(event):
            return result.success[unit](())
        let refreshed = self.arrange(self.width, self.height)
        if not refreshed.is_success():
            return refreshed
        refreshed.release()
        return result.success[unit](())

    ## Escape or Enter while a dialog is open goes to the topmost open one (a
    ## picker opened over another dialog takes them first), to cancel or
    ## accept; true when one took it. A focused field first drops (Escape) or keeps
    ## (Enter) what was typed. Enter stays with a multi-line editor.
    pub mutating func dialog_key(event: input.Event) -> interop.Outcome[bool]:
        if event.kind != input.EventKind.key_down or event.repeated or (event.key != input.Key.escape and event.key != input.Key.enter):
            return result.success[bool](false)
        if event.modifiers.control or event.modifiers.alt or event.modifiers.super or event.modifiers.shift or self.has_popup():
            return result.success[bool](false)
        let focused = self.find(self.focus)
        var target: usize? = none
        var index = self.count
        while index > 0 and target == none:
            index -= 1
            let box = self.entries[index].box.value()
            if box.dialog and box.visible and path_enabled(self.entries, index):
                target = index
        let dialog = target else return result.success[bool](false)
        if let field = focused:
            let box = self.entries[field].box.value()
            if box.accepts_text:
                if event.key == input.Key.enter and box.accepts_tab:
                    return result.success[bool](false)
                # A field left by Enter keeps its text, as focus moving away would.
                let resolved = self.send(field, Event(kind = input.EventKind.focus_lost) if event.key == input.Key.enter else Event(kind = input.EventKind.key_down, key = input.Key.escape))
                defer resolved.release()
                discard(resolved.get() catch failure:
                    return result.failure[bool](failure.code, failure.message))
        let delivered = self.send(dialog, Event(kind = input.EventKind.key_down, key = event.key))
        defer delivered.release()
        discard(delivered.get() catch failure:
            return result.failure[bool](failure.code, failure.message))
        let arranged = self.arrange(self.width, self.height)
        defer arranged.release()
        discard(arranged.get() catch failure:
            return result.failure[bool](failure.code, failure.message))
        return result.success[bool](true)

    ## The open modal popup, if any; a non-modal one does not hold input.
    func popup_index() -> usize?:
        var index = self.count
        while index > 0:
            index -= 1
            let box = self.entries[index].box.value()
            if box.popup and box.modal and box.visible:
                return index
        return none

    func menu_owner(popup: usize) -> usize?:
        let parent = self.entries[popup].parent
        if parent < 0 or not self.entries[(usize)parent].box.value().menu_trigger:
            return none
        return (usize)parent

    func menu_at(popup: usize, x: f64, y: f64) -> usize?:
        let owner = self.menu_owner(popup) else return none
        let group = self.entries[owner].parent
        for index in 0..<self.count:
            let box = self.entries[index].box.value()
            if self.entries[index].parent == group and box.menu_trigger and path_enabled(self.entries, index) and inside(box.clipping, x, y):
                return index
        return none

    func next_menu(popup: usize, backwards: bool) -> usize?:
        let owner = self.menu_owner(popup) else return none
        let group = self.entries[owner].parent
        var index = owner
        for visited in 0..<self.count:
            index = (self.count - 1 if index == 0 else index - 1) if backwards else (index + 1) % self.count
            let box = self.entries[index].box.value()
            if self.entries[index].parent == group and box.menu_trigger and path_enabled(self.entries, index) and box.clipping.width > 0.0 and box.clipping.height > 0.0:
                return index
        return none

    mutating func switch_menu(popup: usize, peer: usize) -> interop.Outcome[unit]:
        let cancelled = self.cancel(self.entries[popup].box.value().identifier)
        if not cancelled.is_success():
            return cancelled
        cancelled.release()
        let capture_cancelled = self.cancel(self.capture)
        if not capture_cancelled.is_success():
            return capture_cancelled
        capture_cancelled.release()
        self.capture = 0
        self.return_focus = self.entries[peer].box.value().identifier
        let opened = self.send(peer, Event(menu_requested = true))
        if not opened.is_success():
            return opened
        opened.release()
        return self.arrange(self.width, self.height)

    ## Hover is derived from current geometry, including after layout changes
    ## beneath a stationary pointer. Updating it never remeasures the widget tree.
    mutating func update_hover():
        for entry in self.entries[..<self.count]:
            let box = entry.box.value()
            box.hovered = false
            box.pointer_within = false
            box.pointer = Point(self.pointer_x - box.rectangle.x, self.pointer_y - box.rectangle.y)
        if not self.pointer_present:
            return
        var hovered: usize? = none
        let popup = self.popup_index()
        if let active = popup:
            if not inside(self.entries[active].box.value().clipping, self.pointer_x, self.pointer_y):
                hovered = self.menu_at(active, self.pointer_x, self.pointer_y)
        if hovered == none:
            var index = self.count
            while index > 0:
                index -= 1
                let box = self.entries[index].box.value()
                if (popup == none or in_popup(self.entries, index)) and path_enabled(self.entries, index) and not box.hover_transparent and inside(box.clipping, self.pointer_x, self.pointer_y):
                    hovered = index
                    break
        let index = hovered else return
        self.entries[index].box.value().hovered = true
        var ancestor = (i64)index
        while ancestor >= 0:
            self.entries[(usize)ancestor].box.value().pointer_within = true
            ancestor = self.entries[(usize)ancestor].parent

    ## Whether a visible popup is open, which makes input modal.
    ## Whether `event` is a pointer move while a widget holds the pointer.
    pub func captured_move(event: input.Event) -> bool:
        return event.kind == input.EventKind.pointer_moved and self.capture != 0 and self.count > 0

    pub func has_popup() -> bool:
        return self.popup_index() != none

    ## Whether the focused box takes text input, so the window should deliver it.
    pub func wants_text_input() -> bool:
        let index = self.find(self.focus) else return false
        return self.entries[index].box.value().accepts_text

    ## The cursor for the capturing box, or else the box under the pointer: its
    ## cursor source's choice or its fixed cursor. The arrow when the pointer is
    ## away, over nothing, or over a disabled box.
    pub func cursor() -> input.Cursor!:
        if not self.pointer_present and self.capture == 0: return input.Cursor.arrow
        var target = self.capture
        if target == 0:
            if let popup = self.popup_index():
                if let menu = self.menu_at(popup, self.pointer_x, self.pointer_y):
                    target = self.entries[menu].box.value().identifier
            if target == 0: target = self.hit(self.pointer_x, self.pointer_y)
        let index = self.find(target) else return input.Cursor.arrow
        if not path_enabled(self.entries, index): return input.Cursor.arrow
        let box = self.entries[index].box.value()
        if let source = box.cursor_source:
            try source.enter()
            defer source.leave()
            let started = epoch()
            let cursor = source.value().cursor(Point(self.pointer_x - box.rectangle.x, self.pointer_y - box.rectangle.y), self.capture == target)
            if epoch() != started: error(result.busy, "a cursor query changed the widget tree")
            return cursor
        return box.pointer_cursor

    func find(identifier: u64) -> usize?:
        if identifier == 0:
            return none
        var index: usize = 0
        while index < self.count:
            if self.entries[index].box.value().identifier == identifier:
                return index
            index += 1
        return none

    ## The box a press at a point reaches: popups first, as they draw on top;
    ## while a modal one is open, nothing else.
    func hit(x: f64, y: f64) -> u64:
        let modal = self.has_popup()
        for pass in 0..<2:
            if pass == 1 and modal:
                break
            var index = self.count
            while index > 0:
                index -= 1
                let box = self.entries[index].box.value()
                if in_popup(self.entries, index) == (pass == 0) and path_enabled(self.entries, index) and box.accepts_pointer and inside(box.clipping, x, y):
                    return box.identifier
        return 0

    func send(index: usize, event: Event) -> interop.Outcome[unit]:
        let widget = self.entries[index].widget
        widget.enter() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer widget.leave()
        var native = widget.value()
        let delivered = native.event(event)
        return delivered

    func cancel(identifier: u64) -> interop.Outcome[unit]:
        if let index = self.find(identifier):
            let cancelled = self.send(index, Event(cancelled = true))
            if not cancelled.is_success():
                return cancelled
            cancelled.release()
        return result.success[unit](())

    ## Focus moves off `identifier`: it hears focus_lost first, so a field keeps
    ## (commits) its edit, then a cancellation, which ends any gesture it holds.
    func leave(identifier: u64) -> interop.Outcome[unit]:
        if let index = self.find(identifier):
            let lost = self.send(index, Event(kind = input.EventKind.focus_lost))
            if not lost.is_success():
                return lost
            lost.release()
        return self.cancel(identifier)

    ## Apply after the next arrangement, including children replaced during an
    ## input callback. Detached or disabled targets cannot acquire focus.
    pub mutating func focus_layout(target: interop.Reference[Layout]):
        self.requested_focus = target.value().identifier
        target.value().invalidate()

    mutating func set_focus(identifier: u64):
        self.focus = identifier
        for entry in self.entries[..<self.count]:
            entry.box.value().focused = entry.box.value().identifier == identifier
        mark_focus(self.entries, self.count, identifier, self.return_focus)
        bump_revision()

    mutating func advance_focus(backwards: bool):
        if self.count == 0:
            return
        var index = self.find(self.focus) else (0 if backwards else self.count - 1)
        var visited: usize = 0
        while visited < self.count:
            index = (self.count - 1 if index == 0 else index - 1) if backwards else (index + 1) % self.count
            let box = self.entries[index].box.value()
            if path_enabled(self.entries, index) and box.accepts_focus and box.clipping.width > 0.0 and box.clipping.height > 0.0:
                self.set_focus(box.identifier)
                return
            visited += 1
        self.set_focus(0)

    pub mutating func close():
        for entry in self.entries[..<self.count]:
            # Cycle collection can finalize a layout before its application.
            # Closed layouts already released their state; only detach live ones.
            if not entry.box.is_closed():
                let box = entry.box.value()
                box.application = 0
                box.focused = false
                box.focus_within = false
                box.hovered = false
                box.pointer_within = false
        # As in `arrange`: forget the entries before releasing them.
        let previous = self.entries
        let previous_count = self.count
        self.count = 0
        var empty: Entry[]
        self.entries = empty
        release_entries(previous, previous_count)
        self.root.release()

    ## Where a scroll over box `hit` goes: the nearest box at or above it that
    ## takes scroll, or `hit` itself when none does.
    func scroll_target(hit: u64) -> u64:
        let found = self.find(hit) else return hit
        var at = (i64)found
        while at >= 0:
            let box = self.entries[(usize)at].box.value()
            if box.takes_scroll():
                return (u64)box.id()
            at = self.entries[(usize)at].parent
        return hit

    pub func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.root.trace(visit, context)
        for entry in self.entries[..<self.count]:
            entry.widget.trace(visit, context)
            entry.box.trace(visit, context)

func mark_focus(entries: Entry[], count: usize, focus: u64, return_focus: u64):
    for entry in entries[..<count]:
        entry.box.value().focus_within = false
    for identifier in [focus, return_focus]:
        if let index = find_entry(entries, count, identifier):
            var ancestor = (i64)index
            while ancestor >= 0:
                entries[(usize)ancestor].box.value().focus_within = true
                ancestor = entries[(usize)ancestor].parent

func release_entries(entries: Entry[], count: usize):
    for entry in entries[..<count]:
        entry.widget.release()
        entry.box.release()
    if entries.length > 0:
        free(entries) in memory.heap

func path_enabled(entries: const Entry[], index: usize) -> bool:
    var cursor = (i64)index
    while cursor >= 0:
        let entry = &entries[(usize)cursor]
        if not entry.box.value().active:
            return false
        cursor = entry.parent
    return true

func eligible(entries: const Entry[], count: usize, identifier: u64, focus: bool) -> bool:
    var index: usize = 0
    while index < count:
        let box = entries[index].box.value()
        if box.identifier == identifier:
            return path_enabled(entries, index) and (box.accepts_focus if focus else box.accepts_pointer) and box.clipping.width > 0.0 and box.clipping.height > 0.0
        index += 1
    return false

func gather(widget: interop.Interface[Widget], entries: Entry[], count: usize*, parent: i64,
            depth: usize, application: u64) -> !:
    if depth >= 64 or *count >= entries.length:
        error(result.limit, "a widget tree supports at most 1024 widgets and 64 levels")
    let box = try widget_layout(widget)
    errdefer box.release()
    let state = try box.get()
    if not state.visible:
        if parent == -1:
            error(result.invalid, "an application root must be visible")
        box.release()
        return
    if state.application != 0 and state.application != application:
        error(result.busy, "a widget already belongs to another application")
    if parent == -1 and state.parent != 0:
        error(result.busy, "an application root already has a parent")
    for previous in entries[..<*count]:
        if previous.box.value().identifier == state.identifier:
            error(result.invalid, "widgets must return distinct stable layouts")
    let index = *count
    entries[index] = Entry(widget.clone(), box.clone(), parent, 0)
    *count += 1
    let length = state.child_count()
    var child_index: i64 = 0
    while child_index < length:
        let child = try state.child(child_index)
        defer child.release()
        if state.split != none:
            let child_box = try widget_layout(child)
            defer child_box.release()
            if not child_box.value().visible or child_box.value().popup:
                error(result.invalid, "split panes and dividers must be visible ordinary children")
        try gather(child, entries, count, (i64)index, depth + 1, application)
        child_index += 1
    entries[index].end = *count
    box.release()

func discard_replacement(entries: Entry[], count: usize*, committed: bool*):
    if not *committed:
        release_entries(entries, *count)

func require_main_thread() -> !:
    if not thread.is_main():
        error(interop.wrong_thread, "UI layout requires the main thread")

func find_entry(entries: const Entry[], count: usize, identifier: u64) -> usize?:
    for index in 0..<count:
        if entries[index].box.value().identifier == identifier:
            return index
    return none

## How many popups hold the box at `index`, itself included: 0 for the window's own.
func popup_depth(entries: const Entry[], index: usize) -> usize:
    var depth: usize = 0
    var cursor = (i64)index
    while cursor >= 0:
        if entries[(usize)cursor].box.value().popup:
            depth += 1
        cursor = entries[(usize)cursor].parent
    return depth

func in_popup(entries: const Entry[], index: usize) -> bool:
    var cursor = (i64)index
    while cursor >= 0:
        if entries[(usize)cursor].box.value().popup:
            return true
        cursor = entries[(usize)cursor].parent
    return false
