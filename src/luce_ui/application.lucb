## The native application: one window, its widget tree, commands, timers and
## frame callbacks, and the run loop that polls input, services timers, lays out
## and presents a frame only when something changed.
import core
import crash
import dialogs
import gpu
import input
import interop
import math
import ownership
import thread
import time
import utf8
import window
import luce_ui.result as result
import luce_ui.layout as layout
import luce_ui.scheduler as scheduler
from luce_ui.layout import Widget, Tree, Event
from luce_ui.theme import Theme
from luce_ui.command import Command, Commands

## Construction is platform-independent. run acquires native resources and owns
## their complete lifetime, including error unwinding and callback-driven stop.
pub struct Application:
    let title: interop.Owned[str]
    var tree: Tree
    var commands: Commands
    let frames: interop.Signal[f64]
    var close_handler: interop.Callback[unit, bool]?
    var error_handler: interop.Callback[str, unit]?
    let width: i64
    let height: i64
    var running: bool
    var operating: bool
    var closed: bool
    var dirty: bool
    var last_epoch: u64
    var last_render: u64
    var timers: scheduler.Scheduler
    var game: bool
    var target_fps: f64
    var fullscreen: bool
    var session_host: window.Window

    pub func init(content: interop.Interface[Widget], title: str = "Luce", width: i64 = 800, height: i64 = 600, theme: Theme = Theme(), game: bool = false, fps: f64 = 70.0, fullscreen: bool = false) -> !:
        if not thread.is_main():
            error(interop.wrong_thread, "UI applications require the main thread")
        if width < 1 or width > 10000 or height < 1 or height > 10000 or not utf8.valid(title.bytes):
            error(result.invalid, "a window needs valid UTF-8 and dimensions in 1..10000")
        try check_fps(fps)
        try theme.validate()
        let copied = try interop.copy_text(title)
        errdefer copied.release()
        var tree = try Tree(content, theme)
        errdefer tree.close()
        let frames = try interop.Signal[f64]()
        self.title = copied
        self.tree = tree
        self.commands = Commands()
        self.frames = frames
        self.close_handler = none
        self.error_handler = none
        self.width = width
        self.height = height
        self.running = false
        self.operating = false
        self.closed = false
        self.dirty = true
        self.last_epoch = 0
        self.last_render = 0
        self.timers = scheduler.Scheduler()
        self.game = game
        self.target_fps = fps
        self.fullscreen = fullscreen
        self.session_host = window.Window()

    func check() -> !:
        if self.closed:
            error(result.invalid, "the UI application is closed")

    ## Present every frame and cap the loop to `fps` (0 is uncapped). This is a
    ## run-loop mode, not a game engine: the application still owns simulation.
    pub mutating func set_game(game: bool):
        self.game = game
        if game:
            self.dirty = true

    pub func is_game() -> bool:
        return self.game

    pub mutating func set_fps(fps: f64) -> !:
        try check_fps(fps)
        self.target_fps = fps

    pub func fps() -> f64:
        return self.target_fps

    ## Applied on the next run, or immediately while the native window exists.
    pub mutating func set_fullscreen(enabled: bool) -> !:
        try self.check()
        self.fullscreen = enabled
        if self.running:
            try self.session_host.set_fullscreen(enabled)

    pub func is_fullscreen() -> bool:
        if self.running:
            return self.session_host.is_fullscreen() catch failure:
                recover self.fullscreen
        return self.fullscreen

    mutating func begin_operation() -> !:
        try self.check()
        if self.operating:
            error(result.busy, "layout, drawing and input dispatch cannot reenter themselves")
        self.operating = true

    mutating func end_operation():
        self.operating = false

    ## Request that the next loop iteration present a frame, for a change that no
    ## input event announced — a timer, a background result, or a script mutation.
    pub mutating func invalidate():
        self.dirty = true

    ## Run a callback once, `seconds` from now, on the main loop. A UI change it
    ## makes is presented on its own, since mutating a widget marks the tree dirty.
    pub mutating func after(seconds: f64, callback: interop.Callback[unit, unit]) -> i64!:
        try self.check()
        return try self.timers.after(seconds, callback)

    ## Run a callback every `seconds` on the main loop, until it is canceled. Drives
    ## periodic work — polling a file, checking a background task — without spinning.
    pub mutating func every(seconds: f64, callback: interop.Callback[unit, unit]) -> i64!:
        try self.check()
        return try self.timers.every(seconds, callback)

    ## Run a callback on the next serviced turn, to defer work back to the main loop.
    pub mutating func post(callback: interop.Callback[unit, unit]) -> i64!:
        try self.check()
        return try self.timers.post(callback)

    ## Stop a scheduled callback by the handle after/every/post returned.
    pub mutating func cancel(id: i64):
        self.timers.cancel(id)

    ## Frame callbacks receive elapsed seconds since the preceding iteration.
    pub func on_frame(callback: interop.Callback[f64, unit]) -> interop.Reference[interop.Connection]!:
        try self.check()
        return try self.frames.connect(callback)

    ## Returning false keeps the native window open, for example while unsaved
    ## documents await an explicit Save or Discard action in the application.
    pub mutating func set_close_handler(callback: interop.Callback[unit, bool]) -> !:
        try self.check()
        let replacement = callback.clone()
        # Replace, then release: a release can run the cycle collector, which traces this.
        let previous = self.close_handler
        self.close_handler = replacement
        if let old = previous:
            old.release()

    ## Recoverable input errors can be reported without discarding an editing
    ## session. Without a handler, run preserves its normal failure behavior.
    pub mutating func set_error_handler(callback: interop.Callback[str, unit]) -> !:
        try self.check()
        let replacement = callback.clone()
        let previous = self.error_handler
        self.error_handler = replacement
        if let old = previous:
            old.release()

    ## Replace the registered commands whose shortcuts `dispatch` and `run` match
    ## before the widget tree sees a key.
    pub mutating func set_commands(commands: const interop.Reference[Command][]) -> !:
        try self.check()
        try self.commands.set(commands)

    ## Show the desktop's open-file dialog with `message` and return the chosen
    ## path, or an empty string when it was canceled.
    pub func open_file(message: str) -> interop.Owned[str]!:
        let chosen = try dialogs.open_file(message) else return try interop.copy_text("")
        return chosen

    ## Show the desktop's save-file dialog suggesting `name` and return the chosen
    ## path, or an empty string when it was canceled.
    pub func save_file(message: str, name: str) -> interop.Owned[str]!:
        let chosen = try dialogs.save_file(message, name) else return try interop.copy_text("")
        return chosen

    ## The registered command with this id, or none — for a keymap or script that
    ## drives the same commands the UI does. Trigger it, then release the reference.
    pub func command(id: str) -> interop.Reference[Command]?:
        return self.commands.find(id)

    pub mutating func set_theme(theme: Theme) -> !:
        try self.check()
        try self.tree.set_theme(theme)

    pub mutating func focus(target: interop.Reference[layout.Layout]) -> !:
        try self.check()
        self.tree.focus_layout(target)

    ## The cursor the widget under the pointer (or the capturing widget) asks for,
    ## after refreshing the layout.
    pub mutating func cursor() -> input.Cursor!:
        try self.begin_operation()
        defer self.end_operation()
        let refreshed = self.tree.refresh()
        defer refreshed.release()
        try refreshed.get()
        return try self.tree.cursor()

    mutating func update_cursor(host: window.Window) -> !:
        try host.set_cursor(try self.cursor())

    ## Arrange the widget tree for a window of this size.
    pub mutating func layout(width: f64, height: f64) -> interop.Outcome[unit]:
        self.begin_operation() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer self.end_operation()
        return self.tree.arrange(width, height)

    ## Portable entry points allow embedding and deterministic input/drawing tests.
    ## An event with `cancelled` set becomes focus loss; otherwise command
    ## shortcuts see the event first (unless a popup is open), then the tree.
    pub mutating func dispatch(event: Event) -> interop.Outcome[unit]:
        self.begin_operation() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer self.end_operation()
        if event.cancelled:
            return self.tree.dispatch(input.Event(kind = input.EventKind.focus_lost))
        if event.button < 0 or event.button > 31:
            return result.failure[unit](result.invalid, "a pointer button must be in 0..31")
        if event.codepoint < 0 or event.codepoint > 0x10FFFF or (event.codepoint >= 0xD800 and event.codepoint <= 0xDFFF):
            return result.failure[unit](result.invalid, "text input requires a Unicode scalar")
        return self.route(input.Event(kind = event.kind, key = event.key,
                                      x = event.x, y = event.y, button = (u32)event.button,
                                      repeated = event.repeated, modifiers = input.Modifiers(shift = event.shift,
                                                                                             control = event.control, alt = event.alt, super = event.meta), codepoint = (u32)event.codepoint,
                                      scroll_x = event.scroll_x, scroll_y = event.scroll_y, scroll_unit = event.scroll_unit), false)

    mutating func dispatch_native(event: input.Event) -> interop.Outcome[unit]:
        self.begin_operation() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer self.end_operation()
        return self.route(event, true)

    ## `native` events come from the window; the others from `dispatch`, whose
    ## drags carry the files given to `set_drop_paths`.
    mutating func route(event: input.Event, native: bool) -> interop.Outcome[unit]:
        let arranged = self.tree.refresh()
        if not arranged.is_success():
            return arranged
        arranged.release()
        if event.kind == input.EventKind.drag_entered or event.kind == input.EventKind.drag_moved or event.kind == input.EventKind.drag_left or event.kind == input.EventKind.drop:
            return self.route_drag(event, native)
        # Shortcuts wait while a modal popup is open, and a field taking text
        # keeps its plain keys (typing "b" in a name must not pick the brush) and
        # the editing chords: select all, copy, cut, paste, undo and redo.
        # An open dialog takes Escape and Enter before any shortcut does.
        let dialog_keyed = self.tree.dialog_key(event)
        defer dialog_keyed.release()
        let dialog_took = dialog_keyed.get() catch failure:
            return result.failure[unit](failure.code, failure.message)
        if dialog_took:
            return result.success[unit](())
        let primary = event.modifiers.control or event.modifiers.super
        let editing = event.key == input.Key.a or event.key == input.Key.c or event.key == input.Key.x or event.key == input.Key.v or event.key == input.Key.z
        let typing = self.tree.wants_text_input() and (not primary or editing)
        if not self.tree.has_popup() and not typing:
            let dispatched = self.commands.dispatch(event)
            defer dispatched.release()
            let handled = dispatched.get() catch failure:
                return result.failure[unit](failure.code, failure.message)
            if handled:
                return result.success[unit](())
        return self.tree.dispatch(event)

    ## Files dragged from another application: the window's paths become what the
    ## drop areas read, the tree routes the drag, and the window learns whether a
    ## drop would be taken so the OS can say so.
    mutating func route_drag(event: input.Event, native: bool) -> interop.Outcome[unit]:
        if event.kind == input.EventKind.drag_entered and native and self.running:
            let paths = self.session_host.drop_paths() catch failure:
                return result.failure[unit](failure.code, failure.message)
            layout.set_drop_payload(paths) catch failure:
                return result.failure[unit](failure.code, failure.message)
        let routed = self.tree.dispatch(event)
        if not routed.is_success():
            return routed
        routed.release()
        if native and self.running:
            self.session_host.set_drop_accepted(self.tree.drop_accepted()) catch failure:
                return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    ## The files a drag carries, for tests and embedders that dispatch drag events
    ## themselves; a running window supplies them on its own.
    pub func set_drop_paths(paths: const str[]) -> !:
        try layout.set_drop_payload(paths)

    ## Arrange the tree at the target's size and draw it into the target. The
    ## caller acquires and presents the frame.
    pub mutating func render(target: interop.View[gpu.RenderTarget]) -> interop.Outcome[unit]:
        self.begin_operation() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer self.end_operation()
        let native = target.get() catch failure:
            return result.failure[unit](failure.code, failure.message)
        let size = native.size() catch failure:
            return result.failure[unit](failure.code, failure.message)
        let arranged = self.tree.arrange(size.width, size.height)
        if not arranged.is_success():
            return arranged
        arranged.release()
        return self.tree.draw(target)

    ## Repaint one frame at the current window size during a live resize, when the OS
    ## modal resize loop starves the event pump. Best effort: reentrancy or a
    ## transient surface fault simply leaves the last frame until the loop resumes.
    mutating func draw_resized(surface: gpu.Surface*) -> interop.Outcome[unit]:
        if not self.running:
            return result.success[unit](())
        let frame = surface.frame() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer frame.release()
        let target = frame.value().target() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer target.release()
        let rendered = self.render(target)
        if not rendered.is_success():
            return rendered
        rendered.release()
        discard(frame.value().present(self.tree.theme().background) catch failure:
            return result.failure[unit](failure.code, failure.message))
        return result.success[unit](())

    ## Open the window and GPU surface and drive the loop until `stop`, `close` or
    ## an allowed close request. A positive `frame_limit` stops after that many
    ## iterations and never blocks waiting for input, for deterministic tests; 0
    ## runs until stopped. Fails when the application is already running.
    pub mutating func run(frame_limit: i64 = 0) -> interop.Outcome[unit]:
        self.check() catch failure:
            return result.failure[unit](failure.code, failure.message)
        if self.running:
            return result.failure[unit](result.busy, "the application is already running")
        if frame_limit < 0:
            return result.failure[unit](result.invalid, "a frame limit must be nonnegative")
        # A windowed program has nowhere to print a trap; unless it chose its own
        # name and version, report crashes under the window title.
        if not core.crash_reports_enabled():
            crash.enable(self.title.value) catch failure:
                discard(failure)
        self.session_host = window.Window.open(window.Options(title = self.title.value, width = (u32)self.width, height = (u32)self.height, fullscreen = self.fullscreen)) catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer self.session_host.destroy()
        var device = gpu.Device.open() catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer device.destroy()
        var surface = gpu.Surface.open(device, self.session_host) catch failure:
            return result.failure[unit](failure.code, failure.message)
        defer surface.destroy()
        self.session_host.show() catch failure:
            return result.failure[unit](failure.code, failure.message)
        self.running = true
        defer self.stop()
        # Repaint from inside the OS live-resize loop so the window tracks the drag
        # instead of stretching its last frame. The bridge lives on this stack for
        # the window's whole lifetime, so its pointers stay valid for the callback.
        var bridge = ResizeBridge(application = &self, surface = &surface)
        self.session_host.set_redraw(resize_redraw, (void*)&bridge) catch failure:
            return result.failure[unit](failure.code, failure.message)
        var previous = time.now()
        var count: i64 = 0
        var blocking = false
        while self.running:
            # Block until an event, a timer deadline, a blinking caret, or a wake() from
            # a worker thread — so an idle window costs no CPU. The first pass renders at
            # once, and a frame_limit run never blocks so tests stay deterministic.
            if blocking:
                let woke = self.session_host.wait(self.wait_budget(frame_limit)) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                if let event = woke:
                    let handled = self.handle_event(self.session_host, event)
                    if not handled.is_success():
                        return handled
                    handled.release()
                if not self.running:
                    break
            blocking = true
            let size = self.session_host.size() catch failure:
                return result.failure[unit](failure.code, failure.message)
            let arranged = self.layout(size.width, size.height)
            if not arranged.is_success():
                return arranged
            arranged.release()
            var events: usize = 0
            while events < 512 and self.running:
                self.update_cursor(self.session_host) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                self.session_host.set_text_input(self.tree.wants_text_input()) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                let polled = self.session_host.poll() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                let event = polled else break
                let handled = self.handle_event(self.session_host, event)
                if not handled.is_success():
                    return handled
                handled.release()
                events += 1
            if not self.running:
                break
            let serviced = self.timers.service(time.now())
            if not serviced.is_success():
                return serviced
            serviced.release()
            if not self.running:
                break
            let current = time.now()
            let elapsed = (f64)(current - previous) / 1000000000.0
            previous = current
            let delivered = self.frames.emit(elapsed)
            if not delivered.is_success():
                return delivered
            delivered.release()
            if not self.running:
                break
            # Present only when something changed: an input event marked us dirty, a
            # widget bumped the layout epoch, or a focused caret is due to blink. An
            # idle window with no focused editor renders nothing and rests the GPU.
            # Game mode presents every serviced turn so a software renderer can run
            # at the requested fps without a layout mutation each frame.
            let epoch_now = layout.epoch()
            let moment = time.now()
            let caret_due = self.tree.wants_text_input() and moment - self.last_render >= 30000000
            if self.game or self.dirty or epoch_now != self.last_epoch or caret_due:
                let frame = surface.frame() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                defer frame.release()
                # The window may change size while a frame is drawn, not only at its
                # present: that frame is dropped and the next drawn at the new size.
                let target = frame.value().target() catch failure:
                    if failure.code != gpu.frame_resized:
                        return result.failure[unit](failure.code, failure.message)
                    self.dirty = true
                    continue
                defer target.release()
                let rendered = self.render(target)
                if not rendered.is_success():
                    if rendered.code != gpu.frame_resized:
                        return rendered
                    rendered.release()
                    self.dirty = true
                    continue
                rendered.release()
                self.update_cursor(self.session_host) catch failure:
                    return result.failure[unit](failure.code, failure.message)
                var resized = false
                discard(frame.value().present(self.tree.theme().background) catch failure:
                    if failure.code != gpu.frame_resized:
                        return result.failure[unit](failure.code, failure.message)
                    resized = true
                    recover gpu.PresentResult.skipped)
                self.dirty = resized
                self.last_epoch = epoch_now
                self.last_render = moment
            count += 1
            if frame_limit > 0 and count >= frame_limit:
                self.stop()
        surface.wait_idle() catch failure:
            return result.failure[unit](failure.code, failure.message)
        return result.success[unit](())

    func report_input_failure(outcome: interop.Outcome[unit], handler: interop.Callback[str, unit]) -> interop.Outcome[unit]:
        discard(outcome.get() catch failure:
            return handler.invoke(failure.message))
        return result.success[unit](())

    ## Apply one event: request a close (honoring the close handler), re-layout on a
    ## resize, or dispatch it to the tree — routing a dispatch failure to the error
    ## handler when one is set. Every event marks the frame dirty so it is presented.
    mutating func handle_event(host: window.Window, event: input.Event) -> interop.Outcome[unit]:
        self.dirty = true
        if event.kind == input.EventKind.close_requested:
            if let handler = self.close_handler:
                let permission = handler.invoke(())
                defer permission.release()
                let allowed = permission.get() catch failure:
                    return result.failure[unit](failure.code, failure.message)
                if allowed:
                    self.stop()
            else:
                self.stop()
            return result.success[unit](())
        if event.kind == input.EventKind.resized:
            let resized = host.size() catch failure:
                return result.failure[unit](failure.code, failure.message)
            return self.layout(resized.width, resized.height)
        let dispatched = self.dispatch_native(event)
        if dispatched.is_success():
            return dispatched
        if let handler = self.error_handler:
            # Copy the message into the handler before releasing its owner.
            let notified = self.report_input_failure(dispatched, handler)
            dispatched.release()
            return notified
        return dispatched

    ## How long the loop may block before it must run again: nothing when a frame is
    ## already pending or a frame_limit run wants every frame, otherwise the soonest of
    ## a timer deadline, a blinking caret's cadence, and a one-second safety ceiling. A
    ## wake() or an OS event ends the wait early.
    func wait_budget(frame_limit: i64) -> u64:
        if frame_limit > 0:
            return 0
        if self.game:
            if self.target_fps <= 0.0:
                return 0
            let now = time.now()
            let interval = (u64)(1000000000.0 / self.target_fps)
            var budget: u64 = 0
            if self.last_render != 0:
                let next = self.last_render + interval
                if next > now:
                    budget = next - now
            if let deadline = self.timers.next_deadline():
                if deadline <= now:
                    return 0
                let delta = deadline - now
                if budget == 0 or delta < budget:
                    budget = delta
            return budget
        # A widget that changed the layout while drawing (an accordion easing a
        # section open) wants the next frame at once, not after the next event.
        if self.dirty or self.tree.is_animating() or layout.epoch() != self.last_epoch:
            return 0
        let now = time.now()
        var budget: u64 = 1000000000
        if let deadline = self.timers.next_deadline():
            if deadline <= now:
                return 0
            let delta = deadline - now
            if delta < budget:
                budget = delta
        if self.tree.wants_text_input() and 30000000 < budget:
            budget = 30000000
        return budget

    ## End the run loop after the current iteration; the application stays usable.
    pub mutating func stop():
        self.running = false

    ## Closing during a callback requests loop termination. Owned fields remain
    ## alive under the active invocation guard until that callback and run return.
    pub mutating func close():
        self.stop()
        self.closed = true

    mutating func dispose():
        self.close()
        if let handler = self.close_handler:
            self.close_handler = none
            handler.release()
        if let handler = self.error_handler:
            self.error_handler = none
            handler.release()
        self.commands.close()
        self.timers.close()
        self.frames.close()
        self.frames.release()
        self.tree.close()
        self.title.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let handler = self.close_handler:
            handler.trace(visit, context)
        if let handler = self.error_handler:
            handler.trace(visit, context)
        self.commands.trace(visit, context)
        self.timers.trace(visit, context)
        self.frames.trace(visit, context)
        self.tree.trace(visit, context)
        self.title.trace(visit, context)

func check_fps(fps: f64) -> !:
    if not math.is_finite(fps) or fps < 0.0 or fps > 1000.0:
        error(result.invalid, "game fps must be finite and in 0..1000")

pub let application_type: interop.Type[Application] = interop.Type[Application]("UI application", Application.dispose, Application.trace, main_thread = true)

## Carries the running application and its surface to the window's live-resize
## callback. It lives on run's stack, which stays alive for the callback's lifetime.
struct ResizeBridge:
    var application: Application*
    var surface: gpu.Surface*

func resize_redraw(context: void*):
    let bridge = (ResizeBridge*)context
    let outcome = bridge.application.draw_resized(bridge.surface)
    outcome.release()
