## A color label's swatch (1–7: red, orange, yellow, green, blue, purple, grey).
pub func label_color(label: i64) -> gpu.Color:
    return thumbnail_grid.label_color((u8)label) if label >= 0 and label <= 7 else gpu.Color(0.0, 0.0, 0.0, 0.0)

