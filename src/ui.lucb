pub let invalid: ErrorCode = result.invalid

## Whether the program runs on macOS, whose keys and words differ.
pub func on_macos() -> bool:
    return platform.macos

## The primary modifier's name as the platform says it: "Cmd" on macOS, "Ctrl" elsewhere.
pub func primary_key_name() -> str:
    return "Cmd" if platform.macos else "Ctrl"

## The key that clears a selection: macOS's delete (Backspace), Delete elsewhere.
pub func clear_key() -> input.Key:
    return input.Key.backspace if platform.macos else input.Key.delete
