## What `typed` into a numeric field comes to, as a parameter panel
## reads it: arithmetic, or `+=`/`-=`/`*=`/`/=` applied to `current`; none
## when it cannot be read.
pub func evaluate_number(typed: str, current: f64) -> f64?:
    return parameter_text.evaluate(typed, current)

import icons
import widgets.icon
import widgets.pane_header
pub type IconKind = icons.IconKind

## Draw the luciaos-assets icon called `name` into `bounds` of `target`, in `color`.
pub func draw_icon(target: interop.View[gpu.RenderTarget], name: str, bounds: gpu.Rect, color: gpu.Color) -> !:
    try icons.draw_icon(target, name, bounds, color)

## An sRGB color from hue (0..360), saturation and brightness (0..1).
pub func hsb_to_rgb(hue: f64, saturation: f64, brightness: f64) -> gpu.Color:
    return hsb_field.hsb_to_rgb(hue, saturation, brightness)

## The hue of an sRGB color, 0..360 (0 for grays).
pub func hue_of(color: gpu.Color) -> f64:
    var h = 0.0
    var s = 0.0
    var b = 0.0
    hsb_field.rgb_to_hsb(color, &h, &s, &b)
    return h

## The saturation of an sRGB color, 0..1.
pub func saturation_of(color: gpu.Color) -> f64:
    var h = 0.0
    var s = 0.0
    var b = 0.0
    hsb_field.rgb_to_hsb(color, &h, &s, &b)
    return s

## The brightness of an sRGB color, 0..1.
pub func brightness_of(color: gpu.Color) -> f64:
    var h = 0.0
    var s = 0.0
    var b = 0.0
    hsb_field.rgb_to_hsb(color, &h, &s, &b)
    return b

## Whether `name` is an icon in the set.
pub func icon_known(name: str) -> bool:
    return icons.known(name)

