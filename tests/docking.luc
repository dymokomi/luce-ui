from ui import Application, DStack, Panel, DockPosition, DockRequest, TextEditor, Text, Size, Event
from input import EventKind, Key

func click(app: Application, x: float, y: float) -> unit!:
    app.dispatch(Event(kind = EventKind.pointer_down, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = x, y = y))

pub func docking() -> unit!:
    let editor = TextEditor("alpha")
    let first = Panel("Alpha", editor, minimum = Size(100.0, 60.0))
    let second = Panel("Beta", TextEditor("beta"), minimum = Size(100.0, 60.0))
    let third = Panel("Output", Text("output"), minimum = Size(100.0, 60.0), closable = false)
    let stack = DStack([first, second, third])
    let app = Application(stack)
    stack.move(second, first, DockPosition.right)
    stack.move(third, second, DockPosition.bottom)
    app.layout(805.0, 505.0)
    assert(stack.panel_count() == 3 and stack.group_count() == 3)
    let a = stack.panel_bounds(first)
    let b = stack.panel_bounds(second)
    let c = stack.panel_bounds(third)
    assert(a.width == 400.0 and b.width == 400.0 and c.width == 400.0)
    assert(b.y == 0.0 and c.y == 255.0 and c.height == 250.0)
    # Divider capture and keyboard resizing use the same split geometry.
    click(app, a.x + a.width + 2.0, 100.0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.right))
    assert(stack.panel_bounds(first).width == 408.0)
    app.dispatch(Event(kind = EventKind.pointer_down, x = 410.0, y = 100.0))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = 450.0, y = 100.0))
    app.dispatch(Event(kind = EventKind.pointer_up, x = 450.0, y = 100.0))
    let resized_width = stack.panel_bounds(first).width
    assert(resized_width > 447.999 and resized_width < 448.001)
    stack.set_fraction(first, 0.5)
    app.layout(805.0, 505.0)
    app.dispatch(Event(kind = EventKind.pointer_down, x = b.x + 20.0, y = 252.0))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = b.x + 20.0, y = 282.0))
    app.dispatch(Event(kind = EventKind.pointer_up, x = b.x + 20.0, y = 282.0))
    assert(stack.panel_bounds(second).height == 280.0)
    stack.set_fraction(third, 0.5)
    app.layout(805.0, 505.0)
    let identity = editor.layout().id()
    editor.set_selection(5, 5)
    editor.insert(" edited")
    stack.move(second, first)
    app.layout(805.0, 505.0)
    assert(stack.same_group(first, second) and stack.group_count() == 2)
    assert(not first.layout().is_visible() and second.layout().is_visible())
    let tab = stack.tab_bounds(first)
    click(app, tab.x + 8.0, tab.y + 5.0)
    assert(first.layout().is_visible() and not second.layout().is_visible())
    assert(editor.layout().is_focused() and editor.layout().id() == identity)
    assert(editor.text() == "alpha edited")
    editor.undo()
    assert(editor.text() == "alpha")
    var requests = 0
    let added = stack.on_add(func(request: DockRequest):
        let target = request.panel else return
        assert(target is first and request.position == DockPosition.right)
        requests += 1)
    let plus = stack.add_bounds(first)
    click(app, plus.x + plus.width * 0.5, plus.y + 5.0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(requests == 1)
    added.disconnect()
    # A refused close leaves both tab membership and content intact.
    stack.set_close_handler(func(panel: Panel) -> bool: return false)
    let closable = stack.tab_bounds(first)
    click(app, closable.x + closable.width - 5.0, closable.y + 5.0)
    assert(stack.panel_count() == 3 and editor.text() == "alpha")
    # Drag a tab into the bottom region, preserving the same editor object.
    let dragged = stack.tab_bounds(first)
    let target = stack.panel_bounds(third)
    app.dispatch(Event(kind = EventKind.pointer_down, x = dragged.x + 8.0, y = dragged.y + 5.0))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = target.x + target.width * 0.5, y = target.y + target.height - 10.0))
    assert(stack.drop_preview().height > 0.0)
    app.dispatch(Event(kind = EventKind.pointer_up, x = target.x + target.width * 0.5, y = target.y + target.height - 10.0))
    assert(stack.group_count() == 3 and not stack.same_group(first, second))
    assert(editor.layout().id() == identity and editor.text() == "alpha")
    # Escape cancels the preview without committing a proposed merge.
    let origin = stack.tab_bounds(first)
    let destination = stack.panel_bounds(second)
    app.dispatch(Event(kind = EventKind.pointer_down, x = origin.x + 8.0, y = origin.y + 5.0))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = destination.x + destination.width * 0.5, y = destination.y + destination.height * 0.5))
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    app.dispatch(Event(kind = EventKind.pointer_up, x = destination.x + destination.width * 0.5, y = destination.y + destination.height * 0.5))
    assert(stack.group_count() == 3 and stack.drop_preview().height == 0.0)
    stack.remove(second)
    assert(stack.panel_count() == 2 and stack.group_count() == 2)
    app.layout(160.0, 100.0)
    assert(stack.panel_bounds(first).width >= 102.0)
    app.close()
    overflow()
    directional()

## Ctrl/Cmd+Alt+arrows move to the nearest pane along an axis: with a left column
## and a stacked right column, each arrow lands on the neighbor a user would expect.
func directional() -> unit!:
    let left = Panel("Left", TextEditor("left"), minimum = Size(100.0, 60.0))
    let top = Panel("Top", TextEditor("top"), minimum = Size(100.0, 60.0))
    let bottom = Panel("Bottom", TextEditor("bottom"), minimum = Size(100.0, 60.0))
    let stack = DStack([left, top, bottom])
    let app = Application(stack)
    stack.move(top, left, DockPosition.right)
    stack.move(bottom, top, DockPosition.bottom)
    app.layout(805.0, 505.0)
    stack.select(top)
    app.layout(805.0, 505.0)
    stack.focus_direction(-1.0, 0.0)
    app.layout(805.0, 505.0)
    assert(left.layout().contains_focus() and not top.layout().contains_focus())
    stack.select(bottom)
    app.layout(805.0, 505.0)
    stack.focus_direction(0.0, -1.0)
    app.layout(805.0, 505.0)
    assert(top.layout().contains_focus())
    stack.focus_direction(0.0, 1.0)
    app.layout(805.0, 505.0)
    assert(bottom.layout().contains_focus())
    stack.focus_direction(-1.0, 0.0)
    app.layout(805.0, 505.0)
    assert(left.layout().contains_focus())
    # No pane lies further left, so focus stays put.
    stack.focus_direction(-1.0, 0.0)
    app.layout(805.0, 505.0)
    assert(left.layout().contains_focus())
    app.close()

func overflow() -> unit!:
    var panels: list[Panel] = []
    for index in 0..<10:
        panels.append(Panel("Document", TextEditor("text")))
    let stack = DStack(panels)
    let app = Application(stack)
    app.layout(340.0, 200.0)
    assert(stack.tab_bounds(panels[9]).width > 0.0)
    assert(stack.tab_bounds(panels[0]).width == 0.0)
    let plus = stack.add_bounds(panels[9])
    assert(plus.x + plus.width == 339.0)
    # The previous control reveals hidden tabs without moving the trailing +.
    click(app, 4.0, 5.0)
    assert(panels[8].layout().is_visible() and not panels[9].layout().is_visible())
    stack.select(panels[0])
    app.layout(340.0, 200.0)
    assert(stack.tab_bounds(panels[0]).width > 0.0)
    assert(stack.tab_bounds(panels[9]).width == 0.0)
    assert(stack.add_bounds(panels[0]).x == plus.x)
    app.close()
