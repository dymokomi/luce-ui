from ui import Application, Font, Button, TextField, TextPrompt, VStack, Dialog, Command, Shortcut, Event, NumberField, TextEditor
from gpu import Frame
from input import EventKind, Key
import window

class Count:
    pub var clicks: int = 0
    pub var triggers: int = 0
    pub var copies: int = 0
    pub var cancels: int = 0
    pub var accepts: int = 0
    pub func click(self):
        self.clicks += 1
    pub func trigger(self):
        self.triggers += 1
    pub func copy(self):
        self.copies += 1
    pub func cancel(self):
        self.cancels += 1
    pub func accept(self):
        self.accepts += 1

func click(app: Application, x: float, y: float) -> unit!:
    app.dispatch(Event(kind = EventKind.pointer_down, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = x, y = y))

func render(app: Application) -> unit!:
    let frame = Frame(window.Size(600.0, 500.0, 600.0, 500.0, 1.0))
    app.layout(600.0, 500.0)
    app.render(frame.target())
    frame.close()

## A Dialog is a non-modal floating card: a click behind it reaches what is
## there, and its own field takes focus and typing. A plain-key shortcut waits
## while a field takes text. A prompt is still modal.
pub func dialogs() -> unit!:
    let font = Font()
    let count = Count()
    let behind = Button("Behind", font = font)
    let clicked = behind.on_click(count.click)
    let inside = TextField("", font = font, cells = 12.0)
    let dialog = Dialog([inside], width = 240.0)
    let prompt = TextPrompt(font = font)
    let app = Application(VStack([behind, dialog, prompt], spacing = 0.0))
    let brush = Command("Brush", Shortcut(Key.b), id = "brush")
    let triggered = brush.on_trigger(count.trigger)
    let copy = Command("Copy", Shortcut(Key.c, primary = true), id = "copy")
    let copied = copy.on_trigger(count.copy)
    app.set_commands([brush, copy])
    dialog.open()
    render(app)
    let button = behind.layout().bounds()
    click(app, button.x + 4.0, button.y + 4.0)
    render(app)
    assert(count.clicks == 1 and dialog.is_open())
    # The key reaches the command while nothing takes text.
    app.dispatch(Event(kind = EventKind.key_down, key = Key.b))
    assert(count.triggers == 1)
    let field = inside.layout().bounds()
    click(app, field.x + 6.0, field.y + field.height * 0.5)
    render(app)
    assert(inside.layout().is_focused())
    app.dispatch(Event(kind = EventKind.key_down, key = Key.b))
    app.dispatch(Event(kind = EventKind.text_input, codepoint = 98))
    render(app)
    assert(inside.text() == "b" and count.triggers == 1)
    # Cmd-C in the field is the field's copy, not the application's.
    app.dispatch(Event(kind = EventKind.key_down, key = Key.c, meta = true))
    assert(count.copies == 0)
    # A prompt holds input: the click behind it is swallowed.
    prompt.open("Name", "")
    render(app)
    click(app, button.x + 4.0, button.y + 4.0)
    render(app)
    assert(count.clicks == 1)
    clicked.disconnect()
    triggered.disconnect()
    copied.disconnect()
    app.close()

## Escape and Enter go to an open dialog before any shortcut: Escape cancels,
## Enter accepts. A field being typed in first drops (Escape) or keeps (Enter)
## its text; a multi-line editor keeps Enter for its lines.
pub func dialog_keys() -> unit!:
    let font = Font()
    let count = Count()
    let behind = Button("Behind", font = font)
    let number = NumberField(10.0, 0.0, 100.0, 1.0, font = font, cells = 8.0)
    let name = TextField("", font = font, cells = 12.0)
    let notes = TextEditor("", font = font)
    let dialog = Dialog([number, name, notes], width = 300.0)
    let cancelled = dialog.on_cancel(count.cancel)
    let accepted = dialog.on_accept(count.accept)
    let app = Application(VStack([behind, dialog], spacing = 0.0))
    let escape = Command("Deselect", Shortcut(Key.escape), id = "deselect")
    let triggered = escape.on_trigger(count.trigger)
    app.set_commands([escape])
    render(app)
    # Closed: Escape is the shortcut's.
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(count.triggers == 1 and count.cancels == 0)
    dialog.open()
    render(app)
    # Open, with focus elsewhere: the dialog cancels, the shortcut waits.
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(count.triggers == 1 and count.cancels == 1)
    # A typed number stands when Enter accepts.
    let field = number.layout().bounds()
    click(app, field.x + 6.0, field.y + field.height * 0.5)
    render(app)
    app.dispatch(Event(kind = EventKind.text_input, codepoint = 55))
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(count.accepts == 1 and number.value() == 7.0)
    # Typed text is dropped when Escape cancels.
    let line = name.layout().bounds()
    click(app, line.x + 6.0, line.y + line.height * 0.5)
    render(app)
    app.dispatch(Event(kind = EventKind.text_input, codepoint = 120))
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(count.cancels == 2 and name.text() == "")
    # Enter in a multi-line editor breaks the line; the dialog stays.
    app.focus(notes.layout())
    render(app)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(count.accepts == 1)
    # Held keys and chords are not the dialog's.
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape, repeated = true))
    assert(count.cancels == 2)
    dialog.hide()
    render(app)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(count.cancels == 2 and count.triggers == 2)
    cancelled.disconnect()
    accepted.disconnect()
    triggered.disconnect()
    app.close()

## With a submit listener, the first Enter keeps what was typed and the
## second submits (Photoshop's option bar applying a transform).
pub func number_submit() -> unit!:
    let font = Font()
    let count = Count()
    let number = NumberField(10.0, 0.0, 100.0, 1.0, font = font, cells = 8.0)
    let submitted = number.on_submit(count.accept)
    let app = Application(VStack([number], spacing = 0.0))
    render(app)
    let field = number.layout().bounds()
    click(app, field.x + 6.0, field.y + field.height * 0.5)
    render(app)
    app.dispatch(Event(kind = EventKind.text_input, codepoint = 55))
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(number.value() == 7.0 and count.accepts == 0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(count.accepts == 1)
    submitted.disconnect()
    app.close()
    # Steps count from zero, not the minimum: 4 typed in a field from 0.5 stays 4.
    let width = NumberField(1.0, 0.5, 500.0, 1.0, font = font)
    let other = Application(VStack([width], spacing = 0.0))
    render(other)
    let box = width.layout().bounds()
    click(other, box.x + 6.0, box.y + box.height * 0.5)
    render(other)
    other.dispatch(Event(kind = EventKind.text_input, codepoint = 52))
    other.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(width.value() == 4.0)
    other.close()
