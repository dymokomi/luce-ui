from luce_ui.ui import Application, Widget, Layout, Size, Constraints, Event, Button, VStack, Font
from luce_gpu.gpu import RenderTarget, Frame
from luce_window import window
import time
from luce_window.input import EventKind, PointerKind

## Records the pointer buttons it is sent, as a canvas that pans with the middle button would.
class Pad: Widget:
    let box: Layout
    pub var downs: list[int]
    pub var ups: list[int]
    pub var moves: int = 0
    pub var pressure: float = 0.0
    pub var kind: PointerKind = PointerKind.mouse
    pub var tilt_x: float = 0.0
    pub var rotation: float = 0.0

    pub func init(self) -> unit!:
        self.box = Layout()
        self.box.set_focusable(true)
        self.box.set_flex()
        self.downs = []
        self.ups = []

    pub func layout(self) -> Layout:
        return self.box

    pub func measure(self, available: Constraints) -> Size!:
        return Size(200.0, 200.0)

    pub func draw(self, target: RenderTarget) -> unit!:
        _ = target

    pub func event(self, event: Event) -> unit!:
        if event.kind == EventKind.pointer_down:
            self.downs.append(event.button)
        elif event.kind == EventKind.pointer_up:
            self.ups.append(event.button)
        elif event.kind == EventKind.pointer_moved:
            self.moves += 1
            self.pressure = event.pressure
            self.kind = event.pointer_kind
            self.tilt_x = event.tilt_x
            self.rotation = event.rotation

## The middle button reaches the widget under the pointer, the drag stays with it
## even outside, and keyboard focus stays where it was.
pub func buttons() -> unit!:
    let font = Font()
    let pad = Pad()
    let other = Button("Other", font = font)
    let app = Application(VStack([other, pad], spacing = 0.0))
    app.layout(300.0, 300.0)
    app.focus(other.layout())
    app.layout(300.0, 300.0)
    let area = pad.layout().bounds()
    let x = area.x + area.width * 0.5
    let y = area.y + area.height * 0.5
    app.dispatch(Event(kind = EventKind.pointer_down, button = 2, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = -40.0, y = -40.0))
    app.dispatch(Event(kind = EventKind.pointer_up, button = 2, x = -40.0, y = -40.0))
    assert(pad.downs.length == 1 and pad.downs[0] == 2)
    assert(pad.ups.length == 1 and pad.ups[0] == 2)
    assert(pad.moves >= 1)
    assert(other.layout().is_focused() and not pad.layout().is_focused())

## A pen's pressure, kind, tilt and rotation reach the widget through `dispatch`.
pub func pen_fields() -> unit!:
    let pad = Pad()
    let app = Application(VStack([pad], spacing = 0.0))
    app.layout(300.0, 300.0)
    let area = pad.layout().bounds()
    let x = area.x + area.width * 0.5
    let y = area.y + area.height * 0.5
    app.dispatch(Event(kind = EventKind.pointer_down, button = 0, x = x, y = y, pressure = 0.4, pointer_kind = PointerKind.pen))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x + 5.0, y = y, pressure = 0.75, pointer_kind = PointerKind.pen,
                       tilt_x = 30.0, rotation = 45.0))
    app.dispatch(Event(kind = EventKind.pointer_up, button = 0, x = x + 5.0, y = y, pointer_kind = PointerKind.pen))
    assert(pad.pressure == 0.75 and pad.kind == PointerKind.pen)
    assert(pad.tilt_x == 30.0 and pad.rotation == 45.0)

## A disabled button takes no click, Space or Enter, yet still hears the pointer, so a
## tooltip over it can show; enabled again it clicks.
pub func disabled_buttons() -> unit!:
    let font = Font()
    let button = Button(icon = "brush-tool", font = font)
    var clicks = 0
    let connection = button.on_click(func () -> unit!:
        clicks += 1)
    let app = Application(VStack([button]))
    app.layout(200.0, 100.0)
    let area = button.layout().bounds()
    let x = area.x + area.width * 0.5
    let y = area.y + area.height * 0.5
    button.set_enabled(false)
    assert(not button.is_enabled())
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x, y = y))
    assert(button.layout().contains_pointer())
    app.dispatch(Event(kind = EventKind.pointer_down, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = x, y = y))
    button.click()
    assert(clicks == 0)
    button.set_enabled(true)
    app.dispatch(Event(kind = EventKind.pointer_down, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = x, y = y))
    assert(clicks == 1 and button.is_enabled())
    connection.disconnect()
    app.close()

## A button's tooltip shows once the pointer has rested on it for the delay:
## the frame drawn when the wait ends shows it (the loop is woken for that
## frame; no timer runs). Leaving or pressing hides it. `on_hover` hears the
## pointer come on and leave, once each, a disabled button too.
pub func button_tooltips() -> unit!:
    let font = Font()
    let button = Button(icon = "brush-tool", font = font)
    let other = Button("Other", font = font)
    let heard: list[bool] = []
    let hovering = button.on_hover(func (over: bool) -> unit!: heard.append(over))
    button.set_tooltip("Brush", "B")
    button.set_tip_delay(0.15)
    let app = Application(VStack([button, other]))
    app.layout(200.0, 100.0)
    let area = button.layout().bounds()
    let x = area.x + area.width * 0.5
    let y = area.y + area.height * 0.5
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x + 1.0, y = y))
    assert(heard == [true])
    draw(app)
    assert(button.shown_tooltip() == "")
    let started = time.now()
    while time.now() - started < 200000000:
        _ = 0
    draw(app)
    assert(button.shown_tooltip() == "Brush")
    # Onto another button: the tip goes, the hover ends.
    let beside = other.layout().bounds()
    app.dispatch(Event(kind = EventKind.pointer_moved, x = beside.x + 4.0, y = beside.y + 4.0))
    assert(heard == [true, false] and button.shown_tooltip() == "")
    # A press hides it; it waits again only when the pointer comes back.
    button.set_tip_delay(0.0)
    button.set_enabled(false)
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x, y = y))
    draw(app)
    assert(heard == [true, false, true] and button.shown_tooltip() == "Brush")
    app.dispatch(Event(kind = EventKind.pointer_down, button = 0, x = x, y = y, inside = true))
    app.dispatch(Event(kind = EventKind.pointer_up, button = 0, x = x, y = y, inside = true))
    draw(app)
    assert(button.shown_tooltip() == "")
    # Out of the window; then an empty text takes the tooltip away.
    app.dispatch(Event(kind = EventKind.pointer_left))
    assert(heard == [true, false, true, false])
    button.set_tooltip("")
    app.dispatch(Event(kind = EventKind.pointer_moved, x = x, y = y))
    draw(app)
    assert(button.shown_tooltip() == "" and heard == [true, false, true, false, true])
    hovering.disconnect()
    app.close()

func draw(app: Application) -> unit!:
    let frame = Frame(window.Size(200.0, 100.0, 200.0, 100.0, 1.0))
    app.layout(200.0, 100.0)
    app.render(frame.target())
    frame.close()
